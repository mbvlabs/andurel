        },
        "commands": [
          {
            "name": "launch",
            "path": "andurel ports launch",
            "short": "Run a child on a leased loopback port and publish its URL",
            "long": "Run a child process with INERTIA_SSR_LISTEN and INERTIA_SSR_URL set to\nthe same leased loopback URL. The assignment is printed only after the child\nanswers GET /health with {\"status\":\"ok\"} and the launcher proves the child owns\nthe listening socket on that exact address. The lease is released when the\nchild exits or the launcher receives SIGINT/SIGTERM.\n\nThe child defaults to ./dist/ssr. Pass --listen to keep a fixed address\ninstead of allocating one; the port must be free and unleased.\n\nWildcard addresses are rejected because they cannot prove which socket answered\nthe health probe. localhost resolves to 127.0.0.1; pass ::1 explicitly for IPv6.\nOn platforms other than Linux the launcher fails closed because it cannot read\n/proc socket ownership; run the child directly with a fixed INERTIA_SSR_LISTEN\nthere instead.",
            "usage": "andurel ports launch [--] \u003ccommand\u003e [args...] [flags]",
            "examples": "andurel ports launch -- ./dist/ssr\n  andurel ports launch --json -- ./dist/ssr\n  andurel ports launch --listen http://127.0.0.1:13714 -- ./dist/ssr",
            "local_flags": [
              {
                "name": "host",
                "usage": "Loopback host to allocate on (localhost uses 127.0.0.1; use ::1 for IPv6)",
                "default": "127.0.0.1",
                "type": "string"
              },
              {
                "name": "lease-dir",
                "usage": "Directory for port lease files (defaults to ANDUREL_PORT_LEASE_DIR or a per-user runtime directory)",
                "type": "string"
              },
              {
                "name": "listen",
                "usage": "Fixed listen URL, e.g. http://127.0.0.1:13714 (overrides --host/--port)",
                "type": "string"
              },
              {
                "name": "port",
                "usage": "Fixed port to allocate (0 allocates a free port)",
                "default": "0",
                "type": "int"
              },
              {
                "name": "ready-file",
                "usage": "Atomically write the ready assignment to this file and remove it on exit",
                "type": "string"
              },
              {
                "name": "startup-timeout",
                "usage": "Maximum time to wait for the child /health endpoint",
                "default": "15s",
                "type": "duration"
              },
              {
                "name": "stop-timeout",
                "usage": "Maximum time to wait for graceful child shutdown",
                "default": "10s",
                "type": "duration"
              }
            ],
            "inherited_flags": [
              {
                "name": "agent",
                "usage": "Emit structured output optimized for agents",
                "default": "false",
                "type": "bool"
              },
              {
                "name": "count",
                "usage": "Emit one raw resource count when supported",
                "default": "false",
                "type": "bool"
              },
              {
                "name": "ids-only",
                "usage": "Emit one resource identifier per line when supported",
                "default": "false",
                "type": "bool"
              },
              {
                "name": "jq",
                "usage": "Select a field path (for example .routes[0].name) from command data and emit JSON directly",
                "type": "string"
              },
              {
                "name": "json",
                "usage": "Emit JSON output",
                "default": "false",
                "type": "bool"
              },
              {
                "name": "md",
                "usage": "Emit Markdown output",
                "default": "false",
                "type": "bool"
              },
              {
                "name": "quiet",
                "usage": "Suppress non-essential human output",
                "default": "false",
                "type": "bool"
              },
              {
                "name": "verbose",
                "usage": "Emit verbose output",
                "default": "false",
                "type": "bool"
              }
            ],
            "agent_notes": "Run the production cmd/ssr sidecar with a collision-safe loopback port: the launcher holds an exclusive lease, starts the child, and publishes the assignment only after the child answers /health. Publish the assignment for orchestration with --ready-file; --json emits host, port, listen_url, url, mode, lease_file, pid, and child_pid. Pass --listen http://127.0.0.1:13714 to keep a fixed address instead of allocating one.",
            "category": "ports",
            "meta": {
              "group": "ports",
              "summary": "Run a child on a leased loopback port and publish its URL",
              "args": "[--] \u003ccommand\u003e [args...]",
              "when_to_use": [
                "Run the production cmd/ssr sidecar with a collision-safe loopback port: the launcher holds an exclusive lease, starts the child, and publishes the assignment only after the child answers /health.",
                "Publish the assignment for orchestration with --ready-file; --json emits host, port, listen_url, url, mode, lease_file, pid, and child_pid.",
                "Pass --listen http://127.0.0.1:13714 to keep a fixed address instead of allocating one."
              ],
              "when_not_to_use": [
                "An unrelated or already-listening port is never reused; a held port fails instead of being reassigned."
              ],
              "prerequisites": [
