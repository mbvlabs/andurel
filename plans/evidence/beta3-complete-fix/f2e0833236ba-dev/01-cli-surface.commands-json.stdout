      {
        "name": "ports",
        "path": "andurel ports",
        "short": "Allocate and supervise collision-safe loopback ports",
        "long": "Allocate a loopback port for a supervised child process and publish the\nmatching INERTIA_SSR_LISTEN and INERTIA_SSR_URL values.\n\nA port is reserved with an exclusive, machine-local lease that is held for the\nwhole child lifetime. A lease file is never treated as proof by itself: the\nlauncher verifies that the port is bindable before starting the child and only\npublishes the URL after the intended child answers /health. An unrelated\nlistener can therefore never satisfy the readiness check.\n\nLeases use flock on the local filesystem; keep --lease-dir on a local disk, not\na network mount. A crashed launcher releases the kernel lock automatically, so\nan unlocked lease file is stale and reusable. The launcher never kills an\nunrelated listener. Auto allocation re-checks bindability before start; if an\nunrelated process takes the port between that probe and the child bind, the\nchild exits nonzero and the launcher reports it. Start the launcher again to\nallocate a fresh port.\n\nUse --listen for explicit fixed-address operation. Without it the launcher\nallocates a free loopback port. Concurrent launchers receive distinct ports.",
        "usage": "andurel ports [flags]",
        "examples": "andurel ports launch -- ./dist/ssr\n  andurel ports launch --json --ready-file .andurel/ssr-port.json -- ./dist/ssr\n  andurel ports launch --listen http://127.0.0.1:13714 -- ./dist/ssr",
        "inherited_flags": [
          {
            "name": "agent",
            "usage": "Emit structured output optimized for agents",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "count",
            "usage": "Emit one raw resource count when supported",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "ids-only",
            "usage": "Emit one resource identifier per line when supported",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "jq",
            "usage": "Select a field path (for example .routes[0].name) from command data and emit JSON directly",
            "type": "string"
          },
          {
            "name": "json",
            "usage": "Emit JSON output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "md",
            "usage": "Emit Markdown output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "quiet",
            "usage": "Suppress non-essential human output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "verbose",
            "usage": "Emit verbose output",
            "default": "false",
            "type": "bool"
          }
        ],
        "subcommands": [
          {
            "name": "launch",
            "path": "andurel ports launch",
            "short": "Run a child on a leased loopback port and publish its URL",
            "category": "ports",
            "meta": {
              "group": "ports",
              "summary": "Run a child on a leased loopback port and publish its URL",
              "args": "[--] \u003ccommand\u003e [args...]",
              "when_to_use": [
                "Run the production cmd/ssr sidecar with a collision-safe loopback port: the launcher holds an exclusive lease, starts the child, and publishes the assignment only after the child answers /health.",
                "Publish the assignment for orchestration with --ready-file; --json emits host, port, listen_url, url, mode, lease_file, pid, and child_pid.",
                "Pass --listen http://127.0.0.1:13714 to keep a fixed address instead of allocating one."
              ],
              "when_not_to_use": [
                "An unrelated or already-listening port is never reused; a held port fails instead of being reassigned."
              ],
              "prerequisites": [
                "A child that answers GET /health with {\"status\":\"ok\"}"
              ],
              "examples": [
                "andurel ports launch -- ./dist/ssr",
                "andurel ports launch --json --ready-file .andurel/ssr-port.json -- ./dist/ssr",
                "andurel ports launch --listen http://127.0.0.1:13714 -- ./dist/ssr"
              ],
              "mutating": true,
              "supports_dry_run": false,
              "supports_json": true,
              "supports_jq": true,
              "supports_ids_only": false,
              "supports_count": false,
              "skip_dry_run_check": true
            }
          }
        ],
        "agent_notes": "Start a production SSR sidecar on a leased loopback port and publish the matching INERTIA_SSR_LISTEN and INERTIA_SSR_URL.",
        "category": "ports",
        "meta": {
          "group": "ports",
          "summary": "Allocate and supervise collision-safe loopback ports",
          "when_to_use": [
            "Start a production SSR sidecar on a leased loopback port and publish the matching INERTIA_SSR_LISTEN and INERTIA_SSR_URL."
          ],
          "when_not_to_use": [
            "Do not use it for local development; andurel run serves development SSR from Vite's /__inertia_ssr endpoint.",
            "It is not a find-a-free-port helper: the lease stays held for the whole child lifetime."
          ],
          "prerequisites": [
            "cmd/ssr is built with andurel build, or pass an explicit child command to ports launch"
          ],
