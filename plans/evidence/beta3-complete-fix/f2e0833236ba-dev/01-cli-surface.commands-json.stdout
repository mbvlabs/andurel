            "agent_notes": "After clone, andurel.toml changes, or missing bin/ tools. Downloads are verified against the per-platform SHA-256 digests in andurel.lock.",
            "category": "tool",
            "meta": {
              "group": "tool",
              "summary": "Download tool versions pinned in andurel.toml",
              "when_to_use": [
                "After clone, andurel.toml changes, or missing bin/ tools.",
                "Downloads are verified against the per-platform SHA-256 digests in andurel.lock."
