{
  "ok": true,
  "data": {
    "name": "andurel",
    "path": "andurel",
    "short": "Andurel CLI for humans and agents",
    "long": "Andurel is a space-grade Go framework for humans and agents.\n\nEverything you and your agent(s) need to build robust and performant applications that will scale to the far-side of the moon.",
    "usage": "andurel [flags]",
    "local_flags": [
      {
        "name": "agent",
        "usage": "Emit structured output optimized for agents",
        "default": "false",
        "type": "bool"
      },
      {
        "name": "count",
        "usage": "Emit one raw resource count when supported",
        "default": "false",
        "type": "bool"
      },
      {
        "name": "ids-only",
        "usage": "Emit one resource identifier per line when supported",
        "default": "false",
        "type": "bool"
      },
      {
        "name": "jq",
        "usage": "Select a field path (for example .routes[0].name) from command data and emit JSON directly",
        "type": "string"
      },
      {
        "name": "json",
        "usage": "Emit JSON output",
        "default": "false",
        "type": "bool"
      },
      {
        "name": "md",
        "usage": "Emit Markdown output",
        "default": "false",
        "type": "bool"
      },
      {
        "name": "quiet",
        "usage": "Suppress non-essential human output",
        "default": "false",
        "type": "bool"
      },
      {
        "name": "verbose",
        "usage": "Emit verbose output",
        "default": "false",
        "type": "bool"
      }
    ],
    "subcommands": [
      {
        "name": "build",
        "path": "andurel build",
        "short": "Build every application process for production",
        "category": "build",
        "meta": {
          "group": "build",
          "summary": "Build every application process for production",
          "when_to_use": [
            "Compile every cmd/* process with a main package (except seeds) and the client assets into dist/.",
            "Client assets and assets/dist/ssr/ssr.js are embedded in the binaries; no asset files are needed beside them at runtime.",
            "Use --only to build a subset, and --json for an artifact manifest with path, size, and version.",
            "Runtime environment: app needs the full config; queue needs database, queue, email, cache, and telemetry; migrate needs DB_*; ssr needs INERTIA_* and a JavaScript runtime."
          ],
          "when_not_to_use": [
            "Use andurel run for local development.",
            "Read andurel patterns show deploy for the migrate → ssr → app + queue start order and health checks."
          ],
          "prerequisites": [
            "Andurel project root",
            "cmd/\u003cprocess\u003e/main.go for every process to build"
          ],
          "next": [
            "andurel patterns show deploy"
          ],
          "examples": [
            "andurel build",
            "andurel build --version 1.2.3",
            "andurel build --only app,queue",
            "andurel build --json"
          ],
          "mutating": true,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": false,
          "supports_ids_only": false,
          "supports_count": false,
          "skip_dry_run_check": true
        }
      },
      {
        "name": "commands",
        "path": "andurel commands",
        "short": "Show the command catalog",
        "category": "commands",
        "meta": {
          "group": "commands",
          "summary": "Show the command catalog",
          "when_to_use": [
            "Discover commands, flags, and when-to-use metadata."
          ],
          "when_not_to_use": [
            "Do not parse human --help when --json is available."
          ],
          "examples": [
            "andurel commands --json",
            "andurel commands --markdown",
            "andurel commands --check"
          ],
          "mutating": false,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": true,
          "supports_ids_only": false,
          "supports_count": false
        }
      },
      {
        "name": "console",
        "path": "andurel console",
        "aliases": [
          "c"
        ],
        "short": "Open an interactive database console",
        "category": "console",
        "meta": {
          "group": "console",
          "summary": "Open an interactive database console",
          "when_to_use": [
            "Inspect or query the project database with usql."
          ],
          "when_not_to_use": [
            "Not for applying migrations; use andurel db migrate.",
            "Does not support --json, --agent, or --md; run without a structured output flag."
          ],
          "prerequisites": [
            "Andurel project root",
            ".env",
            "bin/usql"
          ],
          "examples": [
            "andurel console"
          ],
          "mutating": false,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": false,
          "supports_jq": false,
          "supports_ids_only": false,
          "supports_count": false
        }
      },
      {
        "name": "db",
        "path": "andurel db",
        "short": "Database lifecycle and migrations",
        "category": "db",
        "meta": {
          "group": "db",
          "summary": "Database lifecycle and migrations",
          "when_to_use": [
            "Create, drop, migrate, or seed the project database."
          ],
          "when_not_to_use": [
            "Use andurel db console for an interactive SQL shell."
          ],
          "prerequisites": [
            "Andurel project root",
            ".env database variables"
          ],
          "examples": [
            "andurel db --help",
            "andurel db migrate up"
          ],
          "mutating": false,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": false,
          "supports_ids_only": false,
          "supports_count": false,
          "skip_dry_run_check": true,
          "group_notes": [
            "Only andurel db seed supports --json. db create, db drop, db nuke, db rebuild, and every db migrate command stream command output and reject --json."
          ]
        }
      },
      {
        "name": "doctor",
        "path": "andurel doctor",
        "aliases": [
          "doc"
        ],
        "short": "Run diagnostic checks on the project",
        "category": "doctor",
        "meta": {
          "group": "doctor",
          "summary": "Run diagnostic checks on the project",
          "when_to_use": [
            "Verify health and generated-file drift after changes.",
            "Check first-run setup, runtime configuration and bounded database connectivity through the generated internal/configcheck helper, and Inertia SSR readiness.",
            "Read json/agent output for each check's status: a skipped check is blocked on a prerequisite and is never reported as a pass."
          ],
          "when_not_to_use": [
            "Doctor is read-only; it does not write generated files."
          ],
          "prerequisites": [
            "Andurel project root"
          ],
          "examples": [
            "andurel doctor --json",
            "andurel doctor --verbose"
          ],
          "mutating": false,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": true,
          "supports_ids_only": false,
          "supports_count": false
        }
      },
      {
        "name": "fmt",
        "path": "andurel fmt",
        "aliases": [
          "f"
        ],
        "short": "Format Go and Templ source files",
        "category": "fmt",
        "meta": {
          "group": "fmt",
          "summary": "Format Go and Templ source files",
          "when_to_use": [
            "Normalize formatting before commit.",
            "Use --check in CI."
          ],
          "when_not_to_use": [
            "This is not go vet; use andurel doctor for diagnostics.",
            "Does not support --json, --agent, or --md; use andurel verify --json for a machine-readable gate."
          ],
          "prerequisites": [
            "Andurel project root"
          ],
          "examples": [
            "andurel fmt",
            "andurel fmt --check"
          ],
          "mutating": true,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": false,
          "supports_jq": false,
          "supports_ids_only": false,
          "supports_count": false,
          "skip_dry_run_check": true
        }
      },
      {
        "name": "generate",
        "path": "andurel generate",
        "short": "Create files that have no derived source",
        "category": "generate",
        "meta": {
          "group": "generate",
          "summary": "Create files that have no derived source",
          "when_to_use": [
            "Create a new SQL migration file.",
            "Application code (domains, services, handlers, routes, jobs, emails) is written by hand: read andurel patterns list and andurel patterns show \u003ckind\u003e first."
          ],
          "when_not_to_use": [
            "Use andurel patterns to read the shape of application code.",
            "Use andurel sync to refresh derived files."
          ],
          "prerequisites": [
            "Andurel project root"
          ],
          "next": [
            "andurel patterns list",
            "andurel patterns show domain"
          ],
          "examples": [
            "andurel generate --help",
            "andurel generate migration create_posts",
            "andurel patterns show domain"
          ],
          "mutating": false,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": false,
          "supports_ids_only": false,
          "supports_count": false,
          "skip_dry_run_check": true,
          "group_notes": [
            "Application code is not generated: read andurel patterns list, then andurel patterns show \u003ckind\u003e for domains, services, handlers, routes, jobs, and emails."
          ]
        }
      },
      {
        "name": "inspect",
        "path": "andurel inspect",
        "short": "Read-only project shape",
        "category": "inspect",
        "meta": {
          "group": "inspect",
          "summary": "Read-only project shape",
          "when_to_use": [
            "List metadata, routes, pages, processes, URLs, domains, handlers, and other source files without writing."
          ],
          "when_not_to_use": [
            "Refreshing derived files is andurel sync."
          ],
          "prerequisites": [
            "Andurel project root"
          ],
          "examples": [
            "andurel inspect --help",
            "andurel inspect project --json",
            "andurel inspect pages --json",
            "andurel inspect process --json",
            "andurel inspect urls --json"
          ],
          "mutating": false,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": false,
          "supports_ids_only": false,
          "supports_count": false
        }
      },
      {
        "name": "new",
        "path": "andurel new",
        "aliases": [
          "n"
        ],
        "short": "Stand up a new Andurel project",
        "category": "new",
        "meta": {
          "group": "new",
          "summary": "Stand up a new Andurel project",
          "args": "[project-name]",
          "details": [
            "Quick Start, also printed by andurel new and in the generated README: andurel tool sync; pnpm install (or bun/npm to match --ui); cp .env.example .env and set the required values; andurel db create (only if the database does not exist); andurel db migrate up; andurel doctor; andurel run; andurel verify.",
            "Pass --harness codex|claude|pi|opencode|crush (comma-separated or repeated) to install the bundled agent skill during creation. Without it the skill is not installed and the next steps print an explicit install example."
          ],
          "when_to_use": [
            "Create a new application directory from the current scaffold.",
            "Creation is offline: it installs no dependencies and needs no database."
          ],
          "when_not_to_use": [
            "Do not run inside an existing Andurel project."
          ],
          "next": [
            "cd \u003cproject\u003e",
            "andurel tool sync",
            "pnpm install (or bun/npm install to match --ui)",
            "cp .env.example .env",
            "andurel db create (only if the database does not exist)",
            "andurel db migrate up",
            "andurel doctor",
            "andurel run",
            "andurel verify"
          ],
          "examples": [
            "andurel new myapp",
            "andurel new myapp --ui vue/pnpm",
            "andurel new myapp --harness claude",
            "andurel new myapp --dry-run --json"
          ],
          "mutating": true,
          "supports_dry_run": true,
          "supports_json": true,
          "supports_jq": true,
          "supports_ids_only": false,
          "supports_count": false
        }
      },
      {
        "name": "packages",
        "path": "andurel packages",
        "aliases": [
          "package",
          "pkg"
        ],
        "short": "List or update Andurel packages in go.mod",
        "category": "packages",
        "meta": {
          "group": "packages",
          "summary": "List or update Andurel packages in go.mod",
          "when_to_use": [
            "List or bump github.com/mbvlabs/andurel/pkg/* modules already required in go.mod."
          ],
          "when_not_to_use": [
            "Framework upgrades are andurel upgrade."
          ],
          "prerequisites": [
            "Andurel project root"
          ],
          "examples": [
            "andurel packages --help",
            "andurel packages list --json",
            "andurel packages update --dry-run"
          ],
          "mutating": false,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": true,
          "supports_ids_only": true,
          "supports_count": true
        }
      },
      {
        "name": "patterns",
        "path": "andurel patterns",
        "short": "Read the reference patterns for every layer",
        "category": "patterns",
        "meta": {
          "group": "patterns",
          "summary": "Read the reference patterns for every layer",
          "when_to_use": [
            "Before writing application code: read the shape, placement rules, and checklist for a primitive."
          ],
          "when_not_to_use": [
            "Patterns never write files; use andurel generate migration for a migration file.",
            "Use andurel inspect to list existing files."
          ],
          "examples": [
            "andurel patterns",
            "andurel patterns list --json",
            "andurel patterns show domain --json"
          ],
          "mutating": false,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": true,
          "supports_ids_only": true,
          "supports_count": true
        }
      },
      {
        "name": "ports",
        "path": "andurel ports",
        "short": "Allocate and supervise collision-safe loopback ports",
        "category": "ports",
        "meta": {
          "group": "ports",
          "summary": "Allocate and supervise collision-safe loopback ports",
          "when_to_use": [
            "Start a production SSR sidecar on a leased loopback port and publish the matching INERTIA_SSR_LISTEN and INERTIA_SSR_URL."
          ],
          "when_not_to_use": [
            "Do not use it for local development; andurel run serves development SSR from Vite's /__inertia_ssr endpoint.",
            "It is not a find-a-free-port helper: the lease stays held for the whole child lifetime."
          ],
          "prerequisites": [
            "cmd/ssr is built with andurel build, or pass an explicit child command to ports launch"
          ],
          "examples": [
            "andurel ports --help",
            "andurel ports launch -- ./dist/ssr"
          ],
          "mutating": false,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": false,
          "supports_ids_only": false,
          "supports_count": false
        }
      },
      {
        "name": "run",
        "path": "andurel run",
        "aliases": [
          "r"
        ],
        "short": "Start the development server",
        "category": "run",
        "meta": {
          "group": "run",
          "summary": "Start the development server",
          "when_to_use": [
            "Local development with auto-reload.",
            "Optionally start sidecars like mailpit via --tools."
          ],
          "when_not_to_use": [
            "Agents should not use run to finish a generation task.",
            "This is a long-running process, not JSON."
          ],
          "prerequisites": [
            "Andurel project root",
            "bin/shadowfax"
          ],
          "examples": [
            "andurel run",
            "andurel run --tools mailpit"
          ],
          "mutating": false,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": false,
          "supports_jq": false,
          "supports_ids_only": false,
          "supports_count": false,
          "skip_dry_run_check": true
        }
      },
