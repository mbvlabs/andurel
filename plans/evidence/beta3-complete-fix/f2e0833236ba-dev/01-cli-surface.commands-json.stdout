      {
        "name": "upgrade",
        "path": "andurel upgrade",
        "aliases": [
          "up"
        ],
        "short": "Upgrade the project to this CLI version",
        "long": "Upgrade framework files and tool versions.\n\n⚠️  IMPORTANT: Commit or create a branch before upgrading! This command modifies files in place.\n\nThis command will:\n  1. Verify that the installed Andurel CLI is the latest stable release\n  2. Replace framework-managed files with the latest version\n  3. Update tool versions in andurel.lock\n  4. Pin required github.com/mbvlabs/andurel/pkg/* modules in go.mod to the\n     versions verified with this CLI (never downgrades a newer pin)\n\nYou are responsible for updating application code to work with any API\nchanges. After go.mod changes, run go mod tidy. To take the latest published\npackage versions without a framework upgrade, use andurel packages update.",
        "usage": "andurel upgrade [flags]",
        "examples": "andurel upgrade\n  andurel upgrade --dry-run\n  andurel upgrade --repair",
        "local_flags": [
          {
            "name": "diff",
            "usage": "Include a text diff preview in structured output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "dry-run",
            "usage": "Show what would be changed without applying",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "repair",
            "usage": "Restore drifted framework-owned files when already on this version",
            "default": "false",
            "type": "bool"
          }
        ],
        "inherited_flags": [
          {
            "name": "agent",
            "usage": "Emit structured output optimized for agents",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "count",
            "usage": "Emit one raw resource count when supported",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "ids-only",
            "usage": "Emit one resource identifier per line when supported",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "jq",
            "usage": "Select a field path (for example .routes[0].name) from command data and emit JSON directly",
            "type": "string"
          },
          {
            "name": "json",
            "usage": "Emit JSON output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "md",
            "usage": "Emit Markdown output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "quiet",
            "usage": "Suppress non-essential human output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "verbose",
            "usage": "Emit verbose output",
            "default": "false",
            "type": "bool"
          }
        ],
        "agent_notes": "After installing a newer Andurel CLI: re-pin pkg modules, sync tools, and list the manual actions to apply.",
        "category": "upgrade",
        "meta": {
          "group": "upgrade",
          "summary": "Upgrade the project to this CLI version",
          "when_to_use": [
            "After installing a newer Andurel CLI: re-pin pkg modules, sync tools, and list the manual actions to apply."
          ],
          "when_not_to_use": [
            "Commit first. Use packages update to bump pkg modules without a framework upgrade."
          ],
          "prerequisites": [
            "Andurel project root"
          ],
          "next": [
            "andurel inspect upgrade-notes --from \u003cprevious-version\u003e"
          ],
          "examples": [
            "andurel upgrade --dry-run --json",
            "andurel upgrade"
          ],
          "mutating": true,
          "requires_project": true,
          "supports_dry_run": true,
          "supports_json": true,
          "supports_jq": true,
          "supports_ids_only": false,
          "supports_count": false
        }
      },
      {
        "name": "verify",
        "path": "andurel verify",
        "short": "Check formatting, vet, layer boundaries, frontend, and generated code",
        "long": "Run the Andurel verification loop against the current project.\n\nandurel verify checks, in order:\n  • setup     — managed tool binaries and frontend dependencies are installed\n  • gofmt     — every Go file is gofmt-clean\n  • go fix    — the toolchain reports no automatic rewrites\n  • go vet    — the module vets clean\n  • layers    — the typed persistence, transaction, and domain transport rules\n  • frontend  — the package.json typecheck script and the route-usage rule\n  • generated — templ, email, narsilc, routes.ts, and payloads.ts output is up to date\n  • content   — the invariants declared in andurel.content.toml\n  • go test   — go test -json (only with --with-tests or --only go-test)\n\nPayload roots that andurel sync payloads cannot resolve are listed under the\ngenerated step's warnings; they do not fail verify. Run andurel sync payloads\n--strict to turn them into errors. verify never rewrites files.\n\nScope:\n  --only \u003cstage[,stage]\u003e   run only the named stages. Stage IDs: setup, gofmt,\n                           go-fix, go-vet, layers, frontend, generated,\n                           content, go-test. Unknown names are usage errors.\n  --rules \u003cid[,id]\u003e        run only the named catalog rules; a rule selects\n                           its owning stage. Rule IDs are listed below.\n  --changed                check only changed files. The default base is HEAD\n                           (staged, unstaged, and untracked changes). Deleted\n                           and renamed paths are included. A bad base, a\n                           non-Git project, or --changed together with Go\n                           package patterns is a usage error, never an empty\n                           green run.\n  --base \u003cref\u003e             base revision for --changed (requires --changed).\n\nIn --changed mode Go stages cover the changed packages and their in-module\nreverse dependencies, including external test packages that import a changed\npackage, so an exported change also checks its dependents. A change to go.mod,\ngo.sum, go.work, go.work.sum, andurel.toml, andurel.lock, or bin/ widens Go\nstages to ./... . The frontend, generated, and content stages always check the\nwhole project when they run; the report records that widening under\nscope.widened. The content stage also runs when a declared catalogFile,\ncatalog target, required path, or opaque checker input changes. An empty change\nset is an explicit no-op: every selected stage is skipped, scope.noop is true,\nand the run does not claim whole-project health.\n\nPass Go package patterns to scope gofmt, go fix, go vet, layers, and go test,\nfor example 'andurel verify ./internal/docs/...'. Package patterns cannot be\ncombined with --changed.\n\nThe layers step loads the active build target, like go vet: files excluded by\nGOOS, GOARCH, or build constraints are not type-checked or analyzed.\n\nRules:\n  gofmt                 every Go file is gofmt-clean (fix: gofmt -w \u003cfile\u003e)\n  go fix                go fix reports no automatic rewrites (fix: go fix ./...)\n  queries-import        only domains/** imports domains/internal/queries (fix: call a method on a domains receiver instead of generated queries)\n  db-handle             outside domains no SQL methods or SQL drivers; Connection/Transaction are persistence wiring (fix: move the database access into a domains method and call it on a receiver)\n  tx-unwrap             storage.Unwrap is referenced only under domains/** (fix: bind a domain receiver with receiver.InTx(tx) instead of unwrapping the transaction)\n  tx-escape             a storage.AtomicOps callback uses only dependencies bound inside the transaction (fix: bind the dependency at the top of the callback (dep := value.InTx(tx)) and use the bound value)\n  tx-public-call        a storage.AtomicOps callback does not call an exported method on its own receiver (fix: move the shared logic into an unexported helper that takes bound dependencies as parameters)\n  tx-layer              storage.AtomicOps and storage.Transactor are used only in services, domains, and internal/runtime (fix: move transaction orchestration into a service; run 'andurel patterns show service')\n  domain-transport      domains/** imports no HTTP, Inertia, routing, handler, middleware, or route package (fix: keep domains free of transport packages; move the adapter to handlers or services)\n  entity-columns        every automatic generated query column maps to an exported andurel tag on its domain entity (fix: add an exported field tagged andurel:\"\u003ccolumn\u003e\", or narrow the query columns and run 'andurel sync queries')\n  setup                 project setup is complete: managed tool binaries and frontend dependencies are installed (fix: run the setup commands named by each violation ('andurel tool sync', '\u003cpackage manager\u003e install'))\n  frontend              the package.json typecheck script passes when the scaffold defines one (fix: fix the reported TypeScript errors and re-run the project package manager's typecheck script)\n  frontend-route-usage  frontend modules do not call full-URL route helpers at module initialization; use .path() or call while rendering (fix: move the call into the component render, an event handler, or a function called after configureRouteHosts; use routes.\u003cname\u003e.path(...) for a relative URL)\n  content-config        andurel.content.toml parses, declares a supported schemaVersion, and its include/exclude globs are valid (fix: fix the reported andurel.content.toml entry; see 'andurel verify --help' for the schema)\n  content-catalog       every declared content catalog entry resolves to an included Markdown file (fix: add the missing Markdown file or correct the catalog entry's file path)\n  content-slug          content catalog slugs are non-empty, match the declared pattern, and are unique (fix: give each catalog entry a unique slug that matches the [slugs].pattern)\n  content-required      every path listed in andurel.content.toml required exists (fix: create the required file or directory, or remove it from the required list)\n  content-link          local Markdown links and images resolve inside the project; configured anchors exist (fix: correct the link target, add the missing file, or fix the anchor; external and site-absolute URLs are not fetched)\n  content-checker       each declared content checker exits 0 within its timeout from its declared working directory (fix: fix the checker's reported diagnostics or its run/dir/timeoutSeconds entry in andurel.content.toml)\n  generated             generated templ, email, queries, routes, and payload output is up to date (fix: run the owning andurel sync command)\n  missing-tool          a required generation binary is installed; run 'andurel tool sync' (fix: andurel tool sync)\n\nThe setup step fails with the exact installation command when a selected\nstage needs a missing binary or node_modules. Dependent stages then report\nstatus 'blocked' (which fails the run) instead of blaming generated-code\ndrift.\n\nThe frontend stage runs the project package manager's 'run typecheck' script\nwhen package.json defines one and analyzes frontend route usage. The\nroute-usage rule flags full-URL route helper calls evaluated at module\ninitialization, because configureRouteHosts runs after boot. It is token-based:\nrelative ESM imports and tsconfig path aliases, namespace/named imports,\nmodule-scope aliases and destructuring, immediately invoked function\nexpressions and bare top-level calls, and one level of local wrapper functions\nare recognized; re-exports, dynamic property access, and cross-module wrappers\nare not. Render-time calls, event handlers, function bodies, and explicit .path()\nrelative helpers are allowed. The Inertia runtime's request-scoped host context\nremains authoritative for the cases static analysis cannot prove.\n\nThe content stage reads andurel.content.toml (schemaVersion = 1):\n  include/exclude  root-relative Markdown globs; '*' stays in one segment,\n                   '**' crosses segments\n  required         paths that must exist\n  catalogFile      optional TOML file with [[entry]] slug/file tables\n  [[catalog]]      inline slug/file entries\n  [slugs]          pattern (default '^[a-z0-9]+(?:-[a-z0-9]+)*$'; empty disables)\n  [links]          anchors = \"ignore\"|\"check\"; external must stay \"ignore\"\n  [[checkers]]     name, run = [argv...], optional dir, timeoutSeconds\n\nContent built-ins validate catalog targets, duplicate and pattern-violating\nslugs, required paths, and local relative links/images (case-sensitive,\nproject-root confined). External URLs, site-absolute '/...' paths, fenced code,\nand inline code spans are not checked; the network is never used. A [[checkers]]\nentry runs its argv without a shell from dir (default project root, resolved\nthrough symlinks and confined to the resolved project root) with a bounded\ntimeout (default 120s, max 600s); exit 0 passes and nonzero output lines shaped\n'path:line: message' become file/line diagnostics. catalogFile gets the same\nsymlink confinement. --rules content-* executes only the selected built-ins and\n[[checkers]] entries, while configuration is always validated.\nProjects without andurel.content.toml report the content stage as skipped and\nnot_applicable, never as checked.\n\nPass --skip-generated to mark the generated step 'skipped'; an explicit skip\ndoes not fail the run. Pass --no-frontend to skip the frontend stage.\n\nPass --with-tests to also run go test -json ./... (or the selected Go packages).\nDB-backed tests need Docker for a Postgres container. A test package that has\ntests but ran none, such as one whose TestMain exits early without Docker, does\nnot fail the run: the go test step stays 'ok' and lists it under\nskipped_packages as {package, reason}. Tests that call t.Skip are listed under\nskipped_tests as {package, test, reason}; they keep the step 'ok' too. The step\nreports per-package status, top-level pass/fail/skip counts, subtests\nseparately, duration, cache/no-test-files information, and totals. Build,\nsetup, timeout, and race failures are marked explicitly.\n\nEach step reports status 'ok', 'fail', 'blocked', or 'skipped'. Every failing\nstep lists violations as {rule, file, line, message, fix}. A failed or blocked\nverification exits with code 9 (verification_failed); usage errors exit with\ncode 1.",
        "usage": "andurel verify [packages...] [flags]",
        "examples": "andurel verify\n  andurel verify --json\n  andurel verify ./internal/docs/...\n  andurel verify --with-tests\n  andurel verify --only layers,frontend\n  andurel verify --rules db-handle,frontend-route-usage\n  andurel verify --changed\n  andurel verify --changed --base origin/main\n  andurel verify --skip-generated\n  andurel verify --no-frontend",
        "local_flags": [
          {
            "name": "base",
            "usage": "Git revision compared by --changed",
            "default": "HEAD",
            "type": "string"
          },
          {
            "name": "changed",
            "usage": "Check changed files (tracked staged/unstaged, untracked, deletions, renames)",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "no-frontend",
            "usage": "Skip the frontend typecheck and route-usage stage",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "only",
            "usage": "Run only these stages (comma-separated or repeated; see --help)",
            "default": "[]",
            "type": "stringSlice"
          },
          {
            "name": "rules",
            "usage": "Run only these catalog rules (comma-separated or repeated; see --help)",
            "default": "[]",
            "type": "stringSlice"
          },
          {
            "name": "skip-generated",
            "usage": "Skip the generated-code drift stage",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "with-tests",
            "usage": "Also run go test -json",
            "default": "false",
            "type": "bool"
          }
        ],
        "inherited_flags": [
          {
            "name": "agent",
            "usage": "Emit structured output optimized for agents",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "count",
            "usage": "Emit one raw resource count when supported",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "ids-only",
            "usage": "Emit one resource identifier per line when supported",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "jq",
            "usage": "Select a field path (for example .routes[0].name) from command data and emit JSON directly",
            "type": "string"
          },
          {
            "name": "json",
            "usage": "Emit JSON output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "md",
            "usage": "Emit Markdown output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "quiet",
            "usage": "Suppress non-essential human output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "verbose",
            "usage": "Emit verbose output",
            "default": "false",
            "type": "bool"
          }
        ],
        "agent_notes": "After a change, before commit: gofmt, go fix, go vet, the typed persistence and transaction boundary checks, the package.json typecheck script, and generated-code drift. Pass Go package patterns to scope gofmt, go fix, go vet, and layers to those packages; generated drift and the frontend typecheck stay whole-project. A missing generation binary fails the generated step; apply the rule's fix, or pass --skip-generated to mark the step skipped. Rules lists every rule and its fix. Without node_modules the frontend step fails with an install hint; pass --no-frontend to skip it explicitly. Read each violation's fix field and apply it; a failed run exits 9 (verification_failed). With --with-tests, check the go test step's skipped_packages: packages listed there ran no tests (DB tests skip without Docker) even though the step is ok. With --with-tests, tests that called t.Skip are listed in the go test step's skipped_tests as {package, test, reason}; they do not fail the run either. Unresolved inertia.FromStruct payload roots are listed in the generated step's warnings and do not fail verify; andurel sync payloads --strict turns them into errors.",
        "category": "verify",
        "meta": {
          "group": "verify",
          "summary": "Check formatting, vet, layer boundaries, frontend, and generated code",
          "args": "[packages...]",
          "when_to_use": [
            "After a change, before commit: gofmt, go fix, go vet, the typed persistence and transaction boundary checks, the package.json typecheck script, and generated-code drift.",
            "Pass Go package patterns to scope gofmt, go fix, go vet, and layers to those packages; generated drift and the frontend typecheck stay whole-project.",
            "A missing generation binary fails the generated step; apply the rule's fix, or pass --skip-generated to mark the step skipped. Rules lists every rule and its fix.",
            "Without node_modules the frontend step fails with an install hint; pass --no-frontend to skip it explicitly.",
            "Read each violation's fix field and apply it; a failed run exits 9 (verification_failed).",
            "With --with-tests, check the go test step's skipped_packages: packages listed there ran no tests (DB tests skip without Docker) even though the step is ok.",
            "With --with-tests, tests that called t.Skip are listed in the go test step's skipped_tests as {package, test, reason}; they do not fail the run either.",
            "Unresolved inertia.FromStruct payload roots are listed in the generated step's warnings and do not fail verify; andurel sync payloads --strict turns them into errors."
          ],
          "when_not_to_use": [
            "verify is read-only; fix the reported issues yourself and re-run."
          ],
          "prerequisites": [
            "Andurel project root"
          ],
          "examples": [
            "andurel verify",
            "andurel verify --json",
            "andurel verify ./internal/docs/...",
            "andurel verify --with-tests",
            "andurel verify --skip-generated",
            "andurel verify --no-frontend"
          ],
          "rules": [
            {
              "id": "gofmt",
              "summary": "every Go file is gofmt-clean",
              "fix": "gofmt -w \u003cfile\u003e",
              "layer": "format"
            },
            {
              "id": "go fix",
              "summary": "go fix reports no automatic rewrites",
              "fix": "go fix ./...",
              "layer": "build"
            },
            {
              "id": "queries-import",
              "summary": "only domains/** imports domains/internal/queries",
              "fix": "call a method on a domains receiver instead of generated queries",
              "layer": "layers"
            },
            {
              "id": "db-handle",
              "summary": "outside domains no SQL methods or SQL drivers; Connection/Transaction are persistence wiring",
              "fix": "move the database access into a domains method and call it on a receiver",
              "layer": "layers"
            },
            {
              "id": "tx-unwrap",
              "summary": "storage.Unwrap is referenced only under domains/**",
              "fix": "bind a domain receiver with receiver.InTx(tx) instead of unwrapping the transaction",
              "layer": "layers"
            },
            {
              "id": "tx-escape",
              "summary": "a storage.AtomicOps callback uses only dependencies bound inside the transaction",
              "fix": "bind the dependency at the top of the callback (dep := value.InTx(tx)) and use the bound value",
              "layer": "layers"
            },
            {
              "id": "tx-public-call",
              "summary": "a storage.AtomicOps callback does not call an exported method on its own receiver",
              "fix": "move the shared logic into an unexported helper that takes bound dependencies as parameters",
              "layer": "layers"
            },
            {
              "id": "tx-layer",
              "summary": "storage.AtomicOps and storage.Transactor are used only in services, domains, and internal/runtime",
              "fix": "move transaction orchestration into a service; run 'andurel patterns show service'",
              "layer": "layers"
            },
            {
              "id": "domain-transport",
              "summary": "domains/** imports no HTTP, Inertia, routing, handler, middleware, or route package",
              "fix": "keep domains free of transport packages; move the adapter to handlers or services",
              "layer": "layers"
            },
            {
              "id": "entity-columns",
              "summary": "every automatic generated query column maps to an exported andurel tag on its domain entity",
              "fix": "add an exported field tagged andurel:\"\u003ccolumn\u003e\", or narrow the query columns and run 'andurel sync queries'",
              "layer": "layers"
            },
            {
              "id": "setup",
              "summary": "project setup is complete: managed tool binaries and frontend dependencies are installed",
              "fix": "run the setup commands named by each violation ('andurel tool sync', '\u003cpackage manager\u003e install')",
              "layer": "setup"
            },
            {
              "id": "frontend",
              "summary": "the package.json typecheck script passes when the scaffold defines one",
              "fix": "fix the reported TypeScript errors and re-run the project package manager's typecheck script",
              "layer": "frontend"
            },
            {
              "id": "frontend-route-usage",
              "summary": "frontend modules do not call full-URL route helpers at module initialization; use .path() or call while rendering",
              "fix": "move the call into the component render, an event handler, or a function called after configureRouteHosts; use routes.\u003cname\u003e.path(...) for a relative URL",
              "layer": "frontend"
            },
            {
              "id": "content-config",
              "summary": "andurel.content.toml parses, declares a supported schemaVersion, and its include/exclude globs are valid",
              "fix": "fix the reported andurel.content.toml entry; see 'andurel verify --help' for the schema",
              "layer": "content"
            },
            {
              "id": "content-catalog",
              "summary": "every declared content catalog entry resolves to an included Markdown file",
              "fix": "add the missing Markdown file or correct the catalog entry's file path",
              "layer": "content"
            },
            {
              "id": "content-slug",
              "summary": "content catalog slugs are non-empty, match the declared pattern, and are unique",
              "fix": "give each catalog entry a unique slug that matches the [slugs].pattern",
              "layer": "content"
            },
            {
              "id": "content-required",
              "summary": "every path listed in andurel.content.toml required exists",
              "fix": "create the required file or directory, or remove it from the required list",
              "layer": "content"
            },
            {
              "id": "content-link",
              "summary": "local Markdown links and images resolve inside the project; configured anchors exist",
              "fix": "correct the link target, add the missing file, or fix the anchor; external and site-absolute URLs are not fetched",
              "layer": "content"
            },
            {
              "id": "content-checker",
              "summary": "each declared content checker exits 0 within its timeout from its declared working directory",
              "fix": "fix the checker's reported diagnostics or its run/dir/timeoutSeconds entry in andurel.content.toml",
              "layer": "content"
            },
            {
              "id": "generated",
              "summary": "generated templ, email, queries, routes, and payload output is up to date",
              "fix": "run the owning andurel sync command",
              "layer": "generated"
            },
            {
              "id": "missing-tool",
              "summary": "a required generation binary is installed; run 'andurel tool sync'",
              "fix": "andurel tool sync",
              "layer": "generated"
            }
          ],
          "mutating": false,
          "requires_project": true,
          "supports_dry_run": false,
          "supports_json": true,
          "supports_jq": true,
          "supports_ids_only": false,
          "supports_count": false
        }
      }
    ],
    "catalog": [
      {
        "summary": "Andurel CLI for humans and agents",
        "when_to_use": [
          "Discover commands, then run a specific subcommand."
        ],
        "when_not_to_use": [
          "Do not guess generator names; run andurel commands --json first."
        ],
        "examples": [
          "andurel commands --json",
          "andurel --help",
          "andurel new myapp"
        ],
        "mutating": false,
        "supports_dry_run": false,
        "supports_json": true,
        "supports_jq": false,
        "supports_ids_only": false,
        "supports_count": false,
        "name": "andurel",
        "path": "andurel",
        "usage": "andurel [flags]",
        "flags": [
          {
            "name": "agent",
            "usage": "Emit structured output optimized for agents",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "count",
            "usage": "Emit one raw resource count when supported",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "ids-only",
