      {
        "group": "new",
        "summary": "Stand up a new Andurel project",
        "args": "[project-name]",
        "details": [
          "Quick Start, also printed by andurel new and in the generated README: andurel tool sync; pnpm install (or bun/npm to match --ui); cp .env.example .env and set the required values; andurel db create (only if the database does not exist); andurel db migrate up; andurel doctor; andurel run; andurel verify.",
          "Pass --harness codex|claude|pi|opencode|crush (comma-separated or repeated) to install the bundled agent skill during creation. Without it the skill is not installed and the next steps print an explicit install example."
        ],
        "when_to_use": [
          "Create a new application directory from the current scaffold.",
          "Creation is offline: it installs no dependencies and needs no database."
        ],
        "when_not_to_use": [
          "Do not run inside an existing Andurel project."
        ],
        "next": [
          "cd \u003cproject\u003e",
          "andurel tool sync",
          "pnpm install (or bun/npm install to match --ui)",
          "cp .env.example .env",
          "andurel db create (only if the database does not exist)",
          "andurel db migrate up",
          "andurel doctor",
          "andurel run",
          "andurel verify"
        ],
        "examples": [
          "andurel new myapp",
          "andurel new myapp --ui vue/pnpm",
          "andurel new myapp --harness claude",
          "andurel new myapp --dry-run --json"
        ],
        "mutating": true,
        "supports_dry_run": true,
        "supports_json": true,
        "supports_jq": true,
        "supports_ids_only": false,
        "supports_count": false,
        "name": "new",
        "path": "andurel new",
        "aliases": [
          "n"
        ],
        "usage": "andurel new [project-name] [flags]",
        "flags": [
          {
            "name": "diff",
            "usage": "Include a text diff preview in structured output",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "dry-run",
            "usage": "Preview project files without creating them",
            "default": "false",
            "type": "bool"
          },
          {
            "name": "harness",
            "usage": "Install the Andurel skill for these harnesses: codex, claude, pi, opencode, crush (comma-separated or repeated)",
            "default": "[]",
            "type": "stringSlice"
          },
          {
            "name": "ui",
            "usage": "UI combination: react|vue|svelte / pnpm|bun|npm (default: react/pnpm)",
            "default": "react/pnpm",
            "type": "string"
          }
        ]
      },
