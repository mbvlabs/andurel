        "group": "ports",
        "summary": "Allocate and supervise collision-safe loopback ports",
        "when_to_use": [
          "Start a production SSR sidecar on a leased loopback port and publish the matching INERTIA_SSR_LISTEN and INERTIA_SSR_URL."
        ],
        "when_not_to_use": [
          "Do not use it for local development; andurel run serves development SSR from Vite's /__inertia_ssr endpoint.",
          "It is not a find-a-free-port helper: the lease stays held for the whole child lifetime."
        ],
        "prerequisites": [
          "cmd/ssr is built with andurel build, or pass an explicit child command to ports launch"
        ],
        "examples": [
          "andurel ports --help",
          "andurel ports launch -- ./dist/ssr"
        ],
        "mutating": false,
        "supports_dry_run": false,
