{{- if $needsSession}}
	"{{.ModulePath}}/router/cookies"
{{- end}}
	"{{.ModulePath}}/router/routes"
)

type {{.PluralResourceName}} struct {
	{{.ModelServiceName | ToLowerCamelCase}} models.{{.ModelServiceName}}
	renderer                                 *inertia.Renderer
{{- if $needsSession}}
	session                                  *cookies.Session
{{- end}}
}

func New{{.PluralResourceName}}({{.ModelServiceName | ToLowerCamelCase}} models.{{.ModelServiceName}}, renderer *inertia.Renderer{{- if $needsSession}}, session *cookies.Session{{- end}}) {{.PluralResourceName}} {
	return {{.PluralResourceName}}{ {{.ModelServiceName | ToLowerCamelCase}}: {{.ModelServiceName | ToLowerCamelCase}}, renderer: renderer{{- if $needsSession}}, session: session{{- end}} }
}

func ({{.ReceiverName}} {{.PluralResourceName}}) RegisterRoutes(r *router.Router) error {
	var errs []error
	var err error

{{- if HasAction "index" }}
	_, err = r.AddRoute(echo.Route{
		Method:  http.MethodGet,
		Path:    routes.{{.NamespacePascal}}{{.ResourceName}}Index.Path(),
		Name:    routes.{{.NamespacePascal}}{{.ResourceName}}Index.Name(),
		Handler: {{.ReceiverName}}.Index,
	})
	if err != nil {
		errs = append(errs, err)
	}
{{- end }}

{{- if HasAction "show" }}
	_, err = r.AddRoute(echo.Route{
		Method:  http.MethodGet,
		Path:    routes.{{.NamespacePascal}}{{.ResourceName}}Show.Path(),
		Name:    routes.{{.NamespacePascal}}{{.ResourceName}}Show.Name(),
		Handler: {{.ReceiverName}}.Show,
	})
	if err != nil {
		errs = append(errs, err)
	}
{{- end }}

{{- if HasAction "new" }}
	_, err = r.AddRoute(echo.Route{
		Method:  http.MethodGet,
		Path:    routes.{{.NamespacePascal}}{{.ResourceName}}New.Path(),
		Name:    routes.{{.NamespacePascal}}{{.ResourceName}}New.Name(),
		Handler: {{.ReceiverName}}.New,
	})
	if err != nil {
		errs = append(errs, err)
	}
{{- end }}

{{- if HasAction "create" }}
	_, err = r.AddRoute(echo.Route{
		Method:  http.MethodPost,
		Path:    routes.{{.NamespacePascal}}{{.ResourceName}}Create.Path(),
		Name:    routes.{{.NamespacePascal}}{{.ResourceName}}Create.Name(),
		Handler: {{.ReceiverName}}.Create,
	})
	if err != nil {
		errs = append(errs, err)
	}
{{- end }}

{{- if HasAction "edit" }}
	_, err = r.AddRoute(echo.Route{
		Method:  http.MethodGet,
		Path:    routes.{{.NamespacePascal}}{{.ResourceName}}Edit.Path(),
		Name:    routes.{{.NamespacePascal}}{{.ResourceName}}Edit.Name(),
		Handler: {{.ReceiverName}}.Edit,
	})
	if err != nil {
		errs = append(errs, err)
	}
{{- end }}

{{- if HasAction "update" }}
	_, err = r.AddRoute(echo.Route{
		Method:  http.MethodPut,
		Path:    routes.{{.NamespacePascal}}{{.ResourceName}}Update.Path(),
		Name:    routes.{{.NamespacePascal}}{{.ResourceName}}Update.Name(),
		Handler: {{.ReceiverName}}.Update,
	})
	if err != nil {
		errs = append(errs, err)
	}
{{- end }}

{{- if HasAction "destroy" }}
	_, err = r.AddRoute(echo.Route{
		Method:  http.MethodDelete,
		Path:    routes.{{.NamespacePascal}}{{.ResourceName}}Destroy.Path(),
		Name:    routes.{{.NamespacePascal}}{{.ResourceName}}Destroy.Name(),
		Handler: {{.ReceiverName}}.Destroy,
	})
	if err != nil {
		errs = append(errs, err)
	}
{{- end }}

{{- range CustomActions }}
	_, err = r.AddRoute(echo.Route{
		Method:  http.MethodGet,
		Path:    routes.{{$.NamespacePascal}}{{$.ResourceName}}{{.MethodName}}.Path(),
		Name:    routes.{{$.NamespacePascal}}{{$.ResourceName}}{{.MethodName}}.Name(),
		Handler: {{$.ReceiverName}}.{{.MethodName}},
	})
	if err != nil {
		errs = append(errs, err)
	}
{{- end }}

	return errors.Join(errs...)
}

type {{.ResourceName}}Data struct {
{{- range .Fields}}
	{{.Name}} {{InertiaDataType .}} `json:"{{.CamelCase}}"`
{{- end}}
}

type {{.ResourceName}}IndexProps struct {
	Items []{{.ResourceName}}Data `json:"items"`
}

type {{.ResourceName}}ItemProps struct {
	Item {{.ResourceName}}Data `json:"item"`
}

func new{{.ResourceName}}Data(entity models.{{.ModelName}}) {{.ResourceName}}Data {
	return {{.ResourceName}}Data{
{{- range .Fields}}
		{{.Name}}: {{InertiaDataValue . (printf "entity.%s" .Name)}},
{{- end}}
	}
}

func new{{.ResourceName}}DataList(entities []models.{{.ModelName}}) []{{.ResourceName}}Data {
	items := make([]{{.ResourceName}}Data, 0, len(entities))
	for _, entity := range entities {
		items = append(items, new{{.ResourceName}}Data(entity))
	}

	return items
}

func ({{.ReceiverName}} {{.PluralResourceName}}) Index(etx *echo.Context) error {
	page := int64(1)
	if p := etx.QueryParam("page"); p != "" {
		if parsed, err := strconv.Atoi(p); err == nil && parsed > 0 {
			page = int64(parsed)
		}
	}

	perPage := int64(25)
	if pp := etx.QueryParam("per_page"); pp != "" {
		if parsed, err := strconv.Atoi(pp); err == nil && parsed > 0 &&
			parsed <= 100 {
			perPage = int64(parsed)
		}
	}

	{{.ModelPluralName | ToCamelCase}}List, err := {{.ReceiverName}}.{{.ModelServiceName | ToLowerCamelCase}}.Paginate(
		etx.Request().Context(),
		page,
		perPage,
	)
	if err != nil {
		return {{.ReceiverName}}.renderer.Page(etx, "Errors/InternalError", inertia.Props{}).Render()
	}

	return {{.ReceiverName}}.renderer.Page(
		etx,
		"{{if .Namespace}}{{.NamespacePascal}}/{{end}}{{.ResourceName}}/Index",
		inertia.FromStruct({{.ResourceName}}IndexProps{
			Items: new{{.ResourceName}}DataList({{.ModelPluralName | ToCamelCase}}List.{{.ModelCollectionName}}),
		}),
	).Render()
}

func ({{.ReceiverName}} {{.PluralResourceName}}) Show(etx *echo.Context) error {
{{- if or (not .IDType) (eq .IDType "uuid.UUID") (eq .IDType "pgtype.UUID")}}
	{{.ResourceName | ToLowerCamelCase}}ID, err := uuid.Parse(etx.Param("id"))
	if err != nil {
		return {{.ReceiverName}}.renderer.Page(etx, "Errors/BadRequest", inertia.Props{}).Render()
	}
{{- else if eq .IDType "int64"}}
	{{.ResourceName | ToLowerCamelCase}}ID, err := strconv.ParseInt(etx.Param("id"), 10, 64)
	if err != nil {
		return {{.ReceiverName}}.renderer.Page(etx, "Errors/BadRequest", inertia.Props{}).Render()
	}
{{- else if eq .IDType "int32"}}
	parsed, err := strconv.ParseInt(etx.Param("id"), 10, 32)
	if err != nil {
		return {{.ReceiverName}}.renderer.Page(etx, "Errors/BadRequest", inertia.Props{}).Render()
	}
	{{.ResourceName | ToLowerCamelCase}}ID := int32(parsed)
{{- else if eq .IDType "string"}}
	{{.ResourceName | ToLowerCamelCase}}ID := etx.Param("id")
	if {{.ResourceName | ToLowerCamelCase}}ID == "" {
		return {{.ReceiverName}}.renderer.Page(etx, "Errors/BadRequest", inertia.Props{}).Render()
	}
{{- end}}

	{{.ResourceName | ToLowerCamelCase}}, err := {{.ReceiverName}}.{{.ModelServiceName | ToLowerCamelCase}}.Find(etx.Request().Context(), {{if eq .IDType "pgtype.UUID"}}pgtype.UUID{Bytes: {{.ResourceName | ToLowerCamelCase}}ID, Valid: true}{{else}}{{.ResourceName | ToLowerCamelCase}}ID{{end}})
	if err != nil {
		return {{.ReceiverName}}.renderer.Page(etx, "Errors/NotFound", inertia.Props{}).Render()
	}

	return {{.ReceiverName}}.renderer.Page(
		etx,
		"{{if .Namespace}}{{.NamespacePascal}}/{{end}}{{.ResourceName}}/Show",
		inertia.FromStruct({{.ResourceName}}ItemProps{
			Item: new{{.ResourceName}}Data({{.ResourceName | ToLowerCamelCase}}),
		}),
	).Render()
}

func ({{.ReceiverName}} {{.PluralResourceName}}) New(etx *echo.Context) error {
	return {{.ReceiverName}}.renderer.Page(etx, "{{if .Namespace}}{{.NamespacePascal}}/{{end}}{{.ResourceName}}/Create", inertia.Props{}).Render()
}

type Create{{.ResourceName}}FormPayload struct {
{{- range .Fields}}
{{- if not .IsSystemField}}
	{{- if eq .GoFormType "time.Time"}}
	{{.Name}}    string `json:"{{.CamelCase}}"`
	{{- else}}
	{{.Name}}    {{.GoFormType}} `json:"{{.CamelCase}}"`
	{{- end}}
{{- end}}
{{- end}}
}

func ({{.ReceiverName}} {{.PluralResourceName}}) Create(etx *echo.Context) error {
	var payload Create{{.ResourceName}}FormPayload
	if err := etx.Bind(&payload); err != nil {
		slog.ErrorContext(
			etx.Request().Context(),
			"could not parse Create{{.ResourceName}}FormPayload",
			"error",
			err,
		)

		return {{.ReceiverName}}.renderer.Page(etx, "Errors/NotFound", inertia.Props{}).Render()
	}

	data := models.Create{{.ModelName}}Data{
{{- range .Fields}}
{{- if not .IsSystemField}}
		{{template "ControllerPayloadAssignment" .}}
{{- end}}
{{- end}}
	}

	{{.ResourceName | ToLowerCamelCase}}, err := {{.ReceiverName}}.{{.ModelServiceName | ToLowerCamelCase}}.Create(
		etx.Request().Context(),
		data,
	)
	if err != nil {
		if flashErr := {{.ReceiverName}}.session.AddFlash(etx, cookies.FlashError, fmt.Sprintf("Failed to create {{.ResourceName | ToLowerCamelCase}}: %v", err)); flashErr != nil {
			return flashErr
		}
		{{- if HasAction "new"}}
		return {{.ReceiverName}}.renderer.Redirect(etx, routes.{{.NamespacePascal}}{{.ResourceName}}New.URL(), http.StatusSeeOther)
		{{- else}}
		return {{.ReceiverName}}.renderer.Page(etx, "Errors/InternalError", inertia.Props{}).Render()
		{{- end}}
	}

	if flashErr := {{.ReceiverName}}.session.AddFlash(etx, cookies.FlashSuccess, "{{.ResourceName}} created successfully"); flashErr != nil {
		return {{.ReceiverName}}.renderer.Page(etx, "Errors/InternalError", inertia.Props{}).Render()
	}

	{{- if HasAction "show"}}
	return {{.ReceiverName}}.renderer.Redirect(etx, routes.{{.NamespacePascal}}{{.ResourceName}}Show.URL({{.ResourceName | ToLowerCamelCase}}.{{.IDGoFieldName}}{{if eq .IDType "pgtype.UUID"}}.Bytes{{end}}), http.StatusSeeOther)
	{{- else}}
	_ = {{.ResourceName | ToLowerCamelCase}}
	{{- if HasAction "index"}}
	return {{.ReceiverName}}.renderer.Redirect(etx, routes.{{.NamespacePascal}}{{.ResourceName}}Index.URL(), http.StatusSeeOther)
	{{- else}}
	return etx.NoContent(201)
	{{- end}}
	{{- end}}
}

