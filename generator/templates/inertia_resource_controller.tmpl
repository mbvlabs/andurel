{{- $needsPG := eq .IDType "pgtype.UUID"}}
{{- range .Fields}}
{{- if or (eq .GoFormType "time.Time") (eq .GoType "sql.NullTime")}}
	{{- $needsTime = true}}
{{- end}}
{{- if and (not .IsSystemField) (or (eq .GoType "uuid.UUID") (eq .GoType "*uuid.UUID"))}}
	{{- $needsUUID = true}}
{{- end}}
{{- if and (not .IsSystemField) (hasPrefix .GoType "pgtype.")}}
	{{- $needsPG = true}}
{{- end}}
{{- if and (not .IsSystemField) (eq .GoType "json.RawMessage") (or (HasAction "create") (HasAction "update"))}}
	{{- $needsJSON = true}}
{{- end}}
{{- if and (not .IsSystemField) (hasPrefix .GoType "sql.Null")}}
	{{- $needsSQLNull = true}}
{{- end}}
{{- end}}
{{- if $needsTime}}
	"time"
{{- end}}
{{- if $needsJSON}}
