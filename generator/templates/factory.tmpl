package factories

import (
	"context"
	"fmt"
{{- range .StandardImports}}
	"{{.}}"
{{- end}}

	"github.com/mbvlabs/andurel/pkg/storage"
	"{{.ModulePath}}/models"
{{- range .ExternalImports}}
	"{{.}}"
{{- end}}
)

// {{.ModelName}}Factory wraps models.{{.EntityName}} for testing
type {{.ModelName}}Factory struct {
	models.{{.EntityName}}
}

type {{.ModelName}}Option func(*{{.ModelName}}Factory)

// Build{{.ModelName}} creates an in-memory {{.ModelName}} with default test values.
// Auto-managed fields (ID, timestamps) are left at zero and set by Create{{.ModelName}}.
func Build{{.ModelName}}({{- range .ForeignKeyFields}}{{.ArgumentName}} {{.Type}}, {{end}}opts ...{{.ModelName}}Option) models.{{.EntityName}} {
	f := &{{.ModelName}}Factory{
		{{.EntityName}}: models.{{.EntityName}}{
{{- range .Fields}}
{{- if not .IsAutoManaged}}
{{- if .IsFK}}
			{{.Name}}: {{.ArgumentName}},
{{- else}}
			{{.Name}}: {{.DefaultValue}},
{{- end}}
{{- end}}
{{- end}}
		},
	}

	for _, opt := range opts {
		opt(f)
	}

	return f.{{.EntityName}}
}

{{if .HasCreateFunction}}
// Create{{.ModelName}} creates and persists a {{.ModelName}} to the database.
// It returns the entity populated with all DB-assigned values via RETURNING *.
func Create{{.ModelName}}(ctx context.Context, db storage.Connection, {{range .ForeignKeyFields}}{{.ArgumentName}} {{.Type}}, {{end}}opts ...{{.ModelName}}Option) (models.{{.EntityName}}, error) {
	built := Build{{.ModelName}}({{range .ForeignKeyFields}}{{.ArgumentName}}, {{end}}opts...)

	return models.New{{.NamespaceVar}}(db).Create(ctx, models.Create{{.ModelName}}Data{
{{- if and (not .IsAutoIncrementID) .IDGoFieldName}}
{{- if and .IDType (ne .IDType "uuid.UUID") (ne .IDType "pgtype.UUID")}}
		{{.IDGoFieldName}}: built.{{.IDGoFieldName}},
{{- end}}
{{- end}}
{{- range .Fields}}
{{- if not .IsAutoManaged}}
		{{.Name}}: built.{{.Name}},
{{- end}}
{{- end}}
	})
}

// Create{{.ModelName | plural}} creates multiple {{.ModelName}} records at once
func Create{{.ModelName | plural}}(ctx context.Context, db storage.Connection, {{range .ForeignKeyFields}}{{.ArgumentName}} {{.Type}}, {{end}}count int, opts ...{{.ModelName}}Option) ([]models.{{.EntityName}}, error) {
	{{.ModelName | plural | lowerCamel}} := make([]models.{{.EntityName}}, 0, count)

	for i := range count {
		entity, err := Create{{.ModelName}}(ctx, db, {{range .ForeignKeyFields}}{{.ArgumentName}}, {{end}}opts...)
		if err != nil {
			return nil, fmt.Errorf("failed to create {{.ModelName | toLower}} %d: %w", i+1, err)
		}
		{{.ModelName | plural | lowerCamel}} = append({{.ModelName | plural | lowerCamel}}, entity)
	}

	return {{.ModelName | plural | lowerCamel}}, nil
}
{{end}}

// Option functions
{{- range .Fields}}
{{- if not .IsAutoManaged}}

// {{.OptionName}} sets the {{.Name}} field
func {{.OptionName}}(value {{.Type}}) {{$.ModelName}}Option {
	return func(f *{{$.ModelName}}Factory) {
		f.{{$.EntityName}}.{{.Name}} = value
	}
}
{{- end}}
{{- end}}
