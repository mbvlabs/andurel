<script lang="ts">
  import { Link{{if InertiaUsesForm .ComponentName}}, useForm{{end}} } from '@inertiajs/svelte'
{{- if eq .ComponentName "Index"}}
  import type { {{InertiaPayloadType}}, {{.ResourceName}}IndexProps } from '{{InertiaPayloadImportPath}}'
{{- else if eq .ComponentName "Show"}}
  import type { {{InertiaPayloadType}}, {{.ResourceName}}ItemProps } from '{{InertiaPayloadImportPath}}'
{{- else if eq .ComponentName "Create"}}
  import type { {{InertiaCreateFormPayload}} } from '{{InertiaPayloadImportPath}}'
{{- else if eq .ComponentName "Edit"}}
  import type { {{InertiaPayloadType}}, {{.ResourceName}}ItemProps, {{InertiaUpdateFormPayload}} } from '{{InertiaPayloadImportPath}}'
{{- end}}
{{- if InertiaComponentUsesRoutes .ComponentName}}
  import { routes } from '{{ InertiaRoutesImportPath }}'
{{- end}}

{{- if InertiaNeedsItem .ComponentName }}
  type RouteID = {{ InertiaRouteIDType }}

  function routeID(item: {{InertiaPayloadType}}): RouteID {
    return item.{{InertiaIDJSONName}}
  }
{{- end}}

{{- if eq .ComponentName "Index"}}
  let { items }: {{.ResourceName}}IndexProps = $props()
{{- else if eq .ComponentName "Show"}}
  let { item }: {{.ResourceName}}ItemProps = $props()
{{- else if eq .ComponentName "Create"}}
  const form = useForm<{{InertiaCreateFormPayload}}>({
{{- range .Fields}}
{{- if not .IsSystemField}}
    {{.CamelCase}}: {{ ReactCreateValue . }},
{{- end}}
{{- end}}
  })

  function submit(event: SubmitEvent) {
    event.preventDefault()
    $form.post({{ InertiaRouteURL "create" }})
  }
{{- else if eq .ComponentName "Edit"}}
  let { item }: {{.ResourceName}}ItemProps = $props()

  const form = useForm<{{InertiaUpdateFormPayload}}>({
{{- range .Fields}}
{{- if not .IsSystemField}}
    {{.CamelCase}}: {{ ReactEditValue . }},
{{- end}}
{{- end}}
  })

  function submit(event: SubmitEvent) {
    event.preventDefault()
    $form.put({{ InertiaRouteURL "update" "routeID(item)" }})
  }
{{- end}}
</script>

{{- if eq .ComponentName "Index"}}
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-foreground">{{.ResourceName}}s</h1>
    <Link href={ {{- InertiaRouteURL "new" -}} } class="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">New {{.ResourceName}}</Link>
  </div>

  <div class="mt-8 overflow-hidden border border-border bg-card shadow-sm">
    <table class="min-w-full divide-y divide-border">
      <thead class="bg-background">
        <tr>
{{- range .Fields}}
          <th class="px-6 py-3 text-left text-xs font-medium uppercase text-muted-foreground">{{.DisplayName}}</th>
{{- end}}
          <th class="px-6 py-3 text-right text-xs font-medium uppercase text-muted-foreground">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border bg-card">
        {#each items as item (item.{{InertiaIDJSONName}})}
          <tr class="hover:bg-background">
{{- range .Fields}}
            <td class="whitespace-nowrap px-6 py-4 text-sm text-foreground">{ {{- ReactDisplay . "item" -}} }</td>
{{- end}}
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
              <Link href={ {{- InertiaRouteURL "show" "routeID(item)" -}} } class="mr-3 text-ring hover:text-card-foreground">View</Link>
              <Link href={ {{- InertiaRouteURL "edit" "routeID(item)" -}} } class="mr-3 text-ring hover:text-card-foreground">Edit</Link>
              <Link href={ {{- InertiaRouteURL "destroy" "routeID(item)" -}} } method="delete" as="button" class="text-destructive hover:text-destructive/80">Delete</Link>
            </td>
          </tr>
        {/each}
      </tbody>
    </table>
  </div>
</div>
{{- else if eq .ComponentName "Show"}}
<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-foreground">{{.ResourceName}} Details</h1>
    <div class="flex gap-3">
      <Link href={ {{- InertiaRouteURL "edit" "routeID(item)" -}} } class="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">Edit</Link>
      <Link href={ {{- InertiaRouteURL "index" -}} } class="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Back</Link>
    </div>
  </div>

  <div class="mt-8 overflow-hidden border border-border bg-card shadow-sm">
    <dl class="divide-y divide-border">
{{- range .Fields}}
      <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-medium text-muted-foreground">{{.DisplayName}}</dt>
        <dd class="mt-1 text-sm text-foreground sm:col-span-2 sm:mt-0">{ {{- ReactDisplay . "item" -}} }</dd>
      </div>
{{- end}}
    </dl>
  </div>
</div>
{{- else if eq .ComponentName "Create"}}
<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-foreground">New {{.ResourceName}}</h1>
    <Link href={ {{- InertiaRouteURL "index" -}} } class="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Back</Link>
  </div>

  <form onsubmit={submit} class="mt-8 space-y-6 overflow-hidden border border-border bg-card p-6 shadow-sm">
{{- range .Fields}}
{{- if not .IsSystemField}}
    <div>
      <label for="{{.CamelCase}}" class="block text-sm font-medium text-card-foreground">{{.DisplayName}}</label>
{{- if eq .InputType "checkbox"}}
      <input id="{{.CamelCase}}" type="checkbox" bind:checked={$form.{{.CamelCase}}} class="mt-1 border border-border text-primary shadow-sm focus:ring-ring/40" />
{{- else}}
      <input id="{{.CamelCase}}" type="{{.InputType}}" bind:value={$form.{{.CamelCase}}} class="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
{{- end}}
    </div>
{{- end}}
{{- end}}
    <div class="flex justify-end">
      <button type="submit" disabled={$form.processing} class="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50">{$form.processing ? 'Creating...' : 'Create {{.ResourceName}}'}</button>
    </div>
  </form>
</div>
{{- else if eq .ComponentName "Edit"}}
<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-foreground">Edit {{.ResourceName}}</h1>
    <Link href={ {{- InertiaRouteURL "show" "routeID(item)" -}} } class="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Cancel</Link>
  </div>

  <form onsubmit={submit} class="mt-8 space-y-6 overflow-hidden border border-border bg-card p-6 shadow-sm">
{{- range .Fields}}
{{- if not .IsSystemField}}
    <div>
      <label for="{{.CamelCase}}" class="block text-sm font-medium text-card-foreground">{{.DisplayName}}</label>
{{- if eq .InputType "checkbox"}}
      <input id="{{.CamelCase}}" type="checkbox" bind:checked={$form.{{.CamelCase}}} class="mt-1 border border-border text-primary shadow-sm focus:ring-ring/40" />
{{- else}}
      <input id="{{.CamelCase}}" type="{{.InputType}}" bind:value={$form.{{.CamelCase}}} class="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
{{- end}}
    </div>
{{- end}}
{{- end}}
    <div class="flex justify-end gap-3">
      <Link href={ {{- InertiaRouteURL "show" "routeID(item)" -}} } class="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Cancel</Link>
      <button type="submit" disabled={$form.processing} class="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50">{$form.processing ? 'Updating...' : 'Update {{.ResourceName}}'}</button>
    </div>
  </form>
</div>
{{- end}}
