func ({{.ReceiverName}} {{.PluralResourceName}}) Index(etx *echo.Context) error {
	page := int64(1)
	if p := etx.QueryParam("page"); p != "" {
		if parsed, err := strconv.Atoi(p); err == nil && parsed > 0 {
			page = int64(parsed)
		}
	}

	perPage := int64(25)
	if pp := etx.QueryParam("per_page"); pp != "" {
		if parsed, err := strconv.Atoi(pp); err == nil && parsed > 0 &&
			parsed <= 100 {
			perPage = int64(parsed)
		}
	}

	{{.ModelPluralName | ToCamelCase}}List, err := {{.ReceiverName}}.{{.ModelServiceName | ToLowerCamelCase}}.Paginate(
		etx.Request().Context(),
		page,
		perPage,
	)
	if err != nil {
		return etx.JSON(http.StatusInternalServerError, map[string]string{"error": "internal server error"})
	}

	return etx.JSON(http.StatusOK, {{.ModelPluralName | ToCamelCase}}List.{{.ModelCollectionName}})
}

func ({{.ReceiverName}} {{.PluralResourceName}}) Show(etx *echo.Context) error {
{{- if or (not .IDType) (eq .IDType "uuid.UUID") (eq .IDType "pgtype.UUID")}}
	{{.ResourceName | ToLowerCamelCase}}ID, err := uuid.Parse(etx.Param("id"))
	if err != nil {
		return etx.JSON(http.StatusBadRequest, map[string]string{"error": "invalid id"})
	}
{{- else if eq .IDType "int64"}}
	{{.ResourceName | ToLowerCamelCase}}ID, err := strconv.ParseInt(etx.Param("id"), 10, 64)
	if err != nil {
		return etx.JSON(http.StatusBadRequest, map[string]string{"error": "invalid id"})
	}
{{- else if eq .IDType "int32"}}
	parsed, err := strconv.ParseInt(etx.Param("id"), 10, 32)
	if err != nil {
		return etx.JSON(http.StatusBadRequest, map[string]string{"error": "invalid id"})
	}
	{{.ResourceName | ToLowerCamelCase}}ID := int32(parsed)
{{- else if eq .IDType "string"}}
	{{.ResourceName | ToLowerCamelCase}}ID := etx.Param("id")
	if {{.ResourceName | ToLowerCamelCase}}ID == "" {
		return etx.JSON(http.StatusBadRequest, map[string]string{"error": "invalid id"})
	}
{{- end}}

	{{.ResourceName | ToLowerCamelCase}}, err := {{.ReceiverName}}.{{.ModelServiceName | ToLowerCamelCase}}.Find(etx.Request().Context(), {{if eq .IDType "pgtype.UUID"}}pgtype.UUID{Bytes: {{.ResourceName | ToLowerCamelCase}}ID, Valid: true}{{else}}{{.ResourceName | ToLowerCamelCase}}ID{{end}})
	if err != nil {
		return etx.JSON(http.StatusNotFound, map[string]string{"error": "not found"})
	}

	return etx.JSON(http.StatusOK, {{.ResourceName | ToLowerCamelCase}})
}

