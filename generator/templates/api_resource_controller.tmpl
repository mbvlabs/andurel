{{- end}}
{{- $needsTime := false}}
{{- $needsUUID := and $hasIDAction (or (not .IDType) (eq .IDType "uuid.UUID") (eq .IDType "pgtype.UUID"))}}
{{- $needsSQLNull := false}}
{{- $needsPG := eq .IDType "pgtype.UUID"}}
{{- range .Fields}}
{{- if and $hasWrite (not .IsSystemField) (eq .GoFormType "time.Time")}}
	{{- $needsTime = true}}
{{- end}}
{{- if and $hasWrite (not .IsSystemField) (or (eq .GoType "uuid.UUID") (eq .GoType "*uuid.UUID"))}}
	{{- $needsUUID = true}}
{{- end}}
{{- if and $hasWrite (not .IsSystemField) (hasPrefix .GoType "pgtype.")}}
	{{- $needsPG = true}}
{{- end}}
{{- if and $hasWrite (not .IsSystemField) (hasPrefix .GoType "sql.Null")}}
	{{- $needsSQLNull = true}}
{{- end}}
{{- end}}
{{- if $needsTime}}
	"time"
{{- end}}
{{- if $needsSQLNull}}
	"database/sql"
{{- end}}
{{- if $needsUUID}}
