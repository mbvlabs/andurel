import { Link{{if InertiaUsesForm .ComponentName}}, useForm{{end}} } from '@inertiajs/react'
{{- if eq .ComponentName "Index"}}
import type { {{InertiaPayloadType}}, {{.ResourceName}}IndexProps } from '{{InertiaPayloadImportPath}}'
{{- else if eq .ComponentName "Show"}}
import type { {{InertiaPayloadType}}, {{.ResourceName}}ItemProps } from '{{InertiaPayloadImportPath}}'
{{- else if eq .ComponentName "Create"}}
import type { {{InertiaCreateFormPayload}} } from '{{InertiaPayloadImportPath}}'
{{- else if eq .ComponentName "Edit"}}
import type { {{InertiaPayloadType}}, {{.ResourceName}}ItemProps, {{InertiaUpdateFormPayload}} } from '{{InertiaPayloadImportPath}}'
{{- end}}

{{- if InertiaComponentUsesRoutes .ComponentName}}
import { routes } from '{{ InertiaRoutesImportPath }}'
{{- end}}

{{- if InertiaNeedsItem .ComponentName }}
type RouteID = {{ InertiaRouteIDType }}

function routeID(item: {{InertiaPayloadType}}): RouteID {
  return item.{{InertiaIDJSONName}}
}
{{- end}}

{{- if eq .ComponentName "Index"}}
export default function {{.ComponentName}}({ items }: {{.ResourceName}}IndexProps) {
  return (
    <div className="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold text-foreground">{{.ResourceName}}s</h1>
        <Link href={ {{- InertiaRouteURL "new" -}} } className="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">New {{.ResourceName}}</Link>
      </div>

      <div className="mt-8 overflow-hidden border border-border bg-card shadow-sm">
        <table className="min-w-full divide-y divide-border">
          <thead className="bg-background">
            <tr>
{{- range .Fields}}
              <th className="px-6 py-3 text-left text-xs font-medium uppercase text-muted-foreground">{{.DisplayName}}</th>
{{- end}}
              <th className="px-6 py-3 text-right text-xs font-medium uppercase text-muted-foreground">Actions</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-border bg-card">
            {items.map((item) => (
              <tr key={item.{{InertiaIDJSONName}}} className="hover:bg-background">
{{- range .Fields}}
                <td className="whitespace-nowrap px-6 py-4 text-sm text-foreground">{ {{- ReactDisplay . "item" -}} }</td>
{{- end}}
                <td className="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                  <Link href={ {{- InertiaRouteURL "show" "routeID(item)" -}} } className="mr-3 text-ring hover:text-card-foreground">View</Link>
                  <Link href={ {{- InertiaRouteURL "edit" "routeID(item)" -}} } className="mr-3 text-ring hover:text-card-foreground">Edit</Link>
                  <Link href={ {{- InertiaRouteURL "destroy" "routeID(item)" -}} } method="delete" as="button" className="text-destructive hover:text-destructive/80">Delete</Link>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )
}
{{- else if eq .ComponentName "Show"}}
export default function {{.ComponentName}}({ item }: {{.ResourceName}}ItemProps) {
  return (
    <div className="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold text-foreground">{{.ResourceName}} Details</h1>
        <div className="flex gap-3">
          <Link href={ {{- InertiaRouteURL "edit" "routeID(item)" -}} } className="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">Edit</Link>
          <Link href={ {{- InertiaRouteURL "index" -}} } className="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Back</Link>
        </div>
      </div>

      <div className="mt-8 overflow-hidden border border-border bg-card shadow-sm">
        <dl className="divide-y divide-border">
{{- range .Fields}}
          <div className="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
            <dt className="text-sm font-medium text-muted-foreground">{{.DisplayName}}</dt>
            <dd className="mt-1 text-sm text-foreground sm:col-span-2 sm:mt-0">{ {{- ReactDisplay . "item" -}} }</dd>
          </div>
{{- end}}
        </dl>
      </div>
    </div>
  )
}
{{- else if eq .ComponentName "Create"}}
export default function {{.ComponentName}}() {
  const form = useForm<{{InertiaCreateFormPayload}}>({
{{- range .Fields}}
{{- if not .IsSystemField}}
    {{.CamelCase}}: {{ ReactCreateValue . }},
{{- end}}
{{- end}}
  })

  function submit(event: SubmitEvent) {
    event.preventDefault()
    form.post({{ InertiaRouteURL "create" }})
  }

  return (
    <div className="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold text-foreground">New {{.ResourceName}}</h1>
        <Link href={ {{- InertiaRouteURL "index" -}} } className="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Back</Link>
      </div>

      <form onSubmit={(event) => submit(event.nativeEvent as SubmitEvent)} className="mt-8 space-y-6 overflow-hidden border border-border bg-card p-6 shadow-sm">
{{- range .Fields}}
{{- if not .IsSystemField}}
        <div>
          <label htmlFor="{{.CamelCase}}" className="block text-sm font-medium text-card-foreground">{{.DisplayName}}</label>
{{- if eq .InputType "checkbox"}}
          <input id="{{.CamelCase}}" type="checkbox" checked={form.data.{{.CamelCase}}} onChange={(event) => form.setData('{{.CamelCase}}', event.currentTarget.checked)} className="mt-1 border border-border text-primary shadow-sm focus:ring-ring/40" />
{{- else}}
          <input id="{{.CamelCase}}" type="{{.InputType}}" value={form.data.{{.CamelCase}}} onChange={(event) => form.setData('{{.CamelCase}}', {{ ReactInputValue . }})} className="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
{{- end}}
        </div>
{{- end}}
{{- end}}
        <div className="flex justify-end">
          <button type="submit" disabled={form.processing} className="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50">{form.processing ? 'Creating...' : 'Create {{.ResourceName}}'}</button>
        </div>
      </form>
    </div>
  )
}
{{- else if eq .ComponentName "Edit"}}
export default function {{.ComponentName}}({ item }: {{.ResourceName}}ItemProps) {
  const form = useForm<{{InertiaUpdateFormPayload}}>({
{{- range .Fields}}
{{- if not .IsSystemField}}
    {{.CamelCase}}: {{ ReactEditValue . }},
{{- end}}
{{- end}}
  })

  function submit(event: SubmitEvent) {
    event.preventDefault()
    form.put({{ InertiaRouteURL "update" "routeID(item)" }})
  }

  return (
    <div className="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold text-foreground">Edit {{.ResourceName}}</h1>
        <Link href={ {{- InertiaRouteURL "show" "routeID(item)" -}} } className="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Cancel</Link>
      </div>

      <form onSubmit={(event) => submit(event.nativeEvent as SubmitEvent)} className="mt-8 space-y-6 overflow-hidden border border-border bg-card p-6 shadow-sm">
{{- range .Fields}}
{{- if not .IsSystemField}}
        <div>
          <label htmlFor="{{.CamelCase}}" className="block text-sm font-medium text-card-foreground">{{.DisplayName}}</label>
{{- if eq .InputType "checkbox"}}
          <input id="{{.CamelCase}}" type="checkbox" checked={form.data.{{.CamelCase}}} onChange={(event) => form.setData('{{.CamelCase}}', event.currentTarget.checked)} className="mt-1 border border-border text-primary shadow-sm focus:ring-ring/40" />
{{- else}}
          <input id="{{.CamelCase}}" type="{{.InputType}}" value={form.data.{{.CamelCase}}} onChange={(event) => form.setData('{{.CamelCase}}', {{ ReactInputValue . }})} className="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
{{- end}}
        </div>
{{- end}}
{{- end}}
        <div className="flex justify-end gap-3">
          <Link href={ {{- InertiaRouteURL "show" "routeID(item)" -}} } className="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Cancel</Link>
          <button type="submit" disabled={form.processing} className="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50">{form.processing ? 'Updating...' : 'Update {{.ResourceName}}'}</button>
        </div>
      </form>
    </div>
  )
}
{{- end}}
