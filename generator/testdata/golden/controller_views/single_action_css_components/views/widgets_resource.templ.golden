



package views

import (
	"fmt"
	"time"
	
	"testapp/models"
	
	
)

type WidgetData struct {
	Name string
	Quantity int32
	Active bool
	CreatedAt time.Time
	UpdatedAt time.Time
}

func newWidgetData(entity models.Widget) WidgetData {
	return WidgetData{
		Name: entity.Name,
		Quantity: entity.Quantity,
		Active: entity.Active,
		CreatedAt: func() time.Time { if !entity.CreatedAt.Valid { return time.Time{} }; return entity.CreatedAt.Time }(),
		UpdatedAt: func() time.Time { if !entity.UpdatedAt.Valid { return time.Time{} }; return entity.UpdatedAt.Time }(),
	}
}




type WidgetShow struct {
	Item models.Widget
}

func (ws WidgetShow) PageFragment() string {
	return "widget-show-page-fragment"
}

templ (ws WidgetShow) Page() {
	@base() {
		@templ.Fragment(ws.PageFragment()) {
			<main id="widget-show-container" class="flex-1 px-6 py-10">
				<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<h1 class="text-2xl font-semibold tracking-normal text-base-content">Widget Details</h1>
						<div class="flex flex-wrap items-center gap-3">
							
							
						</div>
					</div>
					<div class="card">
						<div class="card-content">
							<div class="grid gap-5 sm:grid-cols-2">
								
								<div class="field">
									<label class="field-label">Name</label>
									<p class="text-sm text-base-content">{ newWidgetData(ws.Item).Name }</p>
								</div>
								<div class="field">
									<label class="field-label">Quantity</label>
									<p class="text-sm text-base-content">{ fmt.Sprintf("%d", newWidgetData(ws.Item).Quantity) }</p>
								</div>
								<div class="field">
									<label class="field-label">Active</label>
									<p class="text-sm text-base-content">{ fmt.Sprintf("%t", newWidgetData(ws.Item).Active) }</p>
								</div>
								<div class="field">
									<label class="field-label">Created At</label>
									<p class="text-sm text-base-content">{ newWidgetData(ws.Item).CreatedAt.String() }</p>
								</div>
								<div class="field">
									<label class="field-label">Updated At</label>
									<p class="text-sm text-base-content">{ newWidgetData(ws.Item).UpdatedAt.String() }</p>
								</div>
								
							</div>
						</div>
					</div>
				</div>
			</main>
		}
	}
}





