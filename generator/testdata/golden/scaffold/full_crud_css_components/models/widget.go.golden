package models

// andurel:table widgets

import (
	"context"
	"errors"
	"testapp/models/internal/queries"
	"time"

	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
)

type Widgets struct {
	queries *queries.Queries
}

func NewWidgets(db storage.Connection) Widgets {
	return Widgets{queries: queries.New(db)}
}

// WithTx returns a copy that runs queries inside tx.
func (w Widgets) WithTx(tx storage.Transaction) Widgets {
	return Widgets{queries: queries.New(tx)}
}

type Widget struct {
	ID        pgtype.UUID        `andurel:"id"`
	Name      string             `andurel:"name"`
	Quantity  int32              `andurel:"quantity"`
	Active    bool               `andurel:"active"`
	CreatedAt pgtype.Timestamptz `andurel:"created_at"`
	UpdatedAt pgtype.Timestamptz `andurel:"updated_at"`
}

func (w Widgets) Find(ctx context.Context, id pgtype.UUID) (Widget, error) {
	entity, err := w.queries.GetWidget[Widget](ctx, id)
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Widget{}, ErrNotFound
		}
		return Widget{}, err
	}

	return entity, nil
}

type CreateWidgetData struct {
	Name     string
	Quantity int32
	Active   bool
}

func (w Widgets) Create(ctx context.Context, data CreateWidgetData) (Widget, error) {
	entity := Widget{
		ID:        pgtype.UUID{Bytes: uuid.New(), Valid: true},
		CreatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		UpdatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		Name:      data.Name,
		Quantity:  data.Quantity,
		Active:    data.Active,
	}

	if err := validation.Validate(&entity); err != nil {
		return Widget{}, errors.Join(ErrDomainValidation, err)
	}

	return w.queries.CreateWidget[Widget](ctx, queries.CreateWidgetParams{
		ID:        entity.ID,
		Name:      entity.Name,
		Quantity:  entity.Quantity,
		Active:    entity.Active,
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
	})
}

type UpdateWidgetData struct {
	ID       pgtype.UUID
	Name     string
	Quantity int32
	Active   bool
}

func (w Widgets) Update(ctx context.Context, data UpdateWidgetData) (Widget, error) {
	entity := Widget{
		ID:        data.ID,
		UpdatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		Name:      data.Name,
		Quantity:  data.Quantity,
		Active:    data.Active,
	}

	if err := validation.Validate(&entity); err != nil {
		return Widget{}, errors.Join(ErrDomainValidation, err)
	}

	row, err := w.queries.UpdateWidget[Widget](ctx, queries.UpdateWidgetParams{
		ID:        entity.ID,
		Name:      entity.Name,
		Quantity:  entity.Quantity,
		Active:    entity.Active,
		UpdatedAt: entity.UpdatedAt,
	})
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Widget{}, ErrNotFound
		}
		return Widget{}, err
	}

	return row, nil
}

func (w Widgets) Destroy(ctx context.Context, id pgtype.UUID) error {
	if err := w.queries.DeleteWidget(ctx, id); err != nil {
		return err
	}

	return nil
}

func (w Widgets) All(ctx context.Context) ([]Widget, error) {
	return w.queries.ListWidgets[Widget](ctx).All()
}

type PaginatedWidgets struct {
	Widgets    []Widget
	TotalCount int64
	Page       int64
	PageSize   int64
	TotalPages int64
}

func (w Widgets) Paginate(ctx context.Context, page, pageSize int64) (PaginatedWidgets, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := w.queries.CountWidgets(ctx)
	if err != nil {
		return PaginatedWidgets{}, err
	}

	entities, err := w.queries.ListWidgets[Widget](ctx).
		Limit(int32(pageSize)).
		Offset(int32(offset)).
		All()
	if err != nil {
		return PaginatedWidgets{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedWidgets{
		Widgets:    entities,
		TotalCount: int64(totalCount),
		Page:       page,
		PageSize:   pageSize,
		TotalPages: totalPages,
	}, nil
}

func (w Widgets) Upsert(ctx context.Context, id pgtype.UUID, data CreateWidgetData) (Widget, error) {
	entity := Widget{
		ID:        id,
		CreatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		UpdatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		Name:      data.Name,
		Quantity:  data.Quantity,
		Active:    data.Active,
	}

	if err := validation.Validate(&entity); err != nil {
		return Widget{}, errors.Join(ErrDomainValidation, err)
	}

	return w.queries.UpsertWidget[Widget](ctx, queries.UpsertWidgetParams{
		ID:        entity.ID,
		Name:      entity.Name,
		Quantity:  entity.Quantity,
		Active:    entity.Active,
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
	})
}
