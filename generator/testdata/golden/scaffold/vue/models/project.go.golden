package models

// andurel:model-mode crud

import (
	"context"
	"database/sql"
	"errors"
	"time"

	"github.com/google/uuid"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
	"github.com/uptrace/bun"
)

type Projects struct {
	db queryDB
}

func NewProjects(db storage.Connection) Projects {
	return Projects{db: db}
}

// WithTx returns a copy that runs queries inside tx.
func (p Projects) WithTx(tx storage.Transaction) Projects {
	return Projects{db: tx}
}

type Project struct {
	bun.BaseModel `bun:"table:projects,alias:projects"`
	ID            uuid.UUID `bun:"id,pk,type:uuid"`
	Title         string    `bun:"title"`
	Status        string    `bun:"status"`
	CreatedAt     time.Time `bun:"created_at"`
	UpdatedAt     time.Time `bun:"updated_at"`
}

func (p Projects) Find(ctx context.Context, id uuid.UUID) (Project, error) {
	var entity Project
	err := p.db.Executor().NewSelect().
		Model(&entity).
		Where("id = ?", id).
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return Project{}, ErrNotFound
		}
		return Project{}, err
	}

	return entity, nil
}

type CreateProjectData struct {
	Title  string
	Status string
}

func (p Projects) Create(ctx context.Context, data CreateProjectData) (Project, error) {
	entity := Project{
		ID:        uuid.New(),
		CreatedAt: time.Now(),
		UpdatedAt: time.Now(),
		Title:     data.Title,
		Status:    data.Status,
	}

	if err := validation.Validate(&entity); err != nil {
		return Project{}, errors.Join(ErrDomainValidation, err)
	}

	if _, err := p.db.Executor().NewInsert().Model(&entity).Exec(ctx); err != nil {
		return Project{}, err
	}

	return entity, nil
}

type UpdateProjectData struct {
	ID     uuid.UUID
	Title  string
	Status string
}

func (p Projects) Update(ctx context.Context, data UpdateProjectData) (Project, error) {
	entity := Project{
		ID:        data.ID,
		UpdatedAt: time.Now(),
		Title:     data.Title,
		Status:    data.Status,
	}

	if err := validation.Validate(&entity); err != nil {
		return Project{}, errors.Join(ErrDomainValidation, err)
	}

	err := p.db.Executor().NewUpdate().
		Model(&entity).
		Column("title").
		Column("status").
		Column("updated_at").
		WherePK().
		Returning("*").
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return Project{}, ErrNotFound
		}
		return Project{}, err
	}

	return entity, nil
}

func (p Projects) Destroy(ctx context.Context, id uuid.UUID) error {
	var entity Project
	err := p.db.Executor().NewDelete().
		Model(&entity).
		Where("id = ?", id).
		Returning("*").
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return ErrNotFound
		}
		return err
	}

	return nil
}

func (p Projects) All(ctx context.Context) ([]Project, error) {
	var entities []Project
	if err := p.db.Executor().NewSelect().
		Model(&entities).
		Scan(ctx); err != nil {
		return nil, err
	}

	return entities, nil
}

type PaginatedProjects struct {
	Projects   []Project
	TotalCount int64
	Page       int64
	PageSize   int64
	TotalPages int64
}

func (p Projects) Paginate(ctx context.Context, page, pageSize int64) (PaginatedProjects, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := p.db.Executor().NewSelect().
		Model(&Project{}).Count(ctx)
	if err != nil {
		return PaginatedProjects{}, err
	}

	entities := make([]Project, 0, int(pageSize))
	if err := p.db.Executor().NewSelect().
		Model(&entities).
		Limit(int(pageSize)).
		Offset(int(offset)).
		Scan(ctx); err != nil {
		return PaginatedProjects{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedProjects{
		Projects:   entities,
		TotalCount: int64(totalCount),
		Page:       page,
		PageSize:   pageSize,
		TotalPages: totalPages,
	}, nil
}

func (p Projects) Upsert(ctx context.Context, id uuid.UUID, data CreateProjectData) (Project, error) {
	entity := Project{
		ID:        id,
		CreatedAt: time.Now(),
		UpdatedAt: time.Now(),
		Title:     data.Title,
		Status:    data.Status,
	}

	if err := validation.Validate(&entity); err != nil {
		return Project{}, errors.Join(ErrDomainValidation, err)
	}

	if err := p.db.Executor().NewInsert().
		Model(&entity).
		On("CONFLICT (id) DO UPDATE").
		Set("title = excluded.title").
		Set("status = excluded.status").
		Returning("*").
		Scan(ctx); err != nil {
		return Project{}, err
	}

	return entity, nil
}
