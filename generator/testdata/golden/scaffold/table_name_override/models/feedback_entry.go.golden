package models

// andurel:model-mode crud

import (
	"context"
	"database/sql"
	"errors"
	"time"

	"github.com/google/uuid"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
	"github.com/uptrace/bun"
)

type FeedbackEntries struct {
	db queryDB
}

func NewFeedbackEntries(db storage.Connection) FeedbackEntries {
	return FeedbackEntries{db: db}
}

// WithTx returns a copy that runs queries inside tx.
func (fe FeedbackEntries) WithTx(tx storage.Transaction) FeedbackEntries {
	return FeedbackEntries{db: tx}
}

type FeedbackEntry struct {
	bun.BaseModel `bun:"table:student_feedback,alias:student_feedback"`
	ID            uuid.UUID     `bun:"id,pk,type:uuid"`
	StudentName   string        `bun:"student_name"`
	Feedback      string        `bun:"feedback"`
	Rating        sql.NullInt32 `bun:"rating"`
	SubmittedAt   sql.NullTime  `bun:"submitted_at"`
	CreatedAt     time.Time     `bun:"created_at"`
	UpdatedAt     time.Time     `bun:"updated_at"`
}

func (fe FeedbackEntries) Find(ctx context.Context, id uuid.UUID) (FeedbackEntry, error) {
	var entity FeedbackEntry
	err := fe.db.Executor().NewSelect().
		Model(&entity).
		Where("id = ?", id).
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return FeedbackEntry{}, ErrNotFound
		}
		return FeedbackEntry{}, err
	}

	return entity, nil
}

type CreateFeedbackEntryData struct {
	StudentName string
	Feedback    string
	Rating      sql.NullInt32
	SubmittedAt sql.NullTime
}

func (fe FeedbackEntries) Create(ctx context.Context, data CreateFeedbackEntryData) (FeedbackEntry, error) {
	entity := FeedbackEntry{
		ID:          uuid.New(),
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		StudentName: data.StudentName,
		Feedback:    data.Feedback,
		Rating:      data.Rating,
		SubmittedAt: data.SubmittedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return FeedbackEntry{}, errors.Join(ErrDomainValidation, err)
	}

	if _, err := fe.db.Executor().NewInsert().Model(&entity).Exec(ctx); err != nil {
		return FeedbackEntry{}, err
	}

	return entity, nil
}

type UpdateFeedbackEntryData struct {
	ID          uuid.UUID
	StudentName string
	Feedback    string
	Rating      sql.NullInt32
	SubmittedAt sql.NullTime
}

func (fe FeedbackEntries) Update(ctx context.Context, data UpdateFeedbackEntryData) (FeedbackEntry, error) {
	entity := FeedbackEntry{
		ID:          data.ID,
		UpdatedAt:   time.Now(),
		StudentName: data.StudentName,
		Feedback:    data.Feedback,
		Rating:      data.Rating,
		SubmittedAt: data.SubmittedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return FeedbackEntry{}, errors.Join(ErrDomainValidation, err)
	}

	err := fe.db.Executor().NewUpdate().
		Model(&entity).
		Column("student_name").
		Column("feedback").
		Column("rating").
		Column("submitted_at").
		Column("updated_at").
		WherePK().
		Returning("*").
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return FeedbackEntry{}, ErrNotFound
		}
		return FeedbackEntry{}, err
	}

	return entity, nil
}

func (fe FeedbackEntries) Destroy(ctx context.Context, id uuid.UUID) error {
	var entity FeedbackEntry
	err := fe.db.Executor().NewDelete().
		Model(&entity).
		Where("id = ?", id).
		Returning("*").
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return ErrNotFound
		}
		return err
	}

	return nil
}

func (fe FeedbackEntries) All(ctx context.Context) ([]FeedbackEntry, error) {
	var entities []FeedbackEntry
	if err := fe.db.Executor().NewSelect().
		Model(&entities).
		Scan(ctx); err != nil {
		return nil, err
	}

	return entities, nil
}

type PaginatedFeedbackEntries struct {
	FeedbackEntries []FeedbackEntry
	TotalCount      int64
	Page            int64
	PageSize        int64
	TotalPages      int64
}

func (fe FeedbackEntries) Paginate(ctx context.Context, page, pageSize int64) (PaginatedFeedbackEntries, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := fe.db.Executor().NewSelect().
		Model(&FeedbackEntry{}).Count(ctx)
	if err != nil {
		return PaginatedFeedbackEntries{}, err
	}

	entities := make([]FeedbackEntry, 0, int(pageSize))
	if err := fe.db.Executor().NewSelect().
		Model(&entities).
		Limit(int(pageSize)).
		Offset(int(offset)).
		Scan(ctx); err != nil {
		return PaginatedFeedbackEntries{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedFeedbackEntries{
		FeedbackEntries: entities,
		TotalCount:      int64(totalCount),
		Page:            page,
		PageSize:        pageSize,
		TotalPages:      totalPages,
	}, nil
}

func (fe FeedbackEntries) Upsert(ctx context.Context, id uuid.UUID, data CreateFeedbackEntryData) (FeedbackEntry, error) {
	entity := FeedbackEntry{
		ID:          id,
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		StudentName: data.StudentName,
		Feedback:    data.Feedback,
		Rating:      data.Rating,
		SubmittedAt: data.SubmittedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return FeedbackEntry{}, errors.Join(ErrDomainValidation, err)
	}

	if err := fe.db.Executor().NewInsert().
		Model(&entity).
		On("CONFLICT (id) DO UPDATE").
		Set("student_name = excluded.student_name").
		Set("feedback = excluded.feedback").
		Set("rating = excluded.rating").
		Set("submitted_at = excluded.submitted_at").
		Returning("*").
		Scan(ctx); err != nil {
		return FeedbackEntry{}, err
	}

	return entity, nil
}
