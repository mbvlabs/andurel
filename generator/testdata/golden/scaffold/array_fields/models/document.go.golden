package models

// andurel:model-mode crud

import (
	"context"
	"database/sql"
	"errors"
	"time"

	"github.com/google/uuid"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
	"github.com/uptrace/bun"
)

type Documents struct {
	db queryDB
}

func NewDocuments(db storage.Connection) Documents {
	return Documents{db: db}
}

// WithTx returns a copy that runs queries inside tx.
func (documents Documents) WithTx(tx storage.Transaction) Documents {
	return Documents{db: tx}
}

type Document struct {
	bun.BaseModel `bun:"table:documents,alias:documents"`
	ID            uuid.UUID `bun:"id,pk,type:uuid"`
	Title         string    `bun:"title"`
	Tags          []string  `bun:"tags,array"`
	PageNumbers   []int32   `bun:"page_numbers,array"`
	ViewCount     int32     `bun:"view_count"`
	IsPublished   bool      `bun:"is_published"`
	CreatedAt     time.Time `bun:"created_at"`
	UpdatedAt     time.Time `bun:"updated_at"`
}

func (documents Documents) Find(ctx context.Context, id uuid.UUID) (Document, error) {
	var entity Document
	err := documents.db.Executor().NewSelect().
		Model(&entity).
		Where("id = ?", id).
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return Document{}, ErrNotFound
		}
		return Document{}, err
	}

	return entity, nil
}

type CreateDocumentData struct {
	Title       string
	Tags        []string
	PageNumbers []int32
	ViewCount   int32
	IsPublished bool
}

func (documents Documents) Create(ctx context.Context, data CreateDocumentData) (Document, error) {
	entity := Document{
		ID:          uuid.New(),
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		Title:       data.Title,
		Tags:        data.Tags,
		PageNumbers: data.PageNumbers,
		ViewCount:   data.ViewCount,
		IsPublished: data.IsPublished,
	}

	if err := validation.Validate(&entity); err != nil {
		return Document{}, errors.Join(ErrDomainValidation, err)
	}

	if _, err := documents.db.Executor().NewInsert().Model(&entity).Exec(ctx); err != nil {
		return Document{}, err
	}

	return entity, nil
}

type UpdateDocumentData struct {
	ID          uuid.UUID
	Title       string
	Tags        []string
	PageNumbers []int32
	ViewCount   int32
	IsPublished bool
}

func (documents Documents) Update(ctx context.Context, data UpdateDocumentData) (Document, error) {
	entity := Document{
		ID:          data.ID,
		UpdatedAt:   time.Now(),
		Title:       data.Title,
		Tags:        data.Tags,
		PageNumbers: data.PageNumbers,
		ViewCount:   data.ViewCount,
		IsPublished: data.IsPublished,
	}

	if err := validation.Validate(&entity); err != nil {
		return Document{}, errors.Join(ErrDomainValidation, err)
	}

	err := documents.db.Executor().NewUpdate().
		Model(&entity).
		Column("title").
		Column("tags").
		Column("page_numbers").
		Column("view_count").
		Column("is_published").
		Column("updated_at").
		WherePK().
		Returning("*").
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return Document{}, ErrNotFound
		}
		return Document{}, err
	}

	return entity, nil
}

func (documents Documents) Destroy(ctx context.Context, id uuid.UUID) error {
	var entity Document
	err := documents.db.Executor().NewDelete().
		Model(&entity).
		Where("id = ?", id).
		Returning("*").
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return ErrNotFound
		}
		return err
	}

	return nil
}

func (documents Documents) All(ctx context.Context) ([]Document, error) {
	var entities []Document
	if err := documents.db.Executor().NewSelect().
		Model(&entities).
		Scan(ctx); err != nil {
		return nil, err
	}

	return entities, nil
}

type PaginatedDocuments struct {
	Documents  []Document
	TotalCount int64
	Page       int64
	PageSize   int64
	TotalPages int64
}

func (documents Documents) Paginate(ctx context.Context, page, pageSize int64) (PaginatedDocuments, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := documents.db.Executor().NewSelect().
		Model(&Document{}).Count(ctx)
	if err != nil {
		return PaginatedDocuments{}, err
	}

	entities := make([]Document, 0, int(pageSize))
	if err := documents.db.Executor().NewSelect().
		Model(&entities).
		Limit(int(pageSize)).
		Offset(int(offset)).
		Scan(ctx); err != nil {
		return PaginatedDocuments{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedDocuments{
		Documents:  entities,
		TotalCount: int64(totalCount),
		Page:       page,
		PageSize:   pageSize,
		TotalPages: totalPages,
	}, nil
}

func (documents Documents) Upsert(ctx context.Context, id uuid.UUID, data CreateDocumentData) (Document, error) {
	entity := Document{
		ID:          id,
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		Title:       data.Title,
		Tags:        data.Tags,
		PageNumbers: data.PageNumbers,
		ViewCount:   data.ViewCount,
		IsPublished: data.IsPublished,
	}

	if err := validation.Validate(&entity); err != nil {
		return Document{}, errors.Join(ErrDomainValidation, err)
	}

	if err := documents.db.Executor().NewInsert().
		Model(&entity).
		On("CONFLICT (id) DO UPDATE").
		Set("title = excluded.title").
		Set("tags = excluded.tags").
		Set("page_numbers = excluded.page_numbers").
		Set("view_count = excluded.view_count").
		Set("is_published = excluded.is_published").
		Returning("*").
		Scan(ctx); err != nil {
		return Document{}, err
	}

	return entity, nil
}
