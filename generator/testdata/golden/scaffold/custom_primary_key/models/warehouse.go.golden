package models

// andurel:table warehouses

import (
	"context"
	"errors"
	"testapp/models/internal/queries"
	"time"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
)

type Warehouses struct {
	queries *queries.Queries
}

func NewWarehouses(db storage.Connection) Warehouses {
	return Warehouses{queries: queries.New(db)}
}

// WithTx returns a copy that runs queries inside tx.
func (w Warehouses) WithTx(tx storage.Transaction) Warehouses {
	return Warehouses{queries: queries.New(tx)}
}

type Warehouse struct {
	Slug      string             `andurel:"slug"`
	Name      string             `andurel:"name"`
	Location  pgtype.Text        `andurel:"location"`
	CreatedAt pgtype.Timestamptz `andurel:"created_at"`
	UpdatedAt pgtype.Timestamptz `andurel:"updated_at"`
}

func (w Warehouses) Find(ctx context.Context, id string) (Warehouse, error) {
	entity, err := w.queries.GetWarehouse[Warehouse](ctx, id)
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Warehouse{}, ErrNotFound
		}
		return Warehouse{}, err
	}

	return entity, nil
}

type CreateWarehouseData struct {
	Name     string
	Location pgtype.Text
	Slug     string
}

func (w Warehouses) Create(ctx context.Context, data CreateWarehouseData) (Warehouse, error) {
	entity := Warehouse{
		Slug:      data.Slug,
		CreatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		UpdatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		Name:      data.Name,
		Location:  data.Location,
	}

	if err := validation.Validate(&entity); err != nil {
		return Warehouse{}, errors.Join(ErrDomainValidation, err)
	}

	return w.queries.CreateWarehouse[Warehouse](ctx, queries.CreateWarehouseParams{
		Slug:      entity.Slug,
		Name:      entity.Name,
		Location:  entity.Location,
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
	})
}

type UpdateWarehouseData struct {
	Slug     string
	Name     string
	Location pgtype.Text
}

func (w Warehouses) Update(ctx context.Context, data UpdateWarehouseData) (Warehouse, error) {
	entity := Warehouse{
		Slug:      data.Slug,
		UpdatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		Name:      data.Name,
		Location:  data.Location,
	}

	if err := validation.Validate(&entity); err != nil {
		return Warehouse{}, errors.Join(ErrDomainValidation, err)
	}

	row, err := w.queries.UpdateWarehouse[Warehouse](ctx, queries.UpdateWarehouseParams{
		Slug:      entity.Slug,
		Name:      entity.Name,
		Location:  entity.Location,
		UpdatedAt: entity.UpdatedAt,
	})
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Warehouse{}, ErrNotFound
		}
		return Warehouse{}, err
	}

	return row, nil
}

func (w Warehouses) Destroy(ctx context.Context, id string) error {
	if err := w.queries.DeleteWarehouse(ctx, id); err != nil {
		return err
	}

	return nil
}

func (w Warehouses) All(ctx context.Context) ([]Warehouse, error) {
	return w.queries.ListWarehouses[Warehouse](ctx).All()
}

type PaginatedWarehouses struct {
	Warehouses []Warehouse
	TotalCount int64
	Page       int64
	PageSize   int64
	TotalPages int64
}

func (w Warehouses) Paginate(ctx context.Context, page, pageSize int64) (PaginatedWarehouses, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := w.queries.CountWarehouses(ctx)
	if err != nil {
		return PaginatedWarehouses{}, err
	}

	entities, err := w.queries.ListWarehouses[Warehouse](ctx).
		Limit(int32(pageSize)).
		Offset(int32(offset)).
		All()
	if err != nil {
		return PaginatedWarehouses{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedWarehouses{
		Warehouses: entities,
		TotalCount: int64(totalCount),
		Page:       page,
		PageSize:   pageSize,
		TotalPages: totalPages,
	}, nil
}

func (w Warehouses) Upsert(ctx context.Context, id string, data CreateWarehouseData) (Warehouse, error) {
	entity := Warehouse{
		Slug:      id,
		CreatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		UpdatedAt: pgtype.Timestamptz{Time: time.Now(), Valid: true},
		Name:      data.Name,
		Location:  data.Location,
	}

	if err := validation.Validate(&entity); err != nil {
		return Warehouse{}, errors.Join(ErrDomainValidation, err)
	}

	return w.queries.UpsertWarehouse[Warehouse](ctx, queries.UpsertWarehouseParams{
		Slug:      entity.Slug,
		Name:      entity.Name,
		Location:  entity.Location,
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
	})
}
