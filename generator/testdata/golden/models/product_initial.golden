package models

// andurel:model-mode crud
// andurel:table products

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"time"

	"github.com/example/shop/models/internal/queries"
	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
)

type Products struct {
	queries *queries.Queries
}

func NewProducts(db storage.Connection) Products {
	return Products{queries: queries.New(db)}
}

// WithTx returns a copy that runs queries inside tx.
func (p Products) WithTx(tx storage.Transaction) Products {
	return Products{queries: queries.New(tx)}
}

type Product struct {
	ID          uuid.UUID       `andurel:"id"`
	Sku         string          `andurel:"sku"`
	Name        string          `andurel:"name"`
	Description sql.NullString  `andurel:"description"`
	PriceCents  int32           `andurel:"price_cents"`
	StockCount  int32           `andurel:"stock_count"`
	Active      bool            `andurel:"active"`
	Tags        []string        `andurel:"tags"`
	Scores      []int32         `andurel:"scores"`
	Metadata    json.RawMessage `andurel:"metadata"`
	Attributes  json.RawMessage `andurel:"attributes"`
	LaunchedAt  sql.NullTime    `andurel:"launched_at"`
	CreatedAt   time.Time       `andurel:"created_at"`
	UpdatedAt   time.Time       `andurel:"updated_at"`
}

func (p Products) Find(ctx context.Context, id uuid.UUID) (Product, error) {
	entity, err := p.queries.GetProduct[Product](ctx, id)
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Product{}, ErrNotFound
		}
		return Product{}, err
	}

	return entity, nil
}

type CreateProductData struct {
	Sku         string
	Name        string
	Description sql.NullString
	PriceCents  int32
	StockCount  int32
	Active      bool
	Tags        []string
	Scores      []int32
	Metadata    json.RawMessage
	Attributes  json.RawMessage
	LaunchedAt  sql.NullTime
}

func (p Products) Create(ctx context.Context, data CreateProductData) (Product, error) {
	entity := Product{
		ID:          uuid.New(),
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		Sku:         data.Sku,
		Name:        data.Name,
		Description: data.Description,
		PriceCents:  data.PriceCents,
		StockCount:  data.StockCount,
		Active:      data.Active,
		Tags:        data.Tags,
		Scores:      data.Scores,
		Metadata:    data.Metadata,
		Attributes:  data.Attributes,
		LaunchedAt:  data.LaunchedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Product{}, errors.Join(ErrDomainValidation, err)
	}

	return p.Insert(ctx, entity)
}

func (p Products) Insert(ctx context.Context, entity Product) (Product, error) {
	return p.queries.CreateProduct[Product](ctx, queries.CreateProductParams{
		ID:          entity.ID,
		Sku:         entity.Sku,
		Name:        entity.Name,
		Description: entity.Description,
		PriceCents:  entity.PriceCents,
		StockCount:  entity.StockCount,
		Active:      entity.Active,
		Tags:        entity.Tags,
		Scores:      entity.Scores,
		Metadata:    entity.Metadata,
		Attributes:  entity.Attributes,
		LaunchedAt:  entity.LaunchedAt,
		CreatedAt:   entity.CreatedAt,
		UpdatedAt:   entity.UpdatedAt,
	})
}

type UpdateProductData struct {
	ID          uuid.UUID
	Sku         string
	Name        string
	Description sql.NullString
	PriceCents  int32
	StockCount  int32
	Active      bool
	Tags        []string
	Scores      []int32
	Metadata    json.RawMessage
	Attributes  json.RawMessage
	LaunchedAt  sql.NullTime
}

func (p Products) Update(ctx context.Context, data UpdateProductData) (Product, error) {
	entity := Product{
		ID:          data.ID,
		UpdatedAt:   time.Now(),
		Sku:         data.Sku,
		Name:        data.Name,
		Description: data.Description,
		PriceCents:  data.PriceCents,
		StockCount:  data.StockCount,
		Active:      data.Active,
		Tags:        data.Tags,
		Scores:      data.Scores,
		Metadata:    data.Metadata,
		Attributes:  data.Attributes,
		LaunchedAt:  data.LaunchedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Product{}, errors.Join(ErrDomainValidation, err)
	}

	row, err := p.queries.UpdateProduct[Product](ctx, queries.UpdateProductParams{
		ID:          entity.ID,
		Sku:         entity.Sku,
		Name:        entity.Name,
		Description: entity.Description,
		PriceCents:  entity.PriceCents,
		StockCount:  entity.StockCount,
		Active:      entity.Active,
		Tags:        entity.Tags,
		Scores:      entity.Scores,
		Metadata:    entity.Metadata,
		Attributes:  entity.Attributes,
		LaunchedAt:  entity.LaunchedAt,
		UpdatedAt:   entity.UpdatedAt,
	})
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Product{}, ErrNotFound
		}
		return Product{}, err
	}

	return row, nil
}

func (p Products) Destroy(ctx context.Context, id uuid.UUID) error {
	if err := p.queries.DeleteProduct(ctx, id); err != nil {
		return err
	}

	return nil
}

func (p Products) All(ctx context.Context) ([]Product, error) {
	return p.queries.ListProducts[Product](ctx)
}

type PaginatedProducts struct {
	Products   []Product
	TotalCount int64
	Page       int64
	PageSize   int64
	TotalPages int64
}

func (p Products) Paginate(ctx context.Context, page, pageSize int64) (PaginatedProducts, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := p.queries.CountProducts(ctx)
	if err != nil {
		return PaginatedProducts{}, err
	}

	entities, err := p.queries.ListProductsPaginated[Product](ctx, queries.ListProductsPaginatedParams{
		PageSize:   int32(pageSize),
		PageOffset: int32(offset),
	})
	if err != nil {
		return PaginatedProducts{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedProducts{
		Products:   entities,
		TotalCount: int64(totalCount),
		Page:       page,
		PageSize:   pageSize,
		TotalPages: totalPages,
	}, nil
}

func (p Products) Upsert(ctx context.Context, id uuid.UUID, data CreateProductData) (Product, error) {
	entity := Product{
		ID:          id,
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		Sku:         data.Sku,
		Name:        data.Name,
		Description: data.Description,
		PriceCents:  data.PriceCents,
		StockCount:  data.StockCount,
		Active:      data.Active,
		Tags:        data.Tags,
		Scores:      data.Scores,
		Metadata:    data.Metadata,
		Attributes:  data.Attributes,
		LaunchedAt:  data.LaunchedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Product{}, errors.Join(ErrDomainValidation, err)
	}

	return p.queries.UpsertProduct[Product](ctx, queries.UpsertProductParams{
		ID:          entity.ID,
		Sku:         entity.Sku,
		Name:        entity.Name,
		Description: entity.Description,
		PriceCents:  entity.PriceCents,
		StockCount:  entity.StockCount,
		Active:      entity.Active,
		Tags:        entity.Tags,
		Scores:      entity.Scores,
		Metadata:    entity.Metadata,
		Attributes:  entity.Attributes,
		LaunchedAt:  entity.LaunchedAt,
		CreatedAt:   entity.CreatedAt,
		UpdatedAt:   entity.UpdatedAt,
	})
}
