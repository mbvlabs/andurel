package models

// andurel:model-mode crud

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"time"

	"github.com/google/uuid"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
	"github.com/uptrace/bun"
)

type Products struct {
	db queryDB
}

func NewProducts(db storage.Connection) Products {
	return Products{db: db}
}

// WithTx returns a copy that runs queries inside tx.
func (p Products) WithTx(tx storage.Transaction) Products {
	return Products{db: tx}
}

type Product struct {
	bun.BaseModel `bun:"table:products,alias:products"`

	ID          uuid.UUID       `bun:"id,pk,type:uuid"`
	Sku         string          `bun:"sku"`
	Name        string          `bun:"name"`
	Description string          `bun:"description"`
	PriceCents  int64           `bun:"price_cents"`
	Active      bool            `bun:"active"`
	Tags        []string        `bun:"tags,array"`
	Scores      []int32         `bun:"scores,array"`
	Metadata    json.RawMessage `bun:"metadata,type:jsonb"`
	Attributes  json.RawMessage `bun:"attributes,type:json"`
	LaunchedAt  sql.NullTime    `bun:"launched_at"`
	CreatedAt   time.Time       `bun:"created_at"`
	UpdatedAt   time.Time       `bun:"updated_at"`
	ArchivedAt  sql.NullTime    `bun:"archived_at"`
	Rating      float64         `bun:"rating"`
}

func (p Products) Find(ctx context.Context, id uuid.UUID) (Product, error) {
	var entity Product
	err := p.db.Executor().NewSelect().
		Model(&entity).
		Where("id = ?", id).
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return Product{}, ErrNotFound
		}
		return Product{}, err
	}

	return entity, nil
}

type CreateProductData struct {
	Sku         string
	Name        string
	Description sql.NullString
	PriceCents  int32
	StockCount  int32
	Active      bool
	Tags        []string
	Scores      []int32
	Metadata    json.RawMessage
	Attributes  json.RawMessage
	LaunchedAt  sql.NullTime
}

func (p Products) Create(ctx context.Context, data CreateProductData) (Product, error) {
	entity := Product{
		ID:          uuid.New(),
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		Sku:         data.Sku,
		Name:        data.Name,
		Description: data.Description,
		PriceCents:  data.PriceCents,
		StockCount:  data.StockCount,
		Active:      data.Active,
		Tags:        data.Tags,
		Scores:      data.Scores,
		Metadata:    data.Metadata,
		Attributes:  data.Attributes,
		LaunchedAt:  data.LaunchedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Product{}, errors.Join(ErrDomainValidation, err)
	}

	if _, err := p.db.Executor().NewInsert().Model(&entity).Exec(ctx); err != nil {
		return Product{}, err
	}

	return entity, nil
}

type UpdateProductData struct {
	ID          uuid.UUID
	Sku         string
	Name        string
	Description sql.NullString
	PriceCents  int32
	StockCount  int32
	Active      bool
	Tags        []string
	Scores      []int32
	Metadata    json.RawMessage
	Attributes  json.RawMessage
	LaunchedAt  sql.NullTime
}

func (p Products) Update(ctx context.Context, data UpdateProductData) (Product, error) {
	entity := Product{
		ID:          data.ID,
		UpdatedAt:   time.Now(),
		Sku:         data.Sku,
		Name:        data.Name,
		Description: data.Description,
		PriceCents:  data.PriceCents,
		StockCount:  data.StockCount,
		Active:      data.Active,
		Tags:        data.Tags,
		Scores:      data.Scores,
		Metadata:    data.Metadata,
		Attributes:  data.Attributes,
		LaunchedAt:  data.LaunchedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Product{}, errors.Join(ErrDomainValidation, err)
	}

	err := p.db.Executor().NewUpdate().
		Model(&entity).
		Column("sku").
		Column("name").
		Column("description").
		Column("price_cents").
		Column("stock_count").
		Column("active").
		Column("tags").
		Column("scores").
		Column("metadata").
		Column("attributes").
		Column("launched_at").
		Column("updated_at").
		WherePK().
		Returning("*").
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return Product{}, ErrNotFound
		}
		return Product{}, err
	}

	return entity, nil
}

func (p Products) Destroy(ctx context.Context, id uuid.UUID) error {
	var entity Product
	err := p.db.Executor().NewDelete().
		Model(&entity).
		Where("id = ?", id).
		Returning("*").
		Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return ErrNotFound
		}
		return err
	}

	return nil
}

func (p Products) All(ctx context.Context) ([]Product, error) {
	var entities []Product
	if err := p.db.Executor().NewSelect().
		Model(&entities).
		Scan(ctx); err != nil {
		return nil, err
	}

	return entities, nil
}

type PaginatedProducts struct {
	Products   []Product
	TotalCount int64
	Page       int64
	PageSize   int64
	TotalPages int64
}

func (p Products) Paginate(ctx context.Context, page, pageSize int64) (PaginatedProducts, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := p.db.Executor().NewSelect().
		Model(&Product{}).Count(ctx)
	if err != nil {
		return PaginatedProducts{}, err
	}

	entities := make([]Product, 0, int(pageSize))
	if err := p.db.Executor().NewSelect().
		Model(&entities).
		Limit(int(pageSize)).
		Offset(int(offset)).
		Scan(ctx); err != nil {
		return PaginatedProducts{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedProducts{
		Products:   entities,
		TotalCount: int64(totalCount),
		Page:       page,
		PageSize:   pageSize,
		TotalPages: totalPages,
	}, nil
}

func (p Products) Upsert(ctx context.Context, id uuid.UUID, data CreateProductData) (Product, error) {
	entity := Product{
		ID:          id,
		CreatedAt:   time.Now(),
		UpdatedAt:   time.Now(),
		Sku:         data.Sku,
		Name:        data.Name,
		Description: data.Description,
		PriceCents:  data.PriceCents,
		StockCount:  data.StockCount,
		Active:      data.Active,
		Tags:        data.Tags,
		Scores:      data.Scores,
		Metadata:    data.Metadata,
		Attributes:  data.Attributes,
		LaunchedAt:  data.LaunchedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Product{}, errors.Join(ErrDomainValidation, err)
	}

	if err := p.db.Executor().NewInsert().
		Model(&entity).
		On("CONFLICT (id) DO UPDATE").
		Set("sku = excluded.sku").
		Set("name = excluded.name").
		Set("description = excluded.description").
		Set("price_cents = excluded.price_cents").
		Set("stock_count = excluded.stock_count").
		Set("active = excluded.active").
		Set("tags = excluded.tags").
		Set("scores = excluded.scores").
		Set("metadata = excluded.metadata").
		Set("attributes = excluded.attributes").
		Set("launched_at = excluded.launched_at").
		Returning("*").
		Scan(ctx); err != nil {
		return Product{}, err
	}

	return entity, nil
}
