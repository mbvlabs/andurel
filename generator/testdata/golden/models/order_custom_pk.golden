package models

// andurel:table orders

import (
	"context"
	"errors"
	"time"

	"github.com/example/shop/models/internal/queries"
	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
)

type Orders struct {
	queries *queries.Queries
}

func NewOrders(db storage.Connection) Orders {
	return Orders{queries: queries.New(db)}
}

// WithTx returns a copy that runs queries inside tx.
func (o Orders) WithTx(tx storage.Transaction) Orders {
	return Orders{queries: queries.New(tx)}
}

type Order struct {
	OrderId    pgtype.UUID        `andurel:"order_id"`
	CustomerId pgtype.UUID        `andurel:"customer_id"`
	Reference  string             `andurel:"reference"`
	TotalCents int64              `andurel:"total_cents"`
	Status     string             `andurel:"status"`
	PlacedAt   pgtype.Timestamptz `andurel:"placed_at"`
	CreatedAt  pgtype.Timestamptz `andurel:"created_at"`
	UpdatedAt  pgtype.Timestamptz `andurel:"updated_at"`
}

func (o Orders) Find(ctx context.Context, id pgtype.UUID) (Order, error) {
	entity, err := o.queries.GetOrder[Order](ctx, id)
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Order{}, ErrNotFound
		}
		return Order{}, err
	}

	return entity, nil
}

type CreateOrderData struct {
	CustomerId pgtype.UUID
	Reference  string
	TotalCents int64
	Status     string
	PlacedAt   pgtype.Timestamptz
}

func (o Orders) Create(ctx context.Context, data CreateOrderData) (Order, error) {
	entity := Order{
		OrderId:    pgtype.UUID{Bytes: uuid.New(), Valid: true},
		CreatedAt:  pgtype.Timestamptz{Time: time.Now(), Valid: true},
		UpdatedAt:  pgtype.Timestamptz{Time: time.Now(), Valid: true},
		CustomerId: data.CustomerId,
		Reference:  data.Reference,
		TotalCents: data.TotalCents,
		Status:     data.Status,
		PlacedAt:   data.PlacedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Order{}, errors.Join(ErrDomainValidation, err)
	}

	return o.queries.CreateOrder[Order](ctx, queries.CreateOrderParams{
		OrderId:    entity.OrderId,
		CustomerId: entity.CustomerId,
		Reference:  entity.Reference,
		TotalCents: entity.TotalCents,
		Status:     entity.Status,
		PlacedAt:   entity.PlacedAt,
		CreatedAt:  entity.CreatedAt,
		UpdatedAt:  entity.UpdatedAt,
	})
}

type UpdateOrderData struct {
	OrderId    pgtype.UUID
	CustomerId pgtype.UUID
	Reference  string
	TotalCents int64
	Status     string
	PlacedAt   pgtype.Timestamptz
}

func (o Orders) Update(ctx context.Context, data UpdateOrderData) (Order, error) {
	entity := Order{
		OrderId:    data.OrderId,
		UpdatedAt:  pgtype.Timestamptz{Time: time.Now(), Valid: true},
		CustomerId: data.CustomerId,
		Reference:  data.Reference,
		TotalCents: data.TotalCents,
		Status:     data.Status,
		PlacedAt:   data.PlacedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Order{}, errors.Join(ErrDomainValidation, err)
	}

	row, err := o.queries.UpdateOrder[Order](ctx, queries.UpdateOrderParams{
		OrderId:    entity.OrderId,
		CustomerId: entity.CustomerId,
		Reference:  entity.Reference,
		TotalCents: entity.TotalCents,
		Status:     entity.Status,
		PlacedAt:   entity.PlacedAt,
		UpdatedAt:  entity.UpdatedAt,
	})
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return Order{}, ErrNotFound
		}
		return Order{}, err
	}

	return row, nil
}

func (o Orders) Destroy(ctx context.Context, id pgtype.UUID) error {
	if err := o.queries.DeleteOrder(ctx, id); err != nil {
		return err
	}

	return nil
}

func (o Orders) All(ctx context.Context) ([]Order, error) {
	return o.queries.ListOrders[Order](ctx).All()
}

type PaginatedOrders struct {
	Orders     []Order
	TotalCount int64
	Page       int64
	PageSize   int64
	TotalPages int64
}

func (o Orders) Paginate(ctx context.Context, page, pageSize int64) (PaginatedOrders, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := o.queries.CountOrders(ctx)
	if err != nil {
		return PaginatedOrders{}, err
	}

	entities, err := o.queries.ListOrders[Order](ctx).
		Limit(int32(pageSize)).
		Offset(int32(offset)).
		All()
	if err != nil {
		return PaginatedOrders{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedOrders{
		Orders:     entities,
		TotalCount: int64(totalCount),
		Page:       page,
		PageSize:   pageSize,
		TotalPages: totalPages,
	}, nil
}

func (o Orders) Upsert(ctx context.Context, id pgtype.UUID, data CreateOrderData) (Order, error) {
	entity := Order{
		OrderId:    id,
		CreatedAt:  pgtype.Timestamptz{Time: time.Now(), Valid: true},
		UpdatedAt:  pgtype.Timestamptz{Time: time.Now(), Valid: true},
		CustomerId: data.CustomerId,
		Reference:  data.Reference,
		TotalCents: data.TotalCents,
		Status:     data.Status,
		PlacedAt:   data.PlacedAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return Order{}, errors.Join(ErrDomainValidation, err)
	}

	return o.queries.UpsertOrder[Order](ctx, queries.UpsertOrderParams{
		OrderId:    entity.OrderId,
		CustomerId: entity.CustomerId,
		Reference:  entity.Reference,
		TotalCents: entity.TotalCents,
		Status:     entity.Status,
		PlacedAt:   entity.PlacedAt,
		CreatedAt:  entity.CreatedAt,
		UpdatedAt:  entity.UpdatedAt,
	})
}
