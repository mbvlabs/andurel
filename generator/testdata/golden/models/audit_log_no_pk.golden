package models

// andurel:model-mode crud
// andurel:table audit_logs

import (
	"context"
	"errors"

	"github.com/example/shop/models/internal/queries"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
)

type AuditLogs struct {
	queries *queries.Queries
}

func NewAuditLogs(db storage.Connection) AuditLogs {
	return AuditLogs{queries: queries.New(db)}
}

// WithTx returns a copy that runs queries inside tx.
func (al AuditLogs) WithTx(tx storage.Transaction) AuditLogs {
	return AuditLogs{queries: queries.New(tx)}
}

type AuditLog struct {
	EventId    pgtype.UUID        `andurel:"event_id"`
	Action     string             `andurel:"action"`
	EntityType string             `andurel:"entity_type"`
	EntityId   pgtype.UUID        `andurel:"entity_id"`
	Payload    []byte             `andurel:"payload"`
	OccurredAt pgtype.Timestamptz `andurel:"occurred_at"`
}

type CreateAuditLogData struct {
	EventId    pgtype.UUID
	Action     string
	EntityType string
	EntityId   pgtype.UUID
	Payload    []byte
	OccurredAt pgtype.Timestamptz
}

func (al AuditLogs) Create(ctx context.Context, data CreateAuditLogData) (AuditLog, error) {
	entity := AuditLog{
		EventId:    data.EventId,
		Action:     data.Action,
		EntityType: data.EntityType,
		EntityId:   data.EntityId,
		Payload:    data.Payload,
		OccurredAt: data.OccurredAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return AuditLog{}, errors.Join(ErrDomainValidation, err)
	}

	return al.queries.CreateAuditLog[AuditLog](ctx, queries.CreateAuditLogParams{
		EventId:    entity.EventId,
		Action:     entity.Action,
		EntityType: entity.EntityType,
		EntityId:   entity.EntityId,
		Payload:    entity.Payload,
		OccurredAt: entity.OccurredAt,
	})
}

func (al AuditLogs) All(ctx context.Context) ([]AuditLog, error) {
	return al.queries.ListAuditLogs[AuditLog](ctx).All()
}

type PaginatedAuditLogs struct {
	AuditLogs  []AuditLog
	TotalCount int64
	Page       int64
	PageSize   int64
	TotalPages int64
}

func (al AuditLogs) Paginate(ctx context.Context, page, pageSize int64) (PaginatedAuditLogs, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := al.queries.CountAuditLogs(ctx)
	if err != nil {
		return PaginatedAuditLogs{}, err
	}

	entities, err := al.queries.ListAuditLogs[AuditLog](ctx).
		Limit(int32(pageSize)).
		Offset(int32(offset)).
		All()
	if err != nil {
		return PaginatedAuditLogs{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedAuditLogs{
		AuditLogs:  entities,
		TotalCount: int64(totalCount),
		Page:       page,
		PageSize:   pageSize,
		TotalPages: totalPages,
	}, nil
}
