package models

// andurel:table event_metrics

import (
	"context"
	"errors"

	"github.com/example/shop/models/internal/queries"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
)

type EventMetrics struct {
	queries *queries.Queries
}

func NewEventMetrics(db storage.Connection) EventMetrics {
	return EventMetrics{queries: queries.New(db)}
}

// WithTx returns a copy that runs queries inside tx.
func (em EventMetrics) WithTx(tx storage.Transaction) EventMetrics {
	return EventMetrics{queries: queries.New(tx)}
}

type EventMetric struct {
	Action     string             `andurel:"action"`
	EntityType string             `andurel:"entity_type"`
	EventCount int32              `andurel:"event_count"`
	Successful bool               `andurel:"successful"`
	OccurredAt pgtype.Timestamptz `andurel:"occurred_at"`
}

type CreateEventMetricData struct {
	Action     string
	EntityType string
	EventCount int32
	Successful bool
	OccurredAt pgtype.Timestamptz
}

func (em EventMetrics) Create(ctx context.Context, data CreateEventMetricData) (EventMetric, error) {
	entity := EventMetric{
		Action:     data.Action,
		EntityType: data.EntityType,
		EventCount: data.EventCount,
		Successful: data.Successful,
		OccurredAt: data.OccurredAt,
	}

	if err := validation.Validate(&entity); err != nil {
		return EventMetric{}, errors.Join(ErrDomainValidation, err)
	}

	return em.queries.CreateEventMetric[EventMetric](ctx, queries.CreateEventMetricParams{
		Action:     entity.Action,
		EntityType: entity.EntityType,
		EventCount: entity.EventCount,
		Successful: entity.Successful,
		OccurredAt: entity.OccurredAt,
	})
}

func (em EventMetrics) All(ctx context.Context) ([]EventMetric, error) {
	return em.queries.ListEventMetrics[EventMetric](ctx).All()
}

type PaginatedEventMetrics struct {
	EventMetrics []EventMetric
	TotalCount   int64
	Page         int64
	PageSize     int64
	TotalPages   int64
}

func (em EventMetrics) Paginate(ctx context.Context, page, pageSize int64) (PaginatedEventMetrics, error) {
	if page < 1 {
		page = 1
	}
	if pageSize < 1 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100
	}

	offset := (page - 1) * pageSize

	totalCount, err := em.queries.CountEventMetrics(ctx)
	if err != nil {
		return PaginatedEventMetrics{}, err
	}

	entities, err := em.queries.ListEventMetrics[EventMetric](ctx).
		Limit(int32(pageSize)).
		Offset(int32(offset)).
		All()
	if err != nil {
		return PaginatedEventMetrics{}, err
	}

	totalPages := (int64(totalCount) + pageSize - 1) / pageSize

	return PaginatedEventMetrics{
		EventMetrics: entities,
		TotalCount:   int64(totalCount),
		Page:         page,
		PageSize:     pageSize,
		TotalPages:   totalPages,
	}, nil
}
