package auth

import (
	"context"
	"net/http"

	"{{.ModuleName}}/routes"
	"{{.ModuleName}}/services"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/telemetry"
)

func (h Handler) PasswordNew(ctx context.Context) error {
	return h.renderer.Page(ctx, "Auth/ResetPasswordRequest", inertia.Props{}).Render()
}

func (h Handler) PasswordCreate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "reset_passwords.create")
	defer span.End()

	var payload struct {
		Email string `json:"email"`
	}

	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		telemetry.Error(
			ctx,
			"could not parse password reset request payload",
			"error",
			err,
		)

		return h.renderer.Page(ctx, "Errors/BadRequest", inertia.Props{}).Render()
	}

	if err := h.identity.RequestResetPassword(
		ctx,
		services.RequestResetPasswordData{
			Email: payload.Email,
		},
	); err != nil {
		if fields, ok := validationFields(err); ok {
			return h.renderer.Page(
				ctx,
				"Auth/ResetPasswordRequest",
				inertia.Props{},
			).ValidationErrors(fields).Render()
		}

		telemetry.Error(
			ctx,
			"failed to request password reset",
			"error",
			err,
		)

		return h.renderer.Redirect(ctx, routes.PasswordNew.URL(), http.StatusSeeOther)
	}

	return h.renderer.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
}

func (h Handler) PasswordEdit(ctx context.Context) error {
	anduin.SetHeader(ctx, "Referrer-Policy", "strict-origin")

	token := anduin.PathValue(ctx, "token")
	if token == "" {
		return h.renderer.Redirect(ctx, routes.PasswordNew.URL(), http.StatusSeeOther)
	}

	return h.renderer.Page(ctx, "Auth/ResetPassword", inertia.Props{
		"token": token,
	}).Render()
}

func (h Handler) PasswordUpdate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "reset_passwords.update")
	defer span.End()

	var payload struct {
		Token           string `json:"resetPasswordToken"`
		Password        string `json:"password"`
		ConfirmPassword string `json:"confirmPassword"`
	}

	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		telemetry.Error(
			ctx,
			"could not parse password reset payload",
			"error",
			err,
		)
		return h.renderer.Page(ctx, "Errors/BadRequest", inertia.Props{}).Render()
	}

	if err := h.identity.ResetPassword(
		ctx,
		services.ResetPasswordData{
			Token:           payload.Token,
			Password:        payload.Password,
			ConfirmPassword: payload.ConfirmPassword,
		},
	); err != nil {
		if fields, ok := validationFields(err); ok {
			return h.renderer.Page(
				ctx,
				"Auth/ResetPassword",
				inertia.Props{"token": payload.Token},
			).ValidationErrors(fields).Render()
		}

		telemetry.Error(
			ctx,
			"failed to reset password",
			"error",
			err,
		)

		return h.renderer.Redirect(
			ctx,
			routes.PasswordEdit.URL(payload.Token),
			http.StatusSeeOther,
		)
	}

	return h.renderer.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
}
