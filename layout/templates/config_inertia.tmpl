package config

import (
	"time"

	"{{.ModuleName}}/application"
	"{{.ModuleName}}/assets"
	"{{.ModuleName}}/router/routes"
	"{{.ModuleName}}/views"

	"github.com/caarlos0/env/v11"
	"github.com/mbvlabs/andurel/pkg/inertia"
	"go.uber.org/fx"
)

// inertiaCfg contains environment-backed Inertia and SSR settings.
type inertiaCfg struct {
	ContainerID         string          `env:"INERTIA_CONTAINER_ID" envDefault:"app"`
	ViteDevURL          string          `env:"INERTIA_VITE_DEV_URL" envDefault:"http://localhost:5173/assets/dist"`
	ProtocolDebug       bool            `env:"INERTIA_PROTOCOL_DEBUG" envDefault:"false"`
	SSRMode             inertia.SSRMode `env:"INERTIA_SSR_MODE" envDefault:"disabled"`
	SSRRuntime          string          `env:"INERTIA_SSR_RUNTIME" envDefault:"node"`
	SSRBundle           string          `env:"INERTIA_SSR_BUNDLE" envDefault:"assets/dist/ssr/ssr.js"`
	SSRURL              string          `env:"INERTIA_SSR_URL" envDefault:"http://127.0.0.1:13714"`
	SSRStartupTimeout   time.Duration   `env:"INERTIA_SSR_STARTUP_TIMEOUT" envDefault:"10s"`
	SSRRequestTimeout   time.Duration   `env:"INERTIA_SSR_REQUEST_TIMEOUT" envDefault:"2s"`
	SSRMaxResponseBytes int64           `env:"INERTIA_SSR_MAX_RESPONSE_BYTES" envDefault:"2097152"`
	SSRFailFast         bool            `env:"INERTIA_SSR_FAIL_FAST" envDefault:"false"`
}

func newInertiaConfig() inertiaCfg {
	cfg := inertiaCfg{}
	if err := env.ParseWithOptions(&cfg, env.Options{RequiredIfNoDef: true}); err != nil {
		panic(err)
	}
	return cfg
}

func newInertia(lifecycle fx.Lifecycle, cfg Config, metadata application.Metadata) (*inertia.Renderer, error) {
	renderer, err := inertia.New(
		inertia.WithRoot(views.Root),
		inertia.WithAssetFS(assets.Files),
		inertia.WithProjectName(metadata.ProjectName),
		inertia.WithEnvironment(metadata.Environment),
		inertia.WithBuildPathURL(routes.ViteBuild.Path()),
{{- if eq .Inertia "react"}}
		inertia.WithEntryPoint("resources/js/app.tsx"),
{{- else}}
		inertia.WithEntryPoint("resources/js/app.ts"),
{{- end}}
		inertia.WithContainerID(cfg.Inertia.ContainerID),
		inertia.WithViteDevURL(cfg.Inertia.ViteDevURL),
		inertia.WithProtocolDebug(cfg.Inertia.ProtocolDebug),
		inertia.WithShared(inertia.Props{"appVersion": metadata.Version}),
		inertia.WithSSRMode(cfg.Inertia.SSRMode),
		inertia.WithSSRRuntime(cfg.Inertia.SSRRuntime),
		inertia.WithSSRBundle(cfg.Inertia.SSRBundle),
		inertia.WithSSRURL(cfg.Inertia.SSRURL),
		inertia.WithSSRStartupTimeout(cfg.Inertia.SSRStartupTimeout),
		inertia.WithSSRRequestTimeout(cfg.Inertia.SSRRequestTimeout),
		inertia.WithSSRMaxResponseBytes(cfg.Inertia.SSRMaxResponseBytes),
		inertia.WithSSRFailFast(cfg.Inertia.SSRFailFast),
	)
	if err != nil {
		return nil, err
	}

	lifecycle.Append(fx.Hook{
		OnStart: renderer.Start,
		OnStop:  renderer.Shutdown,
	})
	return renderer, nil
}

// InertiaModule provides the renderer and wires its managed SSR lifecycle.
var InertiaModule = fx.Module(
	"inertia",
	fx.Provide(newInertia),
)
