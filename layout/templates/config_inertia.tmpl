package config

import "time"

// InertiaCfg contains Inertia and SSR settings.
type InertiaCfg struct {
	ContainerID         string
	ViteDevURL          string
	ProtocolDebug       bool
	SSRMode             string
	SSRRuntime          string
	SSRBundle           string
	SSRURL              string
	SSRStartupTimeout   time.Duration
	SSRRequestTimeout   time.Duration
	SSRMaxResponseBytes int64
	SSRFailFast         bool
}

func NewInertiaCfg() InertiaCfg {
	return InertiaCfg{
		ContainerID:         "app",
		ViteDevURL:          "http://localhost:5173/assets/dist",
		ProtocolDebug:       false,
		SSRMode:             "disabled",
		SSRRuntime:          "node",
		SSRBundle:           "assets/dist/ssr/ssr.js",
		SSRURL:              "http://127.0.0.1:13714",
		SSRStartupTimeout:   10 * time.Second,
		SSRRequestTimeout:   2 * time.Second,
		SSRMaxResponseBytes: 2097152,
		SSRFailFast:         false,
	}
}

func (c *InertiaCfg) WithContainerID(id string)                       { c.ContainerID = id }
func (c *InertiaCfg) WithViteDevURL(url string)                       { c.ViteDevURL = url }
func (c *InertiaCfg) WithProtocolDebug(debug bool)                    { c.ProtocolDebug = debug }
func (c *InertiaCfg) WithSSRMode(mode string)                         { c.SSRMode = mode }
func (c *InertiaCfg) WithSSRRuntime(runtime string)                   { c.SSRRuntime = runtime }
func (c *InertiaCfg) WithSSRBundle(bundle string)                     { c.SSRBundle = bundle }
func (c *InertiaCfg) WithSSRURL(url string)                           { c.SSRURL = url }
func (c *InertiaCfg) WithSSRStartupTimeout(timeout time.Duration)     { c.SSRStartupTimeout = timeout }
func (c *InertiaCfg) WithSSRRequestTimeout(timeout time.Duration)     { c.SSRRequestTimeout = timeout }
func (c *InertiaCfg) WithSSRMaxResponseBytes(size int64)              { c.SSRMaxResponseBytes = size }
func (c *InertiaCfg) WithSSRFailFast(fail bool)                       { c.SSRFailFast = fail }
