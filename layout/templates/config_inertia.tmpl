package config

import (
	"fmt"
	"io/fs"
	"time"

	"{{.ModuleName}}/assets"
	"{{.ModuleName}}/router/routes"
	"{{.ModuleName}}/views"

	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/validation"
)

const (
	DefaultInertiaContainerID         = "app"
	DefaultInertiaViteDevURL          = "http://localhost:5173/assets/dist"
	DefaultInertiaProtocolDebug       = false
	DefaultInertiaSSRMode             = string(inertia.SSRDisabled)
	DefaultInertiaSSRRuntime          = "node"
	DefaultInertiaSSRBundle           = "assets/dist/ssr/ssr.js"
	DefaultInertiaSSRURL              = "http://127.0.0.1:13714"
	DefaultInertiaSSRStartupTimeout   = 10 * time.Second
	DefaultInertiaSSRRequestTimeout   = 2 * time.Second
	DefaultInertiaSSRMaxResponseBytes = int64(2097152)
	DefaultInertiaSSRFailFast         = false
{{- if eq .Inertia "react"}}
	DefaultInertiaEntryPoint          = "resources/js/app.tsx"
{{- else}}
	DefaultInertiaEntryPoint          = "resources/js/app.ts"
{{- end}}
)

type inertiaConfig struct {
	containerID         string
	viteDevURL          string
	protocolDebug       bool
	ssrMode             string
	ssrRuntime          string
	ssrBundle           string
	ssrURL              string
	ssrStartupTimeout   time.Duration
	ssrRequestTimeout   time.Duration
	ssrMaxResponseBytes int64
	ssrFailFast         bool
	root                inertia.RootFunc
	assetFS             fs.FS
	buildPathURL        string
	entryPoint          string
}

func (c *Config) setupInertia() error {
	cfg := inertiaConfig{
		containerID:         envOr("INERTIA_CONTAINER_ID", DefaultInertiaContainerID),
		viteDevURL:          envOr("INERTIA_VITE_DEV_URL", DefaultInertiaViteDevURL),
		protocolDebug:       envOr("INERTIA_PROTOCOL_DEBUG", DefaultInertiaProtocolDebug),
		ssrMode:             envOr("INERTIA_SSR_MODE", DefaultInertiaSSRMode),
		ssrRuntime:          envOr("INERTIA_SSR_RUNTIME", DefaultInertiaSSRRuntime),
		ssrBundle:           envOr("INERTIA_SSR_BUNDLE", DefaultInertiaSSRBundle),
		ssrURL:              envOr("INERTIA_SSR_URL", DefaultInertiaSSRURL),
		ssrStartupTimeout: envOr(
			"INERTIA_SSR_STARTUP_TIMEOUT",
			DefaultInertiaSSRStartupTimeout,
		),
		ssrRequestTimeout: envOr(
			"INERTIA_SSR_REQUEST_TIMEOUT",
			DefaultInertiaSSRRequestTimeout,
		),
		ssrMaxResponseBytes: envOr(
			"INERTIA_SSR_MAX_RESPONSE_BYTES",
			DefaultInertiaSSRMaxResponseBytes,
		),
		ssrFailFast:         envOr("INERTIA_SSR_FAIL_FAST", DefaultInertiaSSRFailFast),
		root:                views.Root,
		assetFS:             assets.Files,
		buildPathURL:        routes.ViteBuild.Path(),
		entryPoint:          envOr("INERTIA_ENTRY_POINT", DefaultInertiaEntryPoint),
	}
	if err := cfg.validate(); err != nil {
		return err
	}
	c.inertia = cfg

	return nil
}

func (c inertiaConfig) validate() error {
	b := validation.NewBuilder()
	b.Required("ContainerID", c.containerID)
	b.Required("ViteDevURL", c.viteDevURL)
	b.Required("EntryPoint", c.entryPoint)
	b.Required("BuildPathURL", c.buildPathURL)
	if err := b.Err(); err != nil {
		return err
	}
	if c.root == nil || c.assetFS == nil {
		return fmt.Errorf("config: Inertia root and assets are required")
	}
	http := inertia.SSRConfig{
		URL:              c.ssrURL,
		Timeout:          c.ssrRequestTimeout,
		MaxResponseBytes: c.ssrMaxResponseBytes,
	}
	switch inertia.SSRMode(c.ssrMode) {
	case inertia.SSRDisabled:
		return nil
	case inertia.SSRExternal:
		return http.Validate()
	case inertia.SSRManaged:
		managed := inertia.DefaultManagedConfig()
		managed.Enabled = true
		managed.Executable = c.ssrRuntime
		managed.BundlePath = c.ssrBundle
		managed.StartupTimeout = c.ssrStartupTimeout
		managed.HTTP = http
		return managed.Validate()
	default:
		return fmt.Errorf("config: unsupported INERTIA_SSR_MODE %q", c.ssrMode)
	}
}

func (c *Config) Root() inertia.RootFunc { return c.inertia.root }

func (c *Config) AssetFS() fs.FS { return c.inertia.assetFS }

func (c *Config) BuildPathURL() string { return c.inertia.buildPathURL }

func (c *Config) EntryPoint() string { return c.inertia.entryPoint }

func (c *Config) ContainerID() string { return c.inertia.containerID }

func (c *Config) ViteDevURL() string { return c.inertia.viteDevURL }

func (c *Config) ProtocolDebug() bool { return c.inertia.protocolDebug }

func (c *Config) SSRMode() string { return c.inertia.ssrMode }

func (c *Config) SSRRuntime() string { return c.inertia.ssrRuntime }

func (c *Config) SSRBundle() string { return c.inertia.ssrBundle }

func (c *Config) SSRURL() string { return c.inertia.ssrURL }

func (c *Config) SSRStartupTimeout() time.Duration {
	return c.inertia.ssrStartupTimeout
}

func (c *Config) SSRRequestTimeout() time.Duration {
	return c.inertia.ssrRequestTimeout
}

func (c *Config) SSRMaxResponseBytes() int64 {
	return c.inertia.ssrMaxResponseBytes
}

func (c *Config) SSRFailFast() bool { return c.inertia.ssrFailFast }
