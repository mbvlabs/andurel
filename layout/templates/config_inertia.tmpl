package config

import (
	"fmt"
	"io/fs"
	"time"

	"{{.ModuleName}}/assets"
	"{{.ModuleName}}/router/routes"
	"{{.ModuleName}}/views"
	"github.com/caarlos0/env/v11"
	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/validation"
)

const (
	DefaultInertiaContainerID         = "app"
	DefaultInertiaViteDevURL          = "http://localhost:5173/assets/dist"
	DefaultInertiaProtocolDebug       = false
	DefaultInertiaSSRMode             = string(inertia.SSRDisabled)
	DefaultInertiaSSRRuntime          = "node"
	DefaultInertiaSSRBundle           = "assets/dist/ssr/ssr.js"
	DefaultInertiaSSRURL              = "http://127.0.0.1:13714"
	DefaultInertiaSSRStartupTimeout   = 10 * time.Second
	DefaultInertiaSSRRequestTimeout   = 2 * time.Second
	DefaultInertiaSSRMaxResponseBytes = int64(2097152)
	DefaultInertiaSSRFailFast         = false
{{- if eq .Inertia "react"}}
	DefaultInertiaEntryPoint          = "resources/js/app.tsx"
{{- else}}
	DefaultInertiaEntryPoint          = "resources/js/app.ts"
{{- end}}
)

var (
	DefaultInertiaRoot         = views.Root
	DefaultInertiaAssetFS      = assets.Files
	DefaultInertiaBuildPathURL = routes.ViteBuild.Path()
)

type InertiaCfg struct {
	ContainerID         string        `env:"INERTIA_CONTAINER_ID"`
	ViteDevURL          string        `env:"INERTIA_VITE_DEV_URL"`
	ProtocolDebug       bool          `env:"INERTIA_PROTOCOL_DEBUG"`
	SSRMode             string        `env:"INERTIA_SSR_MODE"`
	SSRRuntime          string        `env:"INERTIA_SSR_RUNTIME"`
	SSRBundle           string        `env:"INERTIA_SSR_BUNDLE"`
	SSRURL              string        `env:"INERTIA_SSR_URL"`
	SSRStartupTimeout   time.Duration `env:"INERTIA_SSR_STARTUP_TIMEOUT"`
	SSRRequestTimeout   time.Duration `env:"INERTIA_SSR_REQUEST_TIMEOUT"`
	SSRMaxResponseBytes int64         `env:"INERTIA_SSR_MAX_RESPONSE_BYTES"`
	SSRFailFast         bool          `env:"INERTIA_SSR_FAIL_FAST"`
	Root                inertia.RootFunc
	AssetFS             fs.FS
	BuildPathURL        string
	EntryPoint          string
}

func NewInertiaCfg() (InertiaCfg, error) {
	inertiaCfg := InertiaCfg{
		ContainerID:         DefaultInertiaContainerID,
		ViteDevURL:          DefaultInertiaViteDevURL,
		ProtocolDebug:       DefaultInertiaProtocolDebug,
		SSRMode:             DefaultInertiaSSRMode,
		SSRRuntime:          DefaultInertiaSSRRuntime,
		SSRBundle:           DefaultInertiaSSRBundle,
		SSRURL:              DefaultInertiaSSRURL,
		SSRStartupTimeout:   DefaultInertiaSSRStartupTimeout,
		SSRRequestTimeout:   DefaultInertiaSSRRequestTimeout,
		SSRMaxResponseBytes: DefaultInertiaSSRMaxResponseBytes,
		SSRFailFast:         DefaultInertiaSSRFailFast,
		Root:                DefaultInertiaRoot,
		AssetFS:             DefaultInertiaAssetFS,
		BuildPathURL:        DefaultInertiaBuildPathURL,
		EntryPoint:          DefaultInertiaEntryPoint,
	}

	if err := env.Parse(&inertiaCfg); err != nil {
		return InertiaCfg{}, err
	}

	if err := validation.Validate(&inertiaCfg); err != nil {
		return InertiaCfg{}, err
	}

	return inertiaCfg, nil
}

func (c InertiaCfg) Validate() error {
	b := validation.NewBuilder()
	b.Required("ContainerID", c.ContainerID)
	b.Required("ViteDevURL", c.ViteDevURL)
	b.Required("BuildPathURL", c.BuildPathURL)
	b.Required("EntryPoint", c.EntryPoint)
	if err := b.Err(); err != nil {
		return err
	}
	if c.Root == nil || c.AssetFS == nil {
		return fmt.Errorf("config: Inertia root and assets are required")
	}
	http := inertia.SSRConfig{URL: c.SSRURL, Timeout: c.SSRRequestTimeout, MaxResponseBytes: c.SSRMaxResponseBytes}
	switch inertia.SSRMode(c.SSRMode) {
	case inertia.SSRDisabled:
		return nil
	case inertia.SSRExternal:
		return http.Validate()
	case inertia.SSRManaged:
		managed := inertia.DefaultManagedConfig()
		managed.Enabled = true
		managed.Executable = c.SSRRuntime
		managed.BundlePath = c.SSRBundle
		managed.StartupTimeout = c.SSRStartupTimeout
		managed.HTTP = http
		return managed.Validate()
	default:
		return fmt.Errorf("config: unsupported INERTIA_SSR_MODE %q", c.SSRMode)
	}
}

func (c InertiaCfg) GetRoot() inertia.RootFunc { return c.Root }

func (c InertiaCfg) GetAssetFS() fs.FS { return c.AssetFS }

func (c InertiaCfg) GetBuildPathURL() string { return c.BuildPathURL }

func (c InertiaCfg) GetEntryPoint() string { return c.EntryPoint }

func (c InertiaCfg) GetContainerID() string { return c.ContainerID }

func (c InertiaCfg) GetViteDevURL() string { return c.ViteDevURL }

func (c InertiaCfg) GetProtocolDebug() bool { return c.ProtocolDebug }

func (c InertiaCfg) GetSSRMode() string { return c.SSRMode }

func (c InertiaCfg) GetSSRRuntime() string { return c.SSRRuntime }

func (c InertiaCfg) GetSSRBundle() string { return c.SSRBundle }

func (c InertiaCfg) GetSSRURL() string { return c.SSRURL }

func (c InertiaCfg) GetSSRStartupTimeout() time.Duration { return c.SSRStartupTimeout }

func (c InertiaCfg) GetSSRRequestTimeout() time.Duration { return c.SSRRequestTimeout }

func (c InertiaCfg) GetSSRMaxResponseBytes() int64 { return c.SSRMaxResponseBytes }

func (c InertiaCfg) GetSSRFailFast() bool { return c.SSRFailFast }
