// NewJar builds the cookie jar: the session codec, the cookie-backed store,
// and the App session definition. It is wired once in internal/runtime and
// installed with jar.Middleware().
func NewJar(
	appCfg config.App,
	sessionCfg config.Session,
) (*kiks.Jar, error) {
	keys := kiks.Keys{
		Authentication: sessionCfg.AuthenticationKey,
		Encryption:     sessionCfg.EncryptionKey,
	}
	store, err := kiks.NewCookieStore(keys)
	if err != nil {
		return nil, err
	}

	return kiks.NewJar(keys, store,
		NewAppCookie(sessionCfg, appCfg.IsProduction()),
	)
}

