	"context"
{{- range .Blueprint.Cookies.Imports.Items}}
	"{{.}}"
{{- end}}

	"github.com/mbvlabs/andurel/pkg/kiks"
)

{{- if gt (len .Blueprint.Cookies.SortedConstants) 0}}

const (
{{- range .Blueprint.Cookies.SortedConstants}}
	{{.Name}} = "{{.Value}}"
{{- end}}
)
{{- end}}

type App struct {
{{- range .Blueprint.Cookies.SortedAppFields}}
	{{.Name}} {{.Type}}
{{- end}}
}

func Definitions(name string, secure bool, maxAge int) []kiks.Definition {
	return []kiks.Definition{
		kiks.Session[App](
			name,
			kiks.HTTPOnly(),
			kiks.Secure(secure),
			kiks.MaxAge(maxAge),
		),
	}
}

func Current(ctx context.Context) App {
	return kiks.Get[App](ctx)
}

{{- if not (len .Blueprint.Cookies.SortedAppFields)}}

func CreateAppSession(ctx context.Context) {
{{- if .Blueprint.Cookies.CreateSessionCode}}
{{.Blueprint.Cookies.CreateSessionCode}}
{{- else}}
	kiks.Set(ctx, App{})
{{- end}}
}
{{- else}}

func CreateAppSession(ctx context.Context, user models.User) {
{{- if .Blueprint.Cookies.CreateSessionCode}}
{{.Blueprint.Cookies.CreateSessionCode}}
{{- else}}
	kiks.Set(ctx, App{})
{{- end}}
}
{{- end}}

func DestroyAppSession(ctx context.Context) {
	kiks.Delete[App](ctx)
}

