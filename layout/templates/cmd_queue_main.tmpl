package main

import (
	"context"
	"fmt"
{{- if not .Blueprint.Main.ServiceProvides}}
	"log"
{{- end}}
	"log/slog"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.ModuleName}}/config"
{{- if hasExtension .Extensions "aws-ses"}}
	mailclients "{{.ModuleName}}/clients/email"
{{- end}}
	"{{.ModuleName}}/queue"
	"{{.ModuleName}}/telemetry"

	"github.com/mbvlabs/andurel/pkg/email"
	"github.com/mbvlabs/andurel/pkg/server"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/riverqueue/river"
	"go.uber.org/fx"
)

func main() {
	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer cancel()

	app := fx.New(
		fx.Provide(
			func() context.Context { return ctx },
{{- range .Blueprint.Main.ServiceProvides}}
			{{.}},
{{- end}}
			func(cfg config.TelemetryCfg) telemetry.ConfigProvider { return cfg },
		),

		config.Module,
		databaseModule,
		telemetry.Module,
		queue.Module,
		queueProcessorModule,
{{- if not .Blueprint.Main.ServiceProvides}}
		emailModule,
{{- end}}
	)

	if err := app.Start(ctx); err != nil {
		fmt.Fprintf(os.Stderr, "%s\n", err)
		os.Exit(1)
	}

	<-ctx.Done()

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := app.Stop(shutdownCtx); err != nil {
		fmt.Fprintf(os.Stderr, "%s\n", err)
		os.Exit(1)
	}
}

var databaseModule = fx.Module(
	"database",
	fx.Provide(fx.Annotate(newDatabase, fx.As(new(storage.Connection)), fx.As(fx.Self()))),
)

var queueProcessorModule = fx.Module(
	"queue-processor",
	fx.Provide(
		slog.Default,
		newQueueProcessor,
	),
	fx.Invoke(queueProcessorLifecycle),
)

{{- if not .Blueprint.Main.ServiceProvides}}
var emailModule = fx.Module(
	"email",
	fx.Provide(newEmailSenders),
)
{{- end}}

func newDatabase(
	lifecycle fx.Lifecycle,
	ctx context.Context,
	cfg config.Database,
) (*storage.Postgres, error) {
	db, err := storage.NewPostgres(ctx, storage.WithConfig(cfg.StorageConfig()))
	if err != nil {
		return nil, err
	}

	lifecycle.Append(fx.Hook{OnStop: func(context.Context) error { return db.Close() }})
	return db, nil
}

type queueProcessorParams struct {
	fx.In

	Connection   storage.Connection
	Config       config.QueueCfg
	Logger       *slog.Logger
	Workers      *river.Workers
	PeriodicJobs []*river.PeriodicJob `group:"periodic_jobs"`
}

func newQueueProcessor(params queueProcessorParams) (*storage.QueueProcessor, error) {
	queueConfig := params.Config.QueueConfig()

	return storage.NewQueueProcessor(
		params.Connection,
		storage.WithQueueConfig(queueConfig),
		storage.WithRiverWorkers(params.Workers),
		storage.WithRiverPeriodicJobs(params.PeriodicJobs...),
		storage.WithRiverLogger(params.Logger),
		storage.WithRiverQueues(map[string]river.QueueConfig{
			river.QueueDefault: {MaxWorkers: queueConfig.MaxWorkers},
		}),
	)
}

func queueProcessorLifecycle(
	lifecycle fx.Lifecycle,
	appCtx context.Context,
	processor *storage.QueueProcessor,
) {
	lifecycle.Append(fx.Hook{
		OnStart: func(context.Context) error {
			return processor.Start(appCtx)
		},
		OnStop: func(ctx context.Context) error {
			return processor.Stop(ctx)
		},
	})
}

{{- if not .Blueprint.Main.ServiceProvides}}

func newEmailSenders(
	cfg config.EmailCfg,
	appCfg config.AppCfg,
) (email.TransactionalSender, email.MarketingSender) {
	if appCfg.GetEnvironment() == server.ProdEnvironment {
		log.Fatal("provide real email sender")
	}

	client, err := email.NewMailpit(email.WithMailpitConfig(cfg.MailpitConfig()))
	if err != nil {
		log.Fatal(err)
	}

	return client, client
}
{{- end}}
