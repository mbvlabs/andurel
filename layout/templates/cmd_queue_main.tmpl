package main

import (
	"context"
	"fmt"
	"log"
	"log/slog"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/mbvlabs/andurel/pkg/server"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/riverqueue/river"
	"{{.ModuleName}}/application"
	mailclients "{{.ModuleName}}/clients/email"
	"{{.ModuleName}}/config"
	"{{.ModuleName}}/email"
	"{{.ModuleName}}/queue"
	"{{.ModuleName}}/telemetry"

	"go.uber.org/fx"
)

var appVersion string

func main() {
	metadata := application.NewMetadata(appVersion)
	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer cancel()

	app := fx.New(
		fx.Supply(metadata),
		fx.Provide(
			func() context.Context { return ctx },
			func(cfg config.EmailCfg) (email.TransactionalSender, email.MarketingSender) {
				if application.Environment == server.ProdEnvironment {
					log.Fatal("provide real email sender")
				}

				return mailclients.NewMailpit(cfg.MailpitHost, cfg.MailpitPort), mailclients.NewMailpit(cfg.MailpitHost, cfg.MailpitPort)
			},
		),

		config.Module,
		databaseModule,
		telemetry.Module,
		queue.Module,
		queueProcessorModule,
	)

	if err := app.Start(ctx); err != nil {
		fmt.Fprintf(os.Stderr, "%s\n", err)
		os.Exit(1)
	}

	<-ctx.Done()

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := app.Stop(shutdownCtx); err != nil {
		fmt.Fprintf(os.Stderr, "%s\n", err)
		os.Exit(1)
	}
}

var databaseModule = fx.Module(
	"database",
	fx.Provide(fx.Annotate(newDatabase, fx.As(fx.Self(), new(storage.Connection)))),
)

var queueProcessorModule = fx.Module(
	"queue-processor",
	fx.Provide(
		slog.Default,
		newQueueProcessor,
	),
	fx.Invoke(queueProcessorLifecycle),
)

func newDatabase(lifecycle fx.Lifecycle, ctx context.Context, cfg config.Database) (*storage.Postgres, error) {
	db, err := storage.NewPostgres(ctx, storage.WithConfig(storage.Config{
		DatabaseKind:             cfg.DatabaseKind,
		Host:                     cfg.Host,
		Port:                     cfg.Port,
		Name:                     cfg.Name,
		User:                     cfg.User,
		Password:                 cfg.Password,
		SSLMode:                  cfg.SSLMode,
		ApplicationName:          cfg.ApplicationName,
		ConnectTimeout:           cfg.ConnectTimeout,
		StatementCacheCapacity:   cfg.StatementCacheCapacity,
		DescriptionCacheCapacity: cfg.DescriptionCacheCapacity,
		MaxOpenConnections:       cfg.MaxOpenConnections,
		MaxIdleConnections:       cfg.MaxIdleConnections,
		ConnectionMaxLifetime:    cfg.ConnectionMaxLifetime,
		ConnectionMaxIdleTime:    cfg.ConnectionMaxIdleTime,
		OpenTelemetry:            cfg.OpenTelemetry,
	}))
	if err != nil {
		return nil, err
	}

	lifecycle.Append(fx.Hook{OnStop: func(context.Context) error { return db.Close() }})
	return db, nil
}

type queueProcessorParams struct {
	fx.In

	Connection   storage.Connection
	Config       config.QueueCfg
	Logger       *slog.Logger
	Workers      *river.Workers
	PeriodicJobs []*river.PeriodicJob `group:"periodic_jobs"`
}

func newQueueProcessor(params queueProcessorParams) (*storage.QueueProcessor, error) {
	riverConfig := params.Config.RiverConfig()
	riverConfig.Queues = map[string]river.QueueConfig{
		river.QueueDefault: {MaxWorkers: params.Config.MaxWorkers},
	}

	return storage.NewQueueProcessor(
		params.Connection,
		storage.WithRiverConfig(riverConfig),
		storage.WithRiverWorkers(params.Workers),
		storage.WithRiverPeriodicJobs(params.PeriodicJobs...),
		storage.WithRiverLogger(params.Logger),
	)
}

func queueProcessorLifecycle(
	lifecycle fx.Lifecycle,
	appCtx context.Context,
	processor *storage.QueueProcessor,
) {
	lifecycle.Append(fx.Hook{
		OnStart: func(context.Context) error {
			return processor.Start(appCtx)
		},
		OnStop: func(ctx context.Context) error {
			return processor.Stop(ctx)
		},
	})
}
