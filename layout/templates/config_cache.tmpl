package config

import (
	"fmt"
	"time"

	"github.com/mbvlabs/andurel/pkg/cache"
)

// DefaultCacheNamespace isolates application keys on shared infrastructure.
const DefaultCacheNamespace = "andurel"

// Cache selects the cache driver and its options. The memory driver is
// in-process; the redis driver shares values and rate-limit counters across
// replicas.
type Cache struct {
	Driver    string
	Namespace string
	RedisAddr string
}

func NewCache() (Cache, error) {
	env := newEnvironment()
	cfg := Cache{
		Driver:    env.String("CACHE_DRIVER", "memory"),
		Namespace: env.String("CACHE_NAMESPACE", DefaultCacheNamespace),
		RedisAddr: env.String("CACHE_REDIS_ADDR", ""),
	}
	if err := env.Err(); err != nil {
		return Cache{}, fmt.Errorf("config: cache: %w", err)
	}
	if cfg.Driver != "memory" && cfg.Driver != "redis" {
		return Cache{}, fmt.Errorf("config: cache: CACHE_DRIVER must be memory or redis")
	}
	if cfg.Driver == "redis" && cfg.RedisAddr == "" {
		return Cache{}, fmt.Errorf("config: cache: CACHE_REDIS_ADDR is required for the redis driver")
	}

	return cfg, nil
}

// Store builds the cache.Store described by cfg.
func (c Cache) Store() (cache.Store, error) {
	return cache.New(cache.Config{
		Driver:    c.Driver,
		Namespace: c.Namespace,
		Redis: cache.RedisConfig{
			Addr: c.RedisAddr,
		},
	})
}

// CacheTTL is a convenience for handlers: the default TTL for rendered
// assets. It reads CACHE_TTL or falls back to fifteen minutes.
func CacheTTL() time.Duration {
	return newEnvironment().Duration("CACHE_TTL", 15*time.Minute)
}
