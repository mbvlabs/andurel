package middleware

import (
	"context"
	"net"
	"net/http"
	"time"

	"{{.ModuleName}}/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/kiks"
	"github.com/mbvlabs/andurel/pkg/routing"

	"github.com/maypok86/otter/v2"
)

// AuthOnly gates a route on an authenticated application session, redirecting
// anonymous visitors to the sign-in page.
func AuthOnly() anduin.Middleware {
	return func(next anduin.Handler) anduin.Handler {
		return func(ctx context.Context) error {
			app, err := kiks.Get[*App](ctx)
			if err != nil {
				return err
			}
			if app != nil && app.IsAuthenticated {
				return next(ctx)
			}

			return anduin.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
		}
	}
}

// IPRateLimiter allows at most limit requests per client IP within ten minutes.
// Over-limit requests receive 429 with the redirect route's URL as the body.
func IPRateLimiter(
	limit int,
	redirectURL routing.Route,
) anduin.Middleware {
	cache := otter.Must(&otter.Options[string, int]{
		MaximumSize:      1000,
		ExpiryCalculator: otter.ExpiryCreating[string, int](10 * time.Minute),
	})

	return func(next anduin.Handler) anduin.Handler {
		return func(ctx context.Context) error {
			ip := clientIP(anduin.Request(ctx))
			allowed := false
			cache.Compute(ip, func(hits int, found bool) (int, otter.ComputeOp) {
				if !found {
					hits = 0
				}
				if hits >= limit {
					return hits, otter.CancelOp
				}

				allowed = true
				return hits + 1, otter.WriteOp
			})

			if !allowed {
				return anduin.Text(ctx, http.StatusTooManyRequests, redirectURL.URL())
			}

			return next(ctx)
		}
	}
}

// clientIP resolves the request's client address, stripping the port.
func clientIP(request *http.Request) string {
	if request == nil {
		return ""
	}
	if host, _, err := net.SplitHostPort(request.RemoteAddr); err == nil {
		return host
	}

	return request.RemoteAddr
}
