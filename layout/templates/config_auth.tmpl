package config

import (
	"slices"

	"github.com/mbvlabs/andurel/pkg/validation"
)

type authConfig struct {
	pepper          string
	previousPeppers []string
}

func (c *Config) setupAuth() error {
	cfg := authConfig{
		pepper:          envOr("PEPPER", ""),
		previousPeppers: envSlice("PREVIOUS_PEPPERS", nil),
	}
	if err := cfg.validate(); err != nil {
		return err
	}
	c.auth = cfg

	return nil
}

func (c authConfig) validate() error {
	b := validation.NewBuilder()
	b.Required("Pepper", c.pepper)

	return b.Err()
}

func (c *Config) Pepper() string { return c.auth.pepper }

func (c *Config) PreviousPeppers() []string {
	return slices.Clone(c.auth.previousPeppers)
}
