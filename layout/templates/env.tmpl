ENVIRONMENT=development

DEFAULT_SENDER_SIGNATURE=info@andurel.com

DB_KIND=postgres
DB_PORT=5432
DB_HOST=127.0.0.1
DB_NAME=andurel
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

PROJECT_NAME={{.ProjectName}}
DOMAIN=localhost:8080
PROTOCOL=http

SESSION_KEY={{.SessionKey}}
SESSION_ENCRYPTION_KEY={{.SessionEncryptionKey}}
SESSION_MAX_AGE=604800

TOKEN_SIGNING_KEY={{.TokenSigningKey}}

CORS_ALLOWED_ORIGINS=
CSRF_STRATEGY=header_only
CSRF_TRUSTED_ORIGINS=
{{- if .Inertia}}

INERTIA_CONTAINER_ID=app
INERTIA_VITE_DEV_URL=http://localhost:5173/assets/dist
INERTIA_PROTOCOL_DEBUG=false
INERTIA_SSR_MODE=disabled
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_BUNDLE=assets/dist/ssr/ssr.js
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_STARTUP_TIMEOUT=10s
INERTIA_SSR_REQUEST_TIMEOUT=2s
INERTIA_SSR_MAX_RESPONSE_BYTES=2097152
INERTIA_SSR_FAIL_FAST=false
{{- end}}

PEPPER={{.Pepper}}
PREVIOUS_PEPPERS=
{{- if .Blueprint.Config.EnvVars}}
{{range .Blueprint.Config.SortedEnvVars}}
{{.Key}}={{.DefaultValue}}
{{- end}}
{{- end}}
