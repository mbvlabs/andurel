ENVIRONMENT=development

DEFAULT_SENDER_SIGNATURE=info@andurel.com

DB_KIND=postgres
DB_PORT=5432
DB_HOST=127.0.0.1
DB_NAME=andurel
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

QUEUE_ADVISORY_LOCK_PREFIX=0
QUEUE_CANCELLED_JOB_RETENTION_PERIOD=24h
QUEUE_COMPLETED_JOB_RETENTION_PERIOD=24h
QUEUE_DISCARDED_JOB_RETENTION_PERIOD=168h
QUEUE_FETCH_COOLDOWN=100ms
QUEUE_POLL_INTERVAL=1s
QUEUE_ID=
QUEUE_JOB_CLEANER_TIMEOUT=30s
QUEUE_JOB_STUCK_THRESHOLD=10s
QUEUE_JOB_TIMEOUT=1m
QUEUE_MAX_ATTEMPTS=25
QUEUE_MAX_WORKERS=100
QUEUE_POLL_ONLY=false
QUEUE_REINDEXER_INDEX_NAMES=river_job_args_index,river_job_kind,river_job_metadata_index,river_job_pkey,river_job_prioritized_fetching_index,river_job_state_and_finalized_at_index,river_job_unique_idx
QUEUE_REINDEXER_TIMEOUT=1m
QUEUE_RESCUE_STUCK_JOBS_AFTER=1h
QUEUE_SCHEMA=
QUEUE_SOFT_STOP_TIMEOUT=0s
QUEUE_SKIP_JOB_KIND_VALIDATION=false
QUEUE_SKIP_UNKNOWN_JOB_CHECK=false

PROJECT_NAME={{.ProjectName}}
DOMAIN=localhost:8080
PROTOCOL=http

SESSION_KEY={{.SessionKey}}
SESSION_ENCRYPTION_KEY={{.SessionEncryptionKey}}
SESSION_MAX_AGE=604800

TOKEN_SIGNING_KEY={{.TokenSigningKey}}

CORS_ALLOWED_ORIGINS=
CSRF_STRATEGY=header_only
CSRF_TRUSTED_ORIGINS=
{{- if .Inertia}}

INERTIA_CONTAINER_ID=app
INERTIA_VITE_DEV_URL=http://localhost:5173/assets/dist
INERTIA_PROTOCOL_DEBUG=false
INERTIA_SSR_MODE=disabled
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_BUNDLE=assets/dist/ssr/ssr.js
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_STARTUP_TIMEOUT=10s
INERTIA_SSR_REQUEST_TIMEOUT=2s
INERTIA_SSR_MAX_RESPONSE_BYTES=2097152
INERTIA_SSR_FAIL_FAST=false
{{- end}}

PEPPER={{.Pepper}}
PREVIOUS_PEPPERS=
{{- if .Blueprint.Config.EnvVars}}
{{range .Blueprint.Config.SortedEnvVars}}
{{.Key}}={{.DefaultValue}}
{{- end}}
{{- end}}
