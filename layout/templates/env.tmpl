# Keys are grouped by the config file that reads them. Uncommented keys are
# required or scaffolded values; commented keys show their built-in defaults.
# Copy .env.example to .env and override what you need.

# config/app.go
ENVIRONMENT=development
PROJECT_NAME={{.ProjectName}}
# Display name for titles and the shared siteName prop.
# SITE_NAME={{.SiteName}}
HOST_PRIMARY=localhost:8080
# PROTOCOL=http

# config/hosts.go: extra named hosts are opt-in. Declare the HostName in
# config/hosts.go and add it to App.Hosts before setting the env key.
# HOST_ADMIN=

# config/auth.go
TOKEN_SIGNING_KEY={{.TokenSigningKey}}
PEPPER={{.Pepper}}
# Comma-separated peppers from earlier rotations. Passwords hashed with one are
# re-hashed with PEPPER on the next successful login.
# PREVIOUS_PEPPERS=

# config/cache.go
CACHE_DRIVER=memory
CACHE_NAMESPACE={{.Identifier}}
# CACHE_REDIS_ADDR=

# config/database.go
DB_KIND=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME={{.Identifier}}
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
# DB_APPLICATION_NAME={{.Identifier}}
# DB_CONNECT_TIMEOUT=5s
# DB_STATEMENT_CACHE_CAPACITY=512
# DB_DESCRIPTION_CACHE_CAPACITY=512
# DB_MAX_OPEN_CONNECTIONS=25
# DB_MAX_IDLE_CONNECTIONS=25
# DB_CONNECTION_MAX_LIFETIME=1h0m0s
# DB_CONNECTION_MAX_IDLE_TIME=30m0s
# DB_OPEN_TELEMETRY=true

# config/email.go
# Production uses smtp, or log for a production-like local run that logs
# messages instead of sending them.
EMAIL_PROVIDER=mailpit
MAILPIT_HOST=0.0.0.0
MAILPIT_PORT=1025
# Production SMTP (set EMAIL_PROVIDER=smtp). SMTP_PORT defaults to 587 and
# SMTP_TLS accepts starttls, tls (implicit TLS, usually port 465), or none.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=starttls
# Unset, the sender is noreply@<HOST_PRIMARY without its port>.
# DEFAULT_SENDER_SIGNATURE=

# config/http.go
HOST=localhost
PORT=8080
CSRF_STRATEGY=header_only
# CSRF_TRUSTED_ORIGINS=
# Comma-separated origins allowed to make credentialed cross-origin requests.
# CORS_ALLOWED_ORIGINS=
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For.
# HTTP_TRUSTED_PROXIES=
# Gzip-compress responses for clients that accept it.
# HTTP_COMPRESS=true
# HTTP_IDLE_TIMEOUT=2m0s
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=30s

# config/inertia.go
# INERTIA_CONTAINER_ID=app
# INERTIA_VITE_DEV_URL=http://localhost:5173/assets/dist
# INERTIA_PROTOCOL_DEBUG=true
# INERTIA_SSR_RUNTIME={{if .JavaScriptSSRRuntime}}{{.JavaScriptSSRRuntime}}{{else}}node{{end}}
# INERTIA_SSR_BUNDLE=assets/dist/ssr/ssr.js
# INERTIA_SSR_LISTEN=http://127.0.0.1:13714
# INERTIA_SSR_URL=http://127.0.0.1:13714
# INERTIA_SSR_STARTUP_TIMEOUT=10s
# INERTIA_SSR_REQUEST_TIMEOUT=2s
# INERTIA_SSR_MAX_RESPONSE_BYTES=2097152
# INERTIA_SSR_MINIMUM_MAJOR=22
# Development SSR is served by the Vite dev server (`andurel run` / `pnpm dev`);
# production SSR is served by cmd/ssr. Fail-fast (the default in every
# environment) turns an SSR error into a themed 500. Uncomment the next line
# only to opt into client-side-rendering fallback, for example in development
# when the Vite dev server is not running; do not commit it as a production
# default, because a failed SSR request would then answer 200 without rendered
# markup.
# INERTIA_SSR_FAIL_FAST=false
# INERTIA_ENTRY_POINT={{.InertiaEntryPoint}}

# config/queue.go
# QUEUE_MAX_ATTEMPTS=25
# QUEUE_SCHEMA=
# QUEUE_MAX_WORKERS=100
# QUEUE_ADVISORY_LOCK_PREFIX=0
# QUEUE_CANCELLED_JOB_RETENTION_PERIOD=24h0m0s
# QUEUE_COMPLETED_JOB_RETENTION_PERIOD=24h0m0s
# QUEUE_DISCARDED_JOB_RETENTION_PERIOD=168h0m0s
# QUEUE_FETCH_COOLDOWN=100ms
# QUEUE_POLL_INTERVAL=1s
# QUEUE_ID=
# QUEUE_JOB_CLEANER_TIMEOUT=30s
# QUEUE_JOB_STUCK_THRESHOLD=10s
# QUEUE_JOB_TIMEOUT=1m0s
# QUEUE_POLL_ONLY=false
# QUEUE_REINDEXER_TIMEOUT=1m0s
# QUEUE_RESCUE_STUCK_JOBS_AFTER=1h0m0s
# QUEUE_SOFT_STOP_TIMEOUT=0s
# QUEUE_SKIP_JOB_KIND_VALIDATION=false
# QUEUE_SKIP_UNKNOWN_JOB_CHECK=false

# config/session.go
SESSION_KEY={{.SessionKey}}
SESSION_ENCRYPTION_KEY={{.SessionEncryptionKey}}
# SESSION_MAX_AGE=604800

# config/telemetry.go
LOG_LEVEL=INFO
# Unset, the service version is the version injected by andurel build.
# TELEMETRY_SERVICE_VERSION=
# Unset, the service name is the project name.
# TELEMETRY_SERVICE_NAME={{.Slug}}
# TRACE_SAMPLE_RATE=1
# TELEMETRY_BATCH_SIZE=512
# TELEMETRY_BATCH_TIMEOUT_MS=5000
# OTLP_LOGS_ENDPOINT=
# OTLP_TRACES_ENDPOINT=
# OTLP_METRICS_ENDPOINT=
# OTLP_HEADERS=
{{- if .Blueprint.Config.EnvVars}}
{{range .Blueprint.Config.SortedEnvVars}}
{{.Key}}={{.DefaultValue}}
{{- end}}
{{- end}}
