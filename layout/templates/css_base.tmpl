@import "tailwindcss";
@import "./theme.css";
{{- if .Inertia}}
@import "@fontsource-variable/jetbrains-mono";
@import "@fontsource-variable/noto-sans";
@import "@fontsource/architects-daughter";
{{- end}}

@custom-variant dark (&:is(.dark *));

/*
 * Tailwind entry point. Color tokens and their utility mappings live in
 * theme.css (with the sm/md/lg radii, which email.css also needs); this file
 * owns the source globs, base rules, fonts and the larger radii. Keep `@theme`
 * blocks split by concern, never duplicated.
 */

html {
	scroll-behavior: smooth;
}

body {
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
	font-style: normal;
	font-weight: 400;
	letter-spacing: 0;
	line-height: 1.5;
	-webkit-tap-highlight-color: rgba(0, 0, 0, 0);
	text-rendering: optimizeLegibility;
}

@source "./views";
@source "./resources/js";

@theme inline {
	--font-mono: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
	--font-heading: 'Noto Sans Variable', 'Noto Sans', sans-serif;
	--font-blueprint: 'Architects Daughter', cursive;
	--radius-xl: calc(var(--radius) * 1.4);
	--radius-2xl: calc(var(--radius) * 1.8);
	--radius-3xl: calc(var(--radius) * 2.2);
	--radius-4xl: calc(var(--radius) * 2.6);
}

@layer base {
	* {
		@apply border-border outline-ring/50;
	}
	body {
		@apply bg-background text-foreground;
	}
	button:not(:disabled), [role="button"]:not(:disabled) {
		cursor: pointer;
	}
	html {
		@apply font-sans;
	}
}
