package config

import (
	"context"

	"github.com/caarlos0/env/v11"
	"github.com/mbvlabs/andurel/pkg/storage"
	"go.uber.org/fx"
)

// databaseCfg contains environment-backed PostgreSQL settings.
type databaseCfg struct {
	Port         string `env:"DB_PORT" envDefault:"5432"`
	Host         string `env:"DB_HOST" envDefault:"127.0.0.1"`
	Name         string `env:"DB_NAME" envDefault:"andurel"`
	User         string `env:"DB_USER" envDefault:"postgres"`
	Password     string `env:"DB_PASSWORD" envDefault:"postgres"`
	DatabaseKind string `env:"DB_KIND" envDefault:"postgres"`
	SSLMode      string `env:"DB_SSL_MODE" envDefault:"disable"`
}

func newDatabaseConfig() databaseCfg {
	cfg := databaseCfg{}
	if err := env.ParseWithOptions(&cfg, env.Options{RequiredIfNoDef: true}); err != nil {
		panic(err)
	}
	return cfg
}

func newDatabase(lifecycle fx.Lifecycle, ctx context.Context, cfg Config) (storage.Pool, error) {
	db, err := storage.NewPostgres(ctx,
		storage.WithDatabaseKind(cfg.DB.DatabaseKind),
		storage.WithHost(cfg.DB.Host),
		storage.WithPort(cfg.DB.Port),
		storage.WithDatabaseName(cfg.DB.Name),
		storage.WithUser(cfg.DB.User),
		storage.WithPassword(cfg.DB.Password),
		storage.WithSSLMode(cfg.DB.SSLMode),
	)
	if err != nil {
		return nil, err
	}

	lifecycle.Append(fx.Hook{OnStop: func(context.Context) error { return db.Close() }})
	return db, nil
}

// DatabaseModule provides the application database pool and manages its lifecycle.
var DatabaseModule = fx.Module("database", fx.Provide(newDatabase))
