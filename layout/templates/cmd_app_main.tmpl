package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.ModuleName}}/config"
	"{{.ModuleName}}/internal/runtime"
)

// appVersion is injected at build time with -ldflags. It is empty for local
// builds, in which case the config default ("dev") is used.
var appVersion string

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	if err := config.LoadEnvironment(); err != nil {
		return err
	}

	cfg, err := config.New()
	if err != nil {
		return err
	}
	if appVersion != "" {
		cfg.Version = appVersion
	}

	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer cancel()

	app, err := runtime.New(ctx, cfg)
	if err != nil {
		return err
	}
	defer closeApp(app)

	serveErr := make(chan error, 1)
	go func() { serveErr <- app.Start(ctx) }()

	select {
	case err := <-serveErr:
		return err
	case <-ctx.Done():
	}

	shutdownCtx, cancelShutdown := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancelShutdown()

	return app.Shutdown(shutdownCtx)
}

// closeApp releases the composition root's dependencies in reverse construction
// order. It always runs, even when the server exits with an error.
func closeApp(app *runtime.App) {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := app.Close(ctx); err != nil {
		fmt.Fprintf(os.Stderr, "%s\n", err)
	}
}
