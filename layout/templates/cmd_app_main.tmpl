var appVersion string

func main() {
	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer cancel()
	app := fx.New(
		fx.Provide(
			func() context.Context { return ctx },
{{- range .Blueprint.Main.ServiceProvides}}
			{{.}},
{{- end}}
			func(cfg config.AppCfg) router.AppProvider { return cfg },
			func(cfg config.AppCfg) controllers.ConfigProvider { return cfg },
			func(cfg config.AppCfg) controllers.AssetsAppProvider { return cfg },
			func(cfg config.AppCfg) services.AppIdentityProvider { return cfg },
			func(cfg config.AuthCfg) services.AuthProvider { return cfg },
			func(cfg config.TelemetryCfg) telemetry.ConfigProvider { return cfg },
		),

		config.Module,
		databaseModule,
		queueInsertModule,
{{- if not .Blueprint.Main.ServiceProvides}}
		emailModule,
{{- end}}
		models.Module,
{{- if .Inertia}}
		inertiaModule,
{{- end}}
		telemetry.Module,
		services.Module,
		controllers.Module,
		router.Module,

		fx.Invoke(startServer),
	)

	if err := app.Start(ctx); err != nil {
		fmt.Fprintf(os.Stderr, "%s\n", err)
		os.Exit(1)
	}

	<-ctx.Done()

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := app.Stop(shutdownCtx); err != nil {
		fmt.Fprintf(os.Stderr, "%s\n", err)
		os.Exit(1)
	}
}

var databaseModule = fx.Module(
	"database",
	fx.Provide(fx.Annotate(newDatabase, fx.As(new(storage.Connection)), fx.As(fx.Self()))),
)

var queueInsertModule = fx.Module(
	"queue-insert",
	fx.Provide(fx.Annotate(newQueueInsert, fx.As(new(storage.InsertQueue)))),
)

{{- if not .Blueprint.Main.ServiceProvides}}
var emailModule = fx.Module(
	"email",
	fx.Provide(newEmailSenders),
)
{{- end}}

{{- if .Inertia}}
var inertiaModule = fx.Module(
	"inertia",
	fx.Provide(newInertia),
)
{{- end}}

func startServer(lc fx.Lifecycle, appCtx context.Context, r *router.Router, appCfg config.AppCfg) {
	srv := server.New(
		appCtx,
		appCfg.GetHost(),
		appCfg.GetPort(),
		appCfg.GetEnvironment(),
		r.Handler,
		nil,
	)
	var done <-chan struct{}

	lc.Append(fx.Hook{
		OnStart: func(_ context.Context) error {
			slog.InfoContext(
				appCtx,
				"starting server",
				"host",
				appCfg.GetHost(),
				"port",
				appCfg.GetPort(),
			)
			done = startInBackground(appCtx, "server", func(ctx context.Context) error {
				return srv.Start(ctx, appCfg.GetEnvironment())
			})
			return nil
		},
		OnStop: func(ctx context.Context) error {
			slog.InfoContext(ctx, "initiating graceful shutdown")
			return stopAndWait(ctx, func(ctx context.Context) error {
				var shutdownErr error
				for _, shutdowner := range srv.Shutdowners {
					if err := shutdowner.Shutdown(ctx); err != nil {
						shutdownErr = errors.Join(
							shutdownErr,
							fmt.Errorf("server: shutdown component %T: %w", shutdowner, err),
						)
					}
				}

				return shutdownErr
			}, done)
		},
	})
}

func newDatabase(
	lifecycle fx.Lifecycle,
	ctx context.Context,
	cfg config.Database,
) (*storage.Postgres, error) {
	db, err := storage.NewPostgres(ctx, storage.WithConfig(storage.Config{
		DatabaseKind:             cfg.GetDatabaseKind(),
		Host:                     cfg.GetHost(),
		Port:                     cfg.GetPort(),
		Name:                     cfg.GetName(),
		User:                     cfg.GetUser(),
		Password:                 cfg.GetPassword(),
		SSLMode:                  cfg.GetSSLMode(),
		ApplicationName:          cfg.GetApplicationName(),
		ConnectTimeout:           cfg.GetConnectTimeout(),
		StatementCacheCapacity:   cfg.GetStatementCacheCapacity(),
		DescriptionCacheCapacity: cfg.GetDescriptionCacheCapacity(),
		MaxOpenConnections:       cfg.GetMaxOpenConnections(),
		MaxIdleConnections:       cfg.GetMaxIdleConnections(),
		ConnectionMaxLifetime:    cfg.GetConnectionMaxLifetime(),
		ConnectionMaxIdleTime:    cfg.GetConnectionMaxIdleTime(),
		OpenTelemetry:            cfg.GetOpenTelemetry(),
	}))
	if err != nil {
		return nil, err
	}

	lifecycle.Append(fx.Hook{OnStop: func(context.Context) error { return db.Close() }})
	return db, nil
}

func newQueueInsert(
	connection storage.Connection,
	cfg config.QueueCfg,
) (*storage.QueueInsert, error) {
	return storage.NewQueueInsert(connection, storage.WithRiverConfig(cfg.RiverConfig()))
}

{{- if not .Blueprint.Main.ServiceProvides}}
func newEmailSenders(
	cfg config.EmailCfg,
	appCfg config.AppCfg,
) (email.TransactionalSender, email.MarketingSender) {
	if appCfg.GetEnvironment() == server.ProdEnvironment {
		log.Fatal("provide real email sender")
	}

	client, err := email.NewMailpit(email.WithMailpitConfig(cfg.MailpitConfig()))
	if err != nil {
		log.Fatal(err)
	}

	return client, client
}
{{- end}}

{{if .Inertia}}

func newInertia(
	lifecycle fx.Lifecycle,
	cfg config.InertiaCfg,
	appCfg config.AppCfg,
) (*inertia.Renderer, error) {
	renderer, err := inertia.New(
		inertia.WithRoot(cfg.GetRoot()),
		inertia.WithAssetFS(cfg.GetAssetFS()),
		inertia.WithProjectName(appCfg.GetProjectName()),
		inertia.WithEnvironment(appCfg.GetEnvironment()),
		inertia.WithBuildPathURL(cfg.GetBuildPathURL()),
		inertia.WithEntryPoint(cfg.GetEntryPoint()),
		inertia.WithContainerID(cfg.GetContainerID()),
		inertia.WithViteDevURL(cfg.GetViteDevURL()),
		inertia.WithProtocolDebug(cfg.GetProtocolDebug()),
		inertia.WithShared(inertia.Props{"appVersion": appVersion}),
		inertia.WithSSRMode(inertia.SSRMode(cfg.GetSSRMode())),
		inertia.WithSSRRuntime(cfg.GetSSRRuntime()),
		inertia.WithSSRBundle(cfg.GetSSRBundle()),
		inertia.WithSSRURL(cfg.GetSSRURL()),
		inertia.WithSSRStartupTimeout(cfg.GetSSRStartupTimeout()),
		inertia.WithSSRRequestTimeout(cfg.GetSSRRequestTimeout()),
		inertia.WithSSRMaxResponseBytes(cfg.GetSSRMaxResponseBytes()),
		inertia.WithSSRFailFast(cfg.GetSSRFailFast()),
	)
	if err != nil {
		return nil, err
	}

	lifecycle.Append(fx.Hook{
		OnStart: renderer.Start,
		OnStop:  renderer.Shutdown,
	})
	return renderer, nil
}
{{- end}}

func startInBackground(
	ctx context.Context,
	name string,
	start func(context.Context) error,
) <-chan struct{} {
	done := make(chan struct{})
	go func() {
		defer close(done)
		if err := start(ctx); err != nil {
			slog.Error(name+" error", "error", err)
		}
	}()
	return done
}

func stopAndWait(
	ctx context.Context,
	stop func(context.Context) error,
	done <-chan struct{},
) error {
	stopErr := stop(ctx)
	select {
	case <-done:
		return stopErr
	case <-ctx.Done():
		return errors.Join(stopErr, ctx.Err())
	}
}
