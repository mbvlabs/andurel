	"syscall"
	"time"

	"{{.ModuleName}}/config"
	"{{.ModuleName}}/controllers"
	"{{.ModuleName}}/models"
	"{{.ModuleName}}/router"
	"{{.ModuleName}}/services"
	"{{.ModuleName}}/telemetry"

	{{- if .Inertia}}
	"github.com/mbvlabs/andurel/pkg/inertia"
	{{- end}}
