// does not gate on the sidecar.
func TestReadinessIgnoresSSRWithExplicitCSRFallback(t *testing.T) {
	requireProductionAssets(t)

	cfg := testProductionConfig(t)
	cfg.Inertia.SSRURL = "http://127.0.0.1:1"
