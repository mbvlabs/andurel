package services

import (
	"context"
	"strings"

	"{{.ModuleName}}/config"
	domaintoken "{{.ModuleName}}/domains/token"
	domainuser "{{.ModuleName}}/domains/user"

	"github.com/mbvlabs/andurel/pkg/storage"
)

// Identity coordinates the user and token domains with the queue, email, and
// auth/mail configuration. It is the only place those domains meet.
type Identity struct {
	users                  domainuser.Users
	tokens                 domaintoken.Tokens
	insertOnly             storage.InsertQueue
	pepper                 string
	previousPeppers        []string
	tokenSigningKey        string
	defaultSenderSignature string
}

func NewIdentity(
	users domainuser.Users,
	tokens domaintoken.Tokens,
	insertOnly storage.InsertQueue,
	authCfg config.Auth,
	mailCfg config.Mail,
) Identity {
	validPeppers := make([]string, 0, len(authCfg.PreviousPeppers))
	for _, p := range authCfg.PreviousPeppers {
		if p = strings.TrimSpace(p); p != "" && p != authCfg.Pepper {
			validPeppers = append(validPeppers, p)
		}
	}

	return Identity{
		users:                  users,
		tokens:                 tokens,
		insertOnly:             insertOnly,
		pepper:                 authCfg.Pepper,
		previousPeppers:        validPeppers,
		tokenSigningKey:        authCfg.TokenSigningKey,
		defaultSenderSignature: mailCfg.DefaultSenderSignature,
	}
}

// beginTx starts a transaction that spans the user and token domains. The
// domains each expose their connection so a use case can commit writes to more
// than one table atomically; domains themselves never coordinate transactions.
func (i Identity) beginTx(ctx context.Context) (storage.Transaction, error) {
	return i.users.Connection().BeginTransaction(ctx)
}
