package api

import (
	"context"
	"errors"
	"net/http"

	"{{.ModuleName}}/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/storage"
)

// API exposes the JSON API surface. It is mounted under routes.APIPrefix.
type API struct {
	db storage.Connection
}

func NewAPI(db storage.Connection) API {
	return API{db: db}
}

func (a API) Register(rt *anduin.Router) {
	rt.Get(routes.Health.Path(), a.Health)
}

func (a API) Health(ctx context.Context) error {
	if err := a.db.Health(ctx); err != nil {
		return anduin.Error(
			ctx,
			http.StatusServiceUnavailable,
			errors.New("database is unavailable"),
		)
	}

	return anduin.JSON(ctx, http.StatusOK, "app is healthy and running")
}
