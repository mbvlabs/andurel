package auth

import (
	"context"
	"errors"
	"net/http"

	"{{.ModuleName}}/domains"
	domainuser "{{.ModuleName}}/domains/user"
	"{{.ModuleName}}/middleware"
	"{{.ModuleName}}/routes"
	"{{.ModuleName}}/services"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/kiks"
	"github.com/mbvlabs/andurel/pkg/telemetry"
)

// Handler serves the authentication surface: sessions, registration, email
// confirmation, and password reset. It is the reference handler for the
// generated application and the only place the identity service meets HTTP.
type Handler struct {
	identity services.Identity
	renderer *inertia.Renderer
}

func NewHandler(identity services.Identity, renderer *inertia.Renderer) Handler {
	return Handler{identity: identity, renderer: renderer}
}

// Register mounts every auth route, rate-limiting the credential endpoints.
func (h Handler) Register(rt *anduin.Router) {
	rt.Get(routes.SessionNew.Path(), h.SessionNew)
	rt.Post(
		routes.SessionCreate.Path(),
		h.SessionCreate,
		middleware.IPRateLimiter(5, routes.SessionNew),
	)
	rt.Delete(routes.SessionDestroy.Path(), h.SessionDestroy)

	rt.Get(routes.RegistrationNew.Path(), h.RegistrationNew)
	rt.Post(
		routes.RegistrationCreate.Path(),
		h.RegistrationCreate,
		middleware.IPRateLimiter(5, routes.RegistrationNew),
	)

	rt.Get(routes.ConfirmationNew.Path(), h.ConfirmationNew)
	rt.Post(
		routes.ConfirmationCreate.Path(),
		h.ConfirmationCreate,
		middleware.IPRateLimiter(5, routes.ConfirmationNew),
	)

	rt.Get(routes.PasswordNew.Path(), h.PasswordNew)
	rt.Post(routes.PasswordCreate.Path(), h.PasswordCreate)
	rt.Get(routes.PasswordEdit.Path(), h.PasswordEdit)
	rt.Put(routes.PasswordUpdate.Path(), h.PasswordUpdate)
}

func (h Handler) SessionNew(ctx context.Context) error {
	return h.renderer.Page(ctx, "Auth/Login", inertia.Props{}).Render()
}

func (h Handler) SessionCreate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "sessions.create")
	defer span.End()

	var payload struct {
		Email    string `json:"email"`
		Password string `json:"password"`
	}

	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		telemetry.Error(
			ctx,
			"could not parse login form payload",
			"error", err,
		)
		return h.renderer.Page(ctx, "Errors/BadRequest", inertia.Props{}).Render()
	}

	user, err := h.identity.AuthenticateUser(
		ctx,
		services.LoginData{
			Email:    payload.Email,
			Password: payload.Password,
		},
	)
	if err != nil {
		if fields, ok := validationFields(err); ok {
			return h.renderer.Page(
				ctx,
				"Auth/Login",
				inertia.Props{},
			).ValidationErrors(fields).Render()
		}

		if errors.Is(err, services.ErrEmailNotVerified) {
			if resumeErr := h.resumeEmailVerification(ctx, user); resumeErr != nil {
				return resumeErr
			}

			return h.renderer.Redirect(
				ctx,
				routes.ConfirmationNew.URL(),
				http.StatusSeeOther,
			)
		}

		telemetry.Error(
			ctx,
			"failed to authenticate user",
			"error", err,
		)

		return h.renderer.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
	}

	if err := kiks.Set(ctx, &middleware.App{
		UserID:          user.ID.String(),
		IsAdmin:         user.IsAdmin,
		IsAuthenticated: true,
	}); err != nil {
		return err
	}

	return h.renderer.Location(ctx, routes.HomePage.URL())
}

// resumeEmailVerification sends an unverified user a fresh code and binds it
// to this session, so they can confirm from any browser.
func (h Handler) resumeEmailVerification(ctx context.Context, user domainuser.User) error {
	if err := h.identity.ResendEmailVerification(ctx, user); err != nil {
		return err
	}

	return setPendingUser(ctx, user.ID.String())
}

func (h Handler) SessionDestroy(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "sessions.destroy")
	defer span.End()

	if err := kiks.Destroy[*middleware.App](ctx); err != nil {
		return err
	}

	return h.renderer.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
}

// validationFields unwraps the domain validation error that services return so
// a handler can re-render its form with field-level messages.
func validationFields(err error) (map[string]string, bool) {
	var validationErr domains.ValidationError
	if errors.As(err, &validationErr) {
		return validationErr.Fields, true
	}

	return nil, false
}
