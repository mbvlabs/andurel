package handlers

import (
	"context"

	"{{.ModuleName}}/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
)

type APIHandler struct {
	health anduin.Handler
}

func NewAPIHandler(health interface{ Health(context.Context) error }) APIHandler {
	return APIHandler{health: anduin.Health(health)}
}

func (a APIHandler) Register(rt *anduin.Router) {
	rt.Get(routes.Health.Pattern(), a.health)
}
