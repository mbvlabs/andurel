package handlers

import (
	"context"
	"errors"
	"net/http"

	"{{.ModuleName}}/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
)

// APIHandler exposes the JSON API surface. It is mounted under routes.APIPrefix.
type APIHandler struct {
	health healthChecker
}

// healthChecker is the only database capability the API surface needs. It
// has no query methods, so handlers cannot issue raw database calls.
type healthChecker interface {
	Health(ctx context.Context) error
}

func NewAPIHandler(health healthChecker) APIHandler {
	return APIHandler{health: health}
}

func (a APIHandler) Register(rt *anduin.Router) {
	rt.Get(routes.Health.Path(), a.Health)
}

func (a APIHandler) Health(ctx context.Context) error {
	if err := a.health.Health(ctx); err != nil {
		return anduin.Error(
			ctx,
			http.StatusServiceUnavailable,
			errors.New("database is unavailable"),
		)
	}

	return anduin.JSON(ctx, http.StatusOK, "app is healthy and running")
}
