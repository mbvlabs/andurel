package handlers

import (
	"fmt"
	"io/fs"

	"{{.ModuleName}}/assets"
	"{{.ModuleName}}/config"
	"{{.ModuleName}}/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
)

// AssetsHandler serves embedded files. The embedded files are fixed at build
// time, so robots.txt, the sitemap and every ETag are computed once at startup.
type AssetsHandler struct {
	robots  anduin.Handler
	sitemap anduin.Handler
	dist    anduin.Handler
}

func NewAssetsHandler(appCfg config.App) (AssetsHandler, error) {
	dist, err := fs.Sub(assets.Files, "dist")
	if err != nil {
		return AssetsHandler{}, fmt.Errorf("assets: dist: %w", err)
	}

	sitemap, err := anduin.Sitemap(anduin.SitemapURL{
		Loc:        appCfg.BaseURL(),
		ChangeFreq: "monthly",
		Priority:   "1",
	})
	if err != nil {
		return AssetsHandler{}, fmt.Errorf("assets: sitemap: %w", err)
	}

	distHandler, err := anduin.StaticFS(dist, anduin.Immutable(appCfg.IsProduction()))
	if err != nil {
		return AssetsHandler{}, fmt.Errorf("assets: static files: %w", err)
	}

	return AssetsHandler{
		robots:  anduin.RobotsTxt(appCfg.BaseURL() + routes.Sitemap.URL()),
		sitemap: sitemap,
		dist:    distHandler,
	}, nil
}

func (a AssetsHandler) Register(rt *anduin.Router) {
	rt.Get(routes.Robots.Path(), a.robots)
	rt.Get(routes.Sitemap.Path(), a.sitemap)
	rt.Get(routes.ViteBuild.Path(), a.dist)
}
