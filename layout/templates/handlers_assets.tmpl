package handlers

import (
	"context"
	"crypto/md5"
	"encoding/xml"
	"errors"
	"fmt"
	"net/http"
	"path"
	"strings"
	"time"

	"{{.ModuleName}}/assets"
	"{{.ModuleName}}/config"
	"{{.ModuleName}}/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/cache"
	"github.com/mbvlabs/andurel/pkg/routing"
	"github.com/mbvlabs/andurel/pkg/telemetry"
)

const threeMonthsCache = "7776000"

// assetCacheTTL bounds rendered-asset entries. Content hashes make entries
// immutable, so a long TTL is safe: new content hashes to a new key.
const assetCacheTTL = 15 * time.Minute

// Assets serves the layout's CSS, JavaScript, Vite build output, robots.txt,
// and sitemap.xml. Static files are read from the embedded assets filesystem.
type Assets struct {
	cache  cache.Store
	appCfg config.App
}

func NewAssets(store cache.Store, appCfg config.App) Assets {
	return Assets{cache: store, appCfg: appCfg}
}

func (a Assets) Register(rt *anduin.Router) {
	rt.Get(routes.Robots.Path(), a.Robots)
	rt.Get(routes.Sitemap.Path(), a.Sitemap)
	rt.Get(routes.Stylesheet.Path(), a.Stylesheet)
	rt.Get(routes.Scripts.Path(), a.Scripts)
	rt.Get(routes.Script.Path(), a.Script)
	rt.Get(routes.ViteBuild.Path(), a.ViteBuild)
}

// enableCaching writes the production cache headers for an asset and reports
// whether the request is already satisfied by a 304 Not Modified. The ETag is
// a content hash cached under the asset key.
func (a Assets) enableCaching(
	ctx context.Context,
	cacheKey string,
	content []byte,
) (bool, error) {
	if !a.appCfg.IsProduction() {
		return false, nil
	}

	etag, err := cache.Remember(ctx, a.cache, "etag:"+cacheKey, assetCacheTTL, func(ctx context.Context) (string, error) {
		//nolint:gosec //only needed for browser caching
		hash := md5.Sum(content)
		return fmt.Sprintf(`"%x-%x"`, hash, len(content)), nil
	})
	if err != nil {
		//nolint:gosec //only needed for browser caching
		hash := md5.Sum(content)
		etag = fmt.Sprintf(`"%x-%x"`, hash, len(content))
	}

	anduin.SetHeader(ctx, "ETag", etag)
	anduin.SetHeader(
		ctx,
		"Cache-Control",
		fmt.Sprintf("public, max-age=%s, immutable", threeMonthsCache),
	)

	if match := anduin.Header(ctx, "If-None-Match"); match == etag {
		return true, anduin.NoContent(ctx, http.StatusNotModified)
	}

	anduin.SetHeader(ctx, "Vary", "Accept-Encoding")

	return false, nil
}

func createRobotsTxt(baseURL string) string {
	return fmt.Sprintf(
		"User-agent: *\nAllow: /\nSitemap: %s%s\n",
		baseURL,
		routes.Sitemap.URL(),
	)
}

func (a Assets) Robots(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "assets.robots")
	defer span.End()

	cacheKey := "assets:robots"

	robotsTxt, err := cache.Remember(ctx, a.cache, cacheKey, assetCacheTTL, func(ctx context.Context) (string, error) {
		return createRobotsTxt(a.appCfg.BaseURL()), nil
	})
	if err != nil {
		telemetry.Error(
			ctx,
			"failed to get robots.txt from cache",
			"error", err,
		)
		return anduin.Text(ctx, http.StatusOK, createRobotsTxt(a.appCfg.BaseURL()))
	}

	return anduin.Text(ctx, http.StatusOK, robotsTxt)
}

func (a Assets) Sitemap(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "assets.sitemap")
	defer span.End()

	cacheKey := "assets:sitemap"

	sitemap, err := cache.Remember(ctx, a.cache, cacheKey, assetCacheTTL, func(ctx context.Context) (string, error) {
		return createSitemap(a.appCfg.BaseURL(), nil)
	})
	if err != nil {
		telemetry.Error(
			ctx,
			"failed to get sitemap from cache",
			"error", err,
		)

		result, buildErr := createSitemap(a.appCfg.BaseURL(), nil)
		if buildErr != nil {
			return buildErr
		}

		return writeContent(ctx, http.StatusOK, "application/xml", []byte(result))
	}

	return writeContent(ctx, http.StatusOK, "application/xml", []byte(sitemap))
}

// URL is one <url> entry in the sitemap.
type URL struct {
	XMLName    xml.Name `xml:"url"`
	Loc        string   `xml:"loc"`
	ChangeFreq string   `xml:"changefreq"`
	LastMod    string   `xml:"lastmod,omitempty"`
	Priority   string   `xml:"priority,omitempty"`
}

// Sitemap is the <urlset> document.
type Sitemap struct {
	XMLName xml.Name `xml:"urlset"`
	XMLNS   string   `xml:"xmlns,attr"`
	URL     []URL    `xml:"url"`
}

func createSitemap(baseURL string, _ []routing.Route) (string, error) {
	urls := []URL{
		{
			Loc:        baseURL,
			ChangeFreq: "monthly",
			LastMod:    "2024-10-22T09:43:09+00:00",
			Priority:   "1",
		},
	}

	sitemap := Sitemap{
		XMLNS: "http://www.sitemaps.org/schemas/sitemap/0.9",
		URL:   urls,
	}

	xmlBytes, err := xml.MarshalIndent(sitemap, "", "  ")
	if err != nil {
		return "", err
	}

	return xml.Header + string(xmlBytes), nil
}

func (a Assets) Stylesheet(ctx context.Context) error {
	stylesheet, err := assets.Files.ReadFile("css/style.css")
	if err != nil {
		return err
	}

	if handled, cacheErr := a.enableCaching(ctx, "css/style.css", stylesheet); handled || cacheErr != nil {
		return cacheErr
	}

	return writeContent(ctx, http.StatusOK, "text/css", stylesheet)
}

func (a Assets) Scripts(ctx context.Context) error {
	script, err := assets.Files.ReadFile("js/scripts.js")
	if err != nil {
		return err
	}

	if handled, cacheErr := a.enableCaching(ctx, "js/scripts.js", script); handled || cacheErr != nil {
		return cacheErr
	}

	return writeContent(ctx, http.StatusOK, "application/javascript", script)
}

func (a Assets) Script(ctx context.Context) error {
	param := path.Clean(anduin.PathValue(ctx, "file"))
	if param == "." || param == "" || strings.HasPrefix(param, "../") {
		return anduin.NotFound(errors.New(http.StatusText(http.StatusNotFound)))
	}

	file := fmt.Sprintf("js/%s", param)
	script, err := assets.Files.ReadFile(file)
	if err != nil {
		return anduin.NotFound(errors.New(http.StatusText(http.StatusNotFound)))
	}

	if handled, cacheErr := a.enableCaching(ctx, file, script); handled || cacheErr != nil {
		return cacheErr
	}

	return writeContent(ctx, http.StatusOK, "application/javascript", script)
}

func (a Assets) ViteBuild(ctx context.Context) error {
	param := strings.TrimPrefix(anduin.PathValue(ctx, "path"), "/")
	param = path.Clean(param)
	if param == "." || param == "" || strings.HasPrefix(param, "../") {
		return anduin.NotFound(errors.New(http.StatusText(http.StatusNotFound)))
	}

	file := fmt.Sprintf("dist/%s", param)
	data, err := assets.Files.ReadFile(file)
	if err != nil {
		return anduin.NotFound(errors.New(http.StatusText(http.StatusNotFound)))
	}

	if handled, cacheErr := a.enableCaching(ctx, file, data); handled || cacheErr != nil {
		return cacheErr
	}

	return writeContent(ctx, http.StatusOK, contentTypeByExt(param), data)
}

// writeContent writes an arbitrary content type; anduin's helpers cover JSON,
// text, and HTML but assets also need CSS, JavaScript, and XML.
func writeContent(
	ctx context.Context,
	status int,
	contentType string,
	body []byte,
) error {
	writer := anduin.ResponseWriter(ctx)
	if writer == nil {
		return anduin.Error(
			ctx,
			http.StatusInternalServerError,
			errors.New("assets: no response writer on context"),
		)
	}

	writer.Header().Set("Content-Type", contentType)
	writer.WriteHeader(status)
	if len(body) == 0 {
		return nil
	}

	if _, err := writer.Write(body); err != nil {
		return anduin.Error(ctx, http.StatusInternalServerError, err)
	}

	return nil
}

func contentTypeByExt(name string) string {
	switch {
	case strings.HasSuffix(name, ".js"):
		return "application/javascript"
	case strings.HasSuffix(name, ".css"):
		return "text/css"
	case strings.HasSuffix(name, ".json"):
		return "application/json"
	case strings.HasSuffix(name, ".svg"):
		return "image/svg+xml"
	case strings.HasSuffix(name, ".woff2"):
		return "font/woff2"
	case strings.HasSuffix(name, ".woff"):
		return "font/woff"
	case strings.HasSuffix(name, ".ttf"):
		return "font/ttf"
	case strings.HasSuffix(name, ".otf"):
		return "font/otf"
	default:
		return "application/octet-stream"
	}
}
