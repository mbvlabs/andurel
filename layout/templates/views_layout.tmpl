package views

import (
	"time"

	"{{.ModuleName}}/router/routes"
)

templ base(headOpts ...HeadDataOption) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		@SetupHead(ctx, headOpts...)
		<body class="min-h-screen flex flex-col bg-background text-foreground">
			<header>
				<div class="mx-auto flex w-full max-w-[960px] items-center justify-between px-4 py-3">
					<a class="inline-flex items-center gap-3 text-sm font-semibold text-card-foreground" href={ routes.HomePage.URL() }>
						<span class="grid size-8 grid-cols-2 gap-1 border border-border bg-card p-1 shadow-sm shadow-black/40">
							<span class="border border-ring"></span>
							<span class="border border-border"></span>
							<span class="border border-border"></span>
							<span class="bg-ring"></span>
						</span>
						<span>Andurel.</span>
					</a>
					<nav class="flex flex-wrap items-center justify-end gap-3 text-sm">
						<a class="px-2 py-1 text-muted-foreground transition hover:text-card-foreground" href="https://andurel.com">Documentation</a>
						<a class="px-2 py-1 text-muted-foreground transition hover:text-card-foreground" href={ routes.SessionNew.URL() }>Log in</a>
						<a class="px-2 py-1 text-muted-foreground transition hover:text-card-foreground" href={ routes.RegistrationNew.URL() }>Register</a>
					</nav>
				</div>
			</header>
			{ children... }
			<footer>
				<div class="mx-auto w-full max-w-[960px] px-4 py-3 text-center text-sm text-muted-foreground">
					&copy; { time.Now().Format("2006") } andurel.
				</div>
			</footer>
		</body>
	</html>
}
