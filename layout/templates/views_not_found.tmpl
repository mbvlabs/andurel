package views

templ NotFound() {
	@base() {
		<section class="flex flex-1 items-center justify-center px-6 py-6">
			<div class="w-full max-w-md border border-border bg-card/90 p-6 text-center shadow-sm shadow-black/40">
				<p class="text-sm font-medium uppercase tracking-wide text-ring">404</p>
				<h1 class="mt-2 text-2xl font-semibold text-card-foreground">Not found</h1>
				<p class="mt-3 text-sm leading-6 text-muted-foreground">The page you are looking for could not be found.</p>
			</div>
		</section>
	}
}
