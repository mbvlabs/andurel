package config

import (
	"context"
	"fmt"

	{{- if hasExtension .Extensions "aws-ses"}}
	mailclients "{{.ModuleName}}/clients/email"
	{{- end}}

	"github.com/mbvlabs/andurel/pkg/email"
)

const (
	DefaultEmailProvider    = "mailpit"
	DefaultEmailMailpitHost = "0.0.0.0"
	DefaultEmailMailpitPort = "1025"
)

type emailConfig struct {
	provider    string
	mailpitHost string
	mailpitPort string
}

func (c *Config) setupEmail() error {
	cfg := emailConfig{
		provider:    envOr("EMAIL_PROVIDER", DefaultEmailProvider),
		mailpitHost: envOr("MAILPIT_HOST", DefaultEmailMailpitHost),
		mailpitPort: envOr("MAILPIT_PORT", DefaultEmailMailpitPort),
	}
	if c.IsProduction() {
		{{- if hasExtension .Extensions "aws-ses"}}
		cfg.provider = "aws-ses"
		{{- else}}
		cfg.provider = ""
		{{- end}}
	}
	if err := cfg.validate(); err != nil {
		return err
	}
	c.email = cfg

	return nil
}

func (c emailConfig) validate() error {
	switch c.provider {
	case "mailpit":
		return email.MailpitConfig{Host: c.mailpitHost, Port: c.mailpitPort}.Validate()
		{{- if hasExtension .Extensions "aws-ses"}}
	case "aws-ses":
		return nil
		{{- end}}
	default:
		return fmt.Errorf(
			"config: choose an installed email provider in config/email.go (got %q)",
			c.provider,
		)
	}
}

func (c *Config) EmailProvider() string { return c.email.provider }

func (c *Config) MailpitHost() string { return c.email.mailpitHost }

func (c *Config) MailpitPort() string { return c.email.mailpitPort }

func (c *Config) EmailSenders(
	{{- if hasExtension .Extensions "aws-ses"}}
	ctx context.Context,
	{{- else}}
	_ context.Context,
	{{- end}}
) (email.TransactionalSender, email.MarketingSender, error) {
	switch c.email.provider {
	case "mailpit":
		client, err := email.NewMailpit(email.MailpitConfig{
			Host: c.email.mailpitHost,
			Port: c.email.mailpitPort,
		})
		if err != nil {
			return nil, nil, fmt.Errorf("config: create Mailpit client: %w", err)
		}

		return client, client, nil
		{{- if hasExtension .Extensions "aws-ses"}}
	case "aws-ses":
		client, err := mailclients.NewAwsSes(ctx, c)
		if err != nil {
			return nil, nil, err
		}

		return client, client, nil
		{{- end}}
	default:
		return nil, nil, fmt.Errorf(
			"config: unsupported email provider %q; configure an email provider in config/email.go",
			c.email.provider,
		)
	}
}
