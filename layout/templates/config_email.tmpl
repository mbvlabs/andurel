package config

type EmailCfg struct {
	MailpitHost string
	MailpitPort string
}

func NewEmailCfg() EmailCfg {
	return EmailCfg{
		MailpitHost: "0.0.0.0",
		MailpitPort: "1025",
	}
}

func (c *EmailCfg) WithMailpitHost(host string) { c.MailpitHost = host }
func (c *EmailCfg) WithMailpitPort(port string) { c.MailpitPort = port }
