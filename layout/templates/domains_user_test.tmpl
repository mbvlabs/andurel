	}

	found, err := users.Find(t.Context(), created.ID)
	if err != nil {
		t.Fatalf("find: %v", err)
	}
	if found.EmailValidatedAt != nil {
		t.Fatalf("stored email validated at = %v, want SQL NULL", found.EmailValidatedAt)
	}
}

