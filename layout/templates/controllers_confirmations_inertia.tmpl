package auth

import (
	"context"
	"net/http"
	"uuid"

	"{{.ModuleName}}/middleware"
	"{{.ModuleName}}/routes"
	"{{.ModuleName}}/services"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/kiks"
	"github.com/mbvlabs/andurel/pkg/telemetry"
)

func (h Handler) ConfirmationNew(ctx context.Context) error {
	return h.renderer.Page(ctx, "Auth/ConfirmEmail", inertia.Props{}).Render()
}

func (h Handler) ConfirmationCreate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "confirmations.create")
	defer span.End()

	var payload struct {
		Code string `json:"code"`
	}

	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		telemetry.Error(
			ctx,
			"could not parse verification form payload",
			"error",
			err,
		)
		return h.renderer.Page(ctx, "Errors/BadRequest", inertia.Props{}).Render()
	}

	user, err := h.identity.VerifyEmail(
		ctx,
		services.VerifyEmailData{
			UserID: pendingUserID(ctx),
			Code:   payload.Code,
		},
	)
	if err != nil {
		if fields, ok := validationFields(err); ok {
			return h.renderer.Page(
				ctx,
				"Auth/ConfirmEmail",
				inertia.Props{},
			).ValidationErrors(fields).Render()
		}

		telemetry.Error(
			ctx,
			"failed to verify email",
			"error",
			err,
		)

		return h.renderer.Redirect(
			ctx,
			routes.ConfirmationNew.URL(),
			http.StatusSeeOther,
		)
	}

	if err := kiks.Set(ctx, &middleware.App{
		UserID:          user.ID.String(),
		IsAdmin:         user.IsAdmin,
		IsAuthenticated: true,
	}); err != nil {
		return err
	}

	return h.renderer.Location(ctx, routes.HomePage.URL())
}

// pendingUserID reads the user awaiting confirmation from the session. Invalid
// or absent state yields uuid.Nil, which the service treats as an invalid code.
func pendingUserID(ctx context.Context) uuid.UUID {
	app, err := kiks.Get[*middleware.App](ctx)
	if err != nil || app == nil || app.PendingUserID == "" {
		return uuid.Nil()
	}

	userID, err := uuid.Parse(app.PendingUserID)
	if err != nil {
		return uuid.Nil()
	}

	return userID
}
