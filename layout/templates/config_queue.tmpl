package config

import (
	"time"

	"github.com/riverqueue/river"
)

// QueueCfg contains River queue settings used by the application.
type QueueCfg struct {
	AdvisoryLockPrefix          int32
	CancelledJobRetentionPeriod time.Duration
	CompletedJobRetentionPeriod time.Duration
	DiscardedJobRetentionPeriod time.Duration
	FetchCooldown               time.Duration
	PollInterval                time.Duration
	ID                          string
	JobCleanerTimeout           time.Duration
	JobStuckThreshold           time.Duration
	JobTimeout                  time.Duration
	MaxAttempts                 int
	MaxWorkers                  int
	PollOnly                    bool
	ReindexerIndexNames         []string
	ReindexerTimeout            time.Duration
	RescueStuckJobsAfter        time.Duration
	Schema                      string
	SoftStopTimeout             time.Duration
	SkipJobKindValidation       bool
	SkipUnknownJobCheck         bool
}

func NewQueueCfg() QueueCfg {
	return QueueCfg{
		AdvisoryLockPrefix:          0,
		CancelledJobRetentionPeriod: 24 * time.Hour,
		CompletedJobRetentionPeriod: 24 * time.Hour,
		DiscardedJobRetentionPeriod: 168 * time.Hour,
		FetchCooldown:               100 * time.Millisecond,
		PollInterval:                1 * time.Second,
		ID:                          "",
		JobCleanerTimeout:           30 * time.Second,
		JobStuckThreshold:           10 * time.Second,
		JobTimeout:                  1 * time.Minute,
		MaxAttempts:                 25,
		MaxWorkers:                  100,
		PollOnly:                    false,
		ReindexerIndexNames: []string{
			"river_job_args_index",
			"river_job_kind",
			"river_job_metadata_index",
			"river_job_pkey",
			"river_job_prioritized_fetching_index",
			"river_job_state_and_finalized_at_index",
			"river_job_unique_idx",
		},
		ReindexerTimeout:     1 * time.Minute,
		RescueStuckJobsAfter: 1 * time.Hour,
		Schema:               "",
		SoftStopTimeout:      0,
		SkipJobKindValidation: false,
		SkipUnknownJobCheck:  false,
	}
}

func (cfg QueueCfg) RiverConfig() river.Config {
	return river.Config{
		AdvisoryLockPrefix:          cfg.AdvisoryLockPrefix,
		CancelledJobRetentionPeriod: cfg.CancelledJobRetentionPeriod,
		CompletedJobRetentionPeriod: cfg.CompletedJobRetentionPeriod,
		DiscardedJobRetentionPeriod: cfg.DiscardedJobRetentionPeriod,
		FetchCooldown:               cfg.FetchCooldown,
		FetchPollInterval:           cfg.PollInterval,
		ID:                          cfg.ID,
		JobCleanerTimeout:           cfg.JobCleanerTimeout,
		JobStuckThreshold:           cfg.JobStuckThreshold,
		JobTimeout:                  cfg.JobTimeout,
		MaxAttempts:                 cfg.MaxAttempts,
		PollOnly:                    cfg.PollOnly,
		ReindexerIndexNames:         cfg.ReindexerIndexNames,
		ReindexerTimeout:            cfg.ReindexerTimeout,
		RescueStuckJobsAfter:        cfg.RescueStuckJobsAfter,
		Schema:                      cfg.Schema,
		SoftStopTimeout:             cfg.SoftStopTimeout,
		SkipJobKindValidation:       cfg.SkipJobKindValidation,
		SkipUnknownJobCheck:         cfg.SkipUnknownJobCheck,
	}
}

func (c *QueueCfg) WithAdvisoryLockPrefix(prefix int32)          { c.AdvisoryLockPrefix = prefix }
func (c *QueueCfg) WithCancelledJobRetentionPeriod(d time.Duration) { c.CancelledJobRetentionPeriod = d }
func (c *QueueCfg) WithCompletedJobRetentionPeriod(d time.Duration) { c.CompletedJobRetentionPeriod = d }
func (c *QueueCfg) WithDiscardedJobRetentionPeriod(d time.Duration) { c.DiscardedJobRetentionPeriod = d }
func (c *QueueCfg) WithFetchCooldown(d time.Duration)            { c.FetchCooldown = d }
func (c *QueueCfg) WithPollInterval(d time.Duration)             { c.PollInterval = d }
func (c *QueueCfg) WithID(id string)                             { c.ID = id }
func (c *QueueCfg) WithJobCleanerTimeout(d time.Duration)        { c.JobCleanerTimeout = d }
func (c *QueueCfg) WithJobStuckThreshold(d time.Duration)        { c.JobStuckThreshold = d }
func (c *QueueCfg) WithJobTimeout(d time.Duration)               { c.JobTimeout = d }
func (c *QueueCfg) WithMaxAttempts(n int)                        { c.MaxAttempts = n }
func (c *QueueCfg) WithMaxWorkers(n int)                         { c.MaxWorkers = n }
func (c *QueueCfg) WithPollOnly(b bool)                          { c.PollOnly = b }
func (c *QueueCfg) WithReindexerIndexNames(names []string)       { c.ReindexerIndexNames = names }
func (c *QueueCfg) WithReindexerTimeout(d time.Duration)         { c.ReindexerTimeout = d }
func (c *QueueCfg) WithRescueStuckJobsAfter(d time.Duration)     { c.RescueStuckJobsAfter = d }
func (c *QueueCfg) WithSchema(schema string)                     { c.Schema = schema }
func (c *QueueCfg) WithSoftStopTimeout(d time.Duration)          { c.SoftStopTimeout = d }
func (c *QueueCfg) WithSkipJobKindValidation(b bool)             { c.SkipJobKindValidation = b }
func (c *QueueCfg) WithSkipUnknownJobCheck(b bool)               { c.SkipUnknownJobCheck = b }
