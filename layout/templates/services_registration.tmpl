package services

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"time"
	"uuid"

	appemail "{{.ModuleName}}/email"
	"{{.ModuleName}}/models"
	"{{.ModuleName}}/queue/jobs"

	"github.com/jackc/pgx/v5/pgtype"

	"github.com/mbvlabs/andurel/pkg/email"
	"github.com/mbvlabs/andurel/pkg/telemetry"
	"github.com/mbvlabs/andurel/pkg/validation"
)

const userEmailVerification = "user_email_verification"

type RegisterUserData struct {
	Email           string
	Password        string
	ConfirmPassword string
}

func (i Identity) RegisterUser(
	ctx context.Context,
	data RegisterUserData,
) (models.User, error) {
	b := validation.NewBuilder()
	b.Required("email", data.Email)
	b.Required("password", data.Password)
	b.MinLen("password", data.Password, 8)
	b.Required("confirmPassword", data.ConfirmPassword)
	if data.Password != data.ConfirmPassword {
		b.Add("confirmPassword", "mismatch", "Passwords do not match")
	}
	if !b.Errors().Empty() {
		return models.User{}, b.Errors()
	}

	tx, err := i.db.BeginTransaction(ctx)

	if err != nil {

		return models.User{}, fmt.Errorf("begin registration transaction: %w", err)

	}

	users := i.users.WithTx(tx)
	tokens := i.tokens.WithTx(tx)

	user, err := users.Create(ctx, i.pepper, models.CreateUserData{

		Email: data.Email,
		PasswordPair: models.PasswordPair{
			Password:        data.Password,
			ConfirmPassword: data.ConfirmPassword,
		},
	})
	if err != nil {
		_ = tx.Rollback(ctx)

		return models.User{}, fmt.Errorf("create user: %w", err)
	}

	code, err := i.issueVerificationCode(ctx, tokens, user)
	if err != nil {
		_ = tx.Rollback(ctx)

		return models.User{}, err
	}

	if err := tx.Commit(ctx); err != nil {

		return models.User{}, fmt.Errorf("commit registration transaction: %w", err)

	}

	if err := i.sendVerificationEmail(ctx, user, code); err != nil {
		return user, err
	}

	telemetry.Set(ctx, "user.id", user.ID, "registration.email_queued", true)
	return user, nil

}

// ResendEmailVerification replaces any outstanding verification code for an
// unverified user with a fresh one and emails it. It is how a user recovers
// after losing the registering session or exhausting their attempts.
func (i Identity) ResendEmailVerification(
	ctx context.Context,
	user models.User,
) error {
	if user.HasValidatedEmail() {
		return nil
	}

	tx, err := i.db.BeginTransaction(ctx)

	if err != nil {

		return fmt.Errorf("begin resend verification transaction: %w", err)

	}

	tokens := i.tokens.WithTx(tx)

	if err := tokens.DestroyByUserAndScope(ctx, user.ID, userEmailVerification); err != nil {
		_ = tx.Rollback(ctx)

		return fmt.Errorf("destroy previous verification tokens: %w", err)
	}

	code, err := i.issueVerificationCode(ctx, tokens, user)
	if err != nil {
		_ = tx.Rollback(ctx)

		return err
	}

	if err := tx.Commit(ctx); err != nil {

		return fmt.Errorf("commit resend verification transaction: %w", err)

	}

	if err := i.sendVerificationEmail(ctx, user, code); err != nil {
		return err
	}

	telemetry.Set(ctx, "user.id", user.ID, "registration.email_requeued", true)
	return nil
}

func (i Identity) issueVerificationCode(
	ctx context.Context,
	tokens models.Tokens,
	user models.User,
) (string, error) {
	meta, err := json.Marshal(map[string]string{
		"email": user.Email,
	})
	if err != nil {
		return "", fmt.Errorf("marshal verification token metadata: %v", err)
	}

	code, err := tokens.CreateCode(
		ctx,
		i.tokenSigningKey,

		userEmailVerification,
		time.Now().Add(24*time.Hour),
		meta,
		user.ID,
	)
	if err != nil {
		return "", fmt.Errorf("create verification token: %w", err)
	}

	return code, nil
}

func (i Identity) sendVerificationEmail(
	ctx context.Context,
	user models.User,
	code string,
) error {
	vEmail := appemail.VerifyEmail{VerificationCode: code}

	html, err := vEmail.ToHTML()
	if err != nil {
		return fmt.Errorf("render verification email html: %v", err)
	}

	text, err := vEmail.ToText()
	if err != nil {
		return fmt.Errorf("render verification email text: %v", err)
	}

	_, err = i.insertOnly.Insert(ctx, jobs.SendTransactionalEmailArgs{

		Data: email.TransactionalData{
			To:       user.Email,
			From:     i.defaultSenderSignature,
			Subject:  "Verify Your Email Address",
			HTMLBody: html,
			TextBody: text,
		},
	}, nil)

	if err != nil {
		return fmt.Errorf("queue verification email: %v", err)
	}

	return nil
}

var (
	ErrInvalidVerificationCode = errors.New("invalid or expired verification code")
	ErrUserNotFound            = errors.New("user not found")
)

const (
	maxVerificationAttempts        = 5
	invalidVerificationCodeMessage = "Invalid or expired code. Sign in to get a new one."
)

type VerifyEmailData struct {
	UserID uuid.UUID
	Code   string
}

func invalidVerificationCode() error {
	b := validation.NewBuilder()
	b.Add("code", "invalid", invalidVerificationCodeMessage)

	return errors.Join(ErrInvalidVerificationCode, b.Errors())
}

// verificationAttemptAllowed reports whether the attempt numbered attempts
// (1-based, as returned by Tokens.IncrementAttempts) may be checked.
func verificationAttemptAllowed(attempts int32) bool {
	return attempts <= maxVerificationAttempts
}

// verificationLocked reports whether a failed attempt numbered attempts
// exhausts the code.
func verificationLocked(attempts int32) bool {
	return attempts >= maxVerificationAttempts
}

func (i Identity) VerifyEmail(
	ctx context.Context,
	data VerifyEmailData,
) (models.User, error) {
	b := validation.NewBuilder()
	b.Required("code", data.Code)
	if !b.Errors().Empty() {
		return models.User{}, b.Errors()
	}

	if data.UserID == uuid.Nil() {
		return models.User{}, invalidVerificationCode()
	}

	tx, err := i.db.BeginTransaction(ctx)

	if err != nil {

		return models.User{}, fmt.Errorf("begin email verification transaction: %w", err)

	}

	users := i.users.WithTx(tx)
	tokens := i.tokens.WithTx(tx)

	token, err := tokens.FindByUserAndScope(
		ctx,
		data.UserID,

		userEmailVerification,
	)
	if err != nil {
		_ = tx.Rollback(ctx)

		if errors.Is(err, models.ErrNotFound) {
			return models.User{}, invalidVerificationCode()
		}

		return models.User{}, fmt.Errorf("find email verification token: %w", err)

	}

	// Count the attempt before checking the code. The UPDATE takes the row
	// lock, so concurrent attempts are serialized and each sees its own count;
	// once the code is locked out, later attempts find no row.
	attempts, err := tokens.IncrementAttempts(ctx, token.ID)
	if err != nil {
		_ = tx.Rollback(ctx)

		if errors.Is(err, models.ErrNotFound) {
			return models.User{}, invalidVerificationCode()
		}

		return models.User{}, fmt.Errorf("record verification attempt: %w", err)
	}

	if !verificationAttemptAllowed(attempts) ||
		!token.IsValid(data.Code, i.tokenSigningKey) {

		if verificationLocked(attempts) {
			if err := tokens.Destroy(ctx, token.ID); err != nil {
				_ = tx.Rollback(ctx)

				return models.User{}, fmt.Errorf("destroy locked verification token: %w", err)
			}
		}

		if err := tx.Commit(ctx); err != nil {

			return models.User{}, fmt.Errorf("commit failed verification attempt: %w", err)
		}

		return models.User{}, invalidVerificationCode()
	}

	user, err := users.Find(ctx, data.UserID)
	if err != nil {
		_ = tx.Rollback(ctx)

		if errors.Is(err, models.ErrNotFound) {
			return models.User{}, ErrUserNotFound
		}

		return models.User{}, fmt.Errorf("find verification user: %w", err)

	}

	now := time.Now()
	user, err = users.Update(ctx, models.UpdateUserData{
		ID:               user.ID,
		Email:            user.Email,
		EmailValidatedAt: pgtype.Timestamptz{Time: now, Valid: true},
		Password:         user.Password,
		IsAdmin:          user.IsAdmin,
	})
	if err != nil {
		_ = tx.Rollback(ctx)

		if errors.Is(err, models.ErrNotFound) {
			return models.User{}, ErrUserNotFound
		}

		return models.User{}, fmt.Errorf("mark user email verified: %w", err)

	}

	if err := tokens.Destroy(ctx, token.ID); err != nil {
		_ = tx.Rollback(ctx)

		return models.User{}, fmt.Errorf("destroy email verification token: %w", err)

	}

	if err := tx.Commit(ctx); err != nil {

		return models.User{}, fmt.Errorf("commit email verification transaction: %w", err)
	}

	return user, nil
}
