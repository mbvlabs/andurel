package views

import (
	"net/http"
	"github.com/mbvlabs/andurel/pkg/hypermedia"
	"github.com/mbvlabs/andurel/pkg/validation"
	"{{.ModuleName}}/router/routes"
)

type RegistrationForm struct {
	Errors validation.ValidationErrors
}

func (rf RegistrationForm) FieldError(field string) string {
	return rf.Errors.ToMap()[field]
}

func (rf RegistrationForm) PageFragment() string {
	return "registration-page-fragment"
}

templ (rf RegistrationForm) Page() {
	@base() {
		@templ.Fragment(rf.PageFragment()) {
			<main id="registration-container" class="flex flex-1 items-center justify-center px-6 py-6">
				<div class="mx-auto flex w-full max-w-md flex-col gap-6">
					<div class="border border-border bg-card/90 shadow-sm shadow-black/40">
						<div class="flex flex-col space-y-1.5 p-6 pb-0">
							<h2 class="text-xl font-semibold text-card-foreground">Create an account</h2>
							<p class="text-sm text-muted-foreground">Enter your details below to create your account</p>
						</div>
						<div class="p-6">
							<form class="space-y-5" data-indicator:_submitting data-on:submit={ hypermedia.DataAction(http.MethodPost, routes.RegistrationCreate.URL()) }>
								<fieldset class="space-y-5 border-0 p-0" data-attr:disabled="$_submitting">
									<div class="space-y-1">
										<label class="text-sm font-medium leading-none text-muted-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="email">Email</label>
										<input id="email" type="email" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-sm text-foreground shadow-inner shadow-black/35 transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 disabled:cursor-not-allowed disabled:opacity-60" data-bind="email" required/>
										if rf.FieldError("email") != "" {
											<p id="email-error" class="text-sm font-medium text-destructive" role="alert">{ rf.FieldError("email") }</p>
										}
									</div>
									<div class="space-y-1">
										<label class="text-sm font-medium leading-none text-muted-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="password">Password</label>
										<input id="password" type="password" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-sm text-foreground shadow-inner shadow-black/35 transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 disabled:cursor-not-allowed disabled:opacity-60" data-bind="password" required/>
										if rf.FieldError("password") != "" {
											<p id="password-error" class="text-sm font-medium text-destructive" role="alert">{ rf.FieldError("password") }</p>
										}
									</div>
									<div class="space-y-1">
										<label class="text-sm font-medium leading-none text-muted-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="confirmPassword">Confirm Password</label>
										<input id="confirmPassword" type="password" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-sm text-foreground shadow-inner shadow-black/35 transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 disabled:cursor-not-allowed disabled:opacity-60" data-bind="confirmPassword" required/>
										if rf.FieldError("confirmPassword") != "" {
											<p id="confirm-password-error" class="text-sm font-medium text-destructive" role="alert">{ rf.FieldError("confirmPassword") }</p>
										}
									</div>
									<button type="submit" class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm shadow-black/40 transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:cursor-not-allowed disabled:opacity-60">
										<span data-show="!$_submitting">Sign Up</span>
										<span data-show="$_submitting">Loading</span>
									</button>
								</fieldset>
							</form>
							<p class="mt-6 text-center text-sm text-muted-foreground">
								Already have an account? <a class="text-foreground hover:text-card-foreground hover:underline" href={ routes.SessionNew.URL() }>Login</a>
							</p>
						</div>
					</div>
				</div>
			</main>
		}
	}
}
