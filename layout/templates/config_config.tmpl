// Package config provides application-wide configuration settings.
package config

import (
	"os"

	"go.uber.org/fx"
)

const (
	DefaultEnvironment = "development"
	DefaultProjectName = "{{.ProjectName}}"
)

var Environment = func() string {
	if env := os.Getenv("ENVIRONMENT"); env != "" {
		return env
	}

	return DefaultEnvironment
}

var ProjectName = func() string {
	if projectName := os.Getenv("PROJECT_NAME"); projectName != "" {
		return projectName
	}

	return DefaultProjectName
}

// Module provides all application configuration constructors to the dependency container.
var Module = fx.Module("config",
	fx.Provide(
		NewAppCfg,
		NewDatabaseCfg,
		NewQueueCfg,
		NewTelemetryCfg,
		NewEmailSenders,
{{- if .Inertia}}
		NewInertiaCfg,
{{- end}}
{{- range .Blueprint.Config.SortedFields}}
		New{{.Name}}Cfg,
{{- end}}
	),
)
