// Package config provides application-wide configuration settings.
package config

import "go.uber.org/fx"

type Config struct {
	App       app
	DB        databaseCfg
	Queue     queueCfg
	Telemetry telemetry
{{- if .Inertia}}
	Inertia inertiaCfg
{{- end}}
{{- range .Blueprint.Config.SortedFields}}
	{{.Name}} {{.Type}}
{{- end}}
}

func NewConfig() Config {
	return Config{
		App:       newAppConfig(),
		DB:        newDatabaseConfig(),
		Queue:     newQueueConfig(),
		Telemetry: newTelemetryConfig(),
{{- if .Inertia}}
		Inertia:   newInertiaConfig(),
{{- end}}
{{- range .Blueprint.Config.SortedFields}}
		{{.Name}}: new{{.Name}}Config(),
{{- end}}
	}
}

var Module = fx.Module("config", fx.Provide(NewConfig))
