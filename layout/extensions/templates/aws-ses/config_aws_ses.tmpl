package config

import (
	"errors"

	"github.com/mbvlabs/andurel/pkg/validation"
)

const DefaultAWSSESRegion = "us-east-1"

type AWSSES struct {
	Region           string
	AccessKeyID      string
	SecretAccessKey  string
	ConfigurationSet string
}

func loadAWSSES(env *environment) (AWSSES, error) {
	cfg := AWSSES{
		Region:           env.String("AWS_REGION", DefaultAWSSESRegion),
		AccessKeyID:      env.String("AWS_SES_ACCESS_KEY_ID", ""),
		SecretAccessKey:  env.String("AWS_SES_SECRET_ACCESS_KEY", ""),
		ConfigurationSet: env.String("AWS_SES_CONFIGURATION_SET", ""),
	}
	b := validation.NewBuilder()
	b.Required("Region", cfg.Region)
	if cfg.AccessKeyID != "" || cfg.SecretAccessKey != "" {
		b.Required("AccessKeyID", cfg.AccessKeyID)
		b.Required("SecretAccessKey", cfg.SecretAccessKey)
	}

	return cfg, errors.Join(env.Err(), b.Err())
}
