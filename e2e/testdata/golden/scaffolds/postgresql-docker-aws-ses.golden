	Name() string
	GetSpanExporter(ctx context.Context, res *resource.Resource) (sdktrace.SpanExporter, error)
	Shutdown(ctx context.Context) error
}

func GetTracer(serviceName string) trace.Tracer {
	return otel.Tracer(serviceName)
}
