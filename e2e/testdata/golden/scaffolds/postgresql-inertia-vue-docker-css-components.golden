package email

import (
	"bytes"
	"context"
)

type VerifyEmail struct {
	VerificationCode string
}

var _ Transformer = (*VerifyEmail)(nil)

func (v VerifyEmail) ToHTML() (string, error) {
	var buf bytes.Buffer
