```
// Package application contains shared, non-sensitive application identity.
package application

import (
	"fmt"
	"os"
	"strings"

	"github.com/gosimple/slug"
	"github.com/mbvlabs/andurel/pkg/server"
)

// Global application metadata with environment-backed defaults.
var (
	Environment = func() string {
		if value := os.Getenv("ENVIRONMENT"); value != "" {
			return value
		}
		return server.DevEnvironment
	}()
	ProjectName = func() string {
		if value := os.Getenv("PROJECT_NAME"); value != "" {
			return value
		}
		return "andurel"
	}()
	ServiceName = func() string {
		if value := os.Getenv("TELEMETRY_SERVICE_NAME"); value != "" {
			return value
		}
		return slug.Make(ProjectName)
	}()
	Domain = func() string {
		if value := os.Getenv("DOMAIN"); value != "" {
			return value
		}
		return "localhost:8080"
	}()
	BaseURL = func() string {
		protocol := os.Getenv("PROTOCOL")
		if protocol == "" {
			protocol = "http"
		}
		return fmt.Sprintf("%s://%s", protocol, Domain)
	}()
	AppCookieSessionName   = "app_sess_" + slug.Make(strings.ToLower(ProjectName)) + "-" + Environment
	DefaultSenderSignature = func() string {
		if value := os.Getenv("DEFAULT_SENDER_SIGNATURE"); value != "" {
			return value
		}
		return "noreply@" + Domain
	}()
)

// Metadata identifies the running application without exposing subsystem
// configuration or secrets.
type Metadata struct {
	ProjectName string
	Environment string
	BaseURL     string
	Domain      string
	ServiceName string
	Version     string
}

func NewMetadata(version string) Metadata {
	return Metadata{
		ProjectName: ProjectName,
		Environment: Environment,
		BaseURL:     BaseURL,
		Domain:      Domain,
		ServiceName: ServiceName,
		Version:     version,
	}
}

func (metadata Metadata) IsProduction() bool {
	return metadata.Environment == server.ProdEnvironment
}
