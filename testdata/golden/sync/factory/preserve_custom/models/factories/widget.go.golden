package factories

import (
	"context"
	"fmt"
	"math"
	"time"
	"uuid"

	"example.com/app/models"
	"github.com/go-faker/faker/v4"
	"github.com/mbvlabs/andurel/pkg/storage"
)

// Factory declarations below are generated by Andurel.

type WidgetFactory struct {
	models.Widget
}

type WidgetOption func(*WidgetFactory)

func BuildWidget(opts ...WidgetOption) models.Widget {
	f := &WidgetFactory{
		Widget: models.Widget{
			Name:     faker.Name(),
			Quantity: randomInt(1, 1000, 100),
			Active:   randomBool(),
		},
	}

	for _, opt := range opts {
		opt(f)
	}

	return f.Widget
}

func CreateWidget(ctx context.Context, db storage.Connection, opts ...WidgetOption) (models.Widget, error) {
	built := BuildWidget(opts...)

	return models.NewWidget(db).Create(ctx, models.CreateWidgetData{
		Name:     built.Name,
		Quantity: built.Quantity,
		Active:   built.Active,
	})
}

func CreateWidgets(ctx context.Context, db storage.Connection, count int, opts ...WidgetOption) ([]models.Widget, error) {
	widgets := make([]models.Widget, 0, count)

	for i := range count {
		entity, err := CreateWidget(ctx, db, opts...)
		if err != nil {
			return nil, fmt.Errorf("failed to create widget %d: %w", i+1, err)
		}
		widgets = append(widgets, entity)
	}

	return widgets, nil
}

func WithWidgetName(value string) WidgetOption {
	return func(f *WidgetFactory) {
		f.Widget.Name = value
	}
}

func WithWidgetQuantity(value int32) WidgetOption {
	return func(f *WidgetFactory) {
		f.Widget.Quantity = value
	}
}

func WithWidgetActive(value bool) WidgetOption {
	return func(f *WidgetFactory) {
		f.Widget.Active = value
	}
}

func CustomWidgetScore() int {
	return int(math.Max(1, 2))
}
