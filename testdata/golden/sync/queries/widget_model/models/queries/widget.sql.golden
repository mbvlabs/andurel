-- narsilc queries for Widget

-- name: GetWidget :one
SELECT *
FROM widgets
WHERE id = $1
LIMIT 1;

-- name: ListWidgets :many
-- @order id
SELECT *
FROM widgets;

-- name: CountWidgets :one
SELECT count(*)
FROM widgets;

-- name: CreateWidget :one
INSERT INTO widgets (
	id,
	name,
	quantity,
	active,
	created_at,
	updated_at
) VALUES (
	$1,
	$2,
	$3,
	$4,
	$5,
	$6
)
RETURNING *;

-- name: UpdateWidget :one
UPDATE widgets
SET
	name = $2,
	quantity = $3,
	active = $4,
	updated_at = $5
WHERE id = $1
RETURNING *;

-- name: DeleteWidget :exec
DELETE FROM widgets
WHERE id = $1;

-- name: UpsertWidget :one
INSERT INTO widgets (
	id,
	name,
	quantity,
	active,
	created_at,
	updated_at
) VALUES (
	$1,
	$2,
	$3,
	$4,
	$5,
	$6
)
ON CONFLICT (id) DO UPDATE SET
	name = excluded.name,
	quantity = excluded.quantity,
	active = excluded.active,
	updated_at = excluded.updated_at
RETURNING *;
