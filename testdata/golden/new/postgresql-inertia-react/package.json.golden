{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr resources/js/ssr.tsx --outDir assets/dist/ssr",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr resources/js/ssr.tsx --outDir assets/dist/ssr",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p emails/tsconfig.json",
    "email:export": "tsx --tsconfig emails/tsconfig.json emails/export.tsx"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@inertiajs/react": "^3.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@inertiajs/vite": "^3.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react-email": "6.11.6",
    "tailwindcss": "^4.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  }
}
