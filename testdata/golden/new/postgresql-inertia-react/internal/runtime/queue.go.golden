package runtime

import (
	"context"
	"errors"
	"fmt"
	"slices"

	"app/config"
	"app/domains"
	"app/queue"
	"app/services"

	"github.com/mbvlabs/andurel/pkg/routing"
	"github.com/mbvlabs/andurel/pkg/storage"
)

type Queue struct {
	processor *storage.QueueProcessor
	closers   []func(context.Context) error
}

// NewQueue builds the worker process. Like New, each dependency registers its
// cleanup as soon as it exists.
func NewQueue(ctx context.Context, cfg config.Config) (_ *Queue, err error) {
	// Workers render absolute links into emails, so routes need the hosts.
	if err := routing.ConfigureHosts(cfg.App.Hosts); err != nil {
		return nil, fmt.Errorf("runtime: configure hosts: %w", err)
	}

	q := &Queue{}
	defer func() {
		if err != nil {
			err = errors.Join(err, q.Shutdown(context.WithoutCancel(ctx)))
		}
	}()

	tel, err := newTelemetry(ctx, cfg.App, cfg.Telemetry)
	if err != nil {
		return nil, err
	}
	q.closers = append(q.closers, tel.Shutdown)

	db, err := newDatabase(ctx, cfg.Database, tel)
	if err != nil {
		return nil, err
	}
	q.closers = append(q.closers, func(context.Context) error { return db.Close() })

	transactional, marketing, err := newEmailSenders(cfg.Mail)
	if err != nil {
		return nil, err
	}

	// Auth email workers mint tokens at send time, so they need the identity
	// service; its insert queue is unused here but required by the constructor.
	queueInsert, err := storage.NewQueueInsert(db, cfg.QueueInsert.Config)
	if err != nil {
		return nil, err
	}

	identity := services.NewIdentity(
		storage.NewTransactor(db),
		domains.NewUsers(db),
		domains.NewTokens(db),
		queueInsert,
		cfg.Auth,
		cfg.Mail,
	)

	processor, err := storage.NewQueueProcessor(
		db,
		cfg.QueueWorker.Config,
		storage.WithRiverWorkers(queue.NewWorkers(identity, transactional, marketing)),
		storage.WithRiverPeriodicJobs(queue.PeriodicJobs()...),
		storage.WithRiverLogger(tel.Logger()),
	)
	if err != nil {
		return nil, err
	}
	q.processor = processor
	q.closers = append(q.closers, processor.Stop)

	return q, nil
}

func (q *Queue) Start(ctx context.Context) error {
	return q.processor.Start(ctx)
}

// Shutdown stops the processor first, then releases the database and
// telemetry: the reverse of construction order.
func (q *Queue) Shutdown(ctx context.Context) error {
	var shutdownErr error
	for _, closeFn := range slices.Backward(q.closers) {
		shutdownErr = errors.Join(shutdownErr, closeFn(ctx))
	}

	return shutdownErr
}
