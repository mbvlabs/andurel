</style></head><body class="email-bg" dir="ltr" lang="en" style="background-color:#f6f9fc;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Reset your password using the secure link in this email.<div> ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td dir="ltr" lang="en" style="background-color:#f6f9fc;font-family:Arial, Helvetica, sans-serif;margin:0;padding:0;width:100%"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-shell"><tbody><tr><td style="padding:40px 16px"><table align="center" width="100%" class="email-card" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:600px;background-color:#ffffff;border-radius:16px;width:100%"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-px"><tbody><tr><td style="padding:48px 48px 20px 48px"><p class="email-primary" style="font-size:12px;line-height:16px;color:#ff6b1a;font-family:Arial, Helvetica, sans-serif;font-weight:700;letter-spacing:0.12em;margin:0 0 12px 0;text-transform:uppercase;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0">Password assistance</p><h1 class="email-fg" style="color:#172033;font-family:Arial, Helvetica, sans-serif;font-size:30px;font-weight:700;line-height:38px;margin:0">Reset your password</h1></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-px"><tbody><tr><td style="padding:0 48px 24px 48px"><p class="email-fg" style="font-size:16px;line-height:24px;color:#172033;font-family:Arial, Helvetica, sans-serif;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Hi,</p><p class="email-fg" style="font-size:16px;line-height:24px;color:#172033;font-family:Arial, Helvetica, sans-serif;margin:16px 0 0 0;margin-top:16px;margin-right:0;margin-bottom:0;margin-left:0">We received a request to reset your password. Use the button below to choose a new one.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-px"><tbody><tr><td style="padding:0 48px 24px 48px"><a href="{{.ResetURL | html}}" style="line-height:24px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#ff6b1a;border-radius:6px;color:#130f0b;font-family:Arial, Helvetica, sans-serif;font-size:16px;font-weight:700;padding:12px 24px;text-align:center;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18px" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Reset my password</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-px"><tbody><tr><td style="padding:0 48px 24px 48px"><p class="email-muted" style="font-size:14px;line-height:24px;color:#687385;font-family:Arial, Helvetica, sans-serif;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">If the button does not work, copy this URL into your browser:</p><p class="email-primary" style="font-size:14px;line-height:24px;color:#ff6b1a;font-family:Arial, Helvetica, sans-serif;margin:8px 0 0 0;word-break:break-all;margin-top:8px;margin-right:0;margin-bottom:0;margin-left:0">{{.ResetURL | html}}</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-px"><tbody><tr><td style="padding:0 48px 16px 48px"><p class="email-muted" style="font-size:14px;line-height:24px;color:#687385;font-family:Arial, Helvetica, sans-serif;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">This link expires in one hour.</p><p class="email-muted" style="font-size:14px;line-height:24px;color:#687385;font-family:Arial, Helvetica, sans-serif;margin:16px 0 0 0;margin-top:16px;margin-right:0;margin-bottom:0;margin-left:0">If you did not request a password reset, you can safely ignore this email.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" class="email-px"><tbody><tr><td style="padding:32px 48px 40px 48px"><hr class="email-border" style="width:100%;border:none;border-color:#e6ebf1;border-top:1px solid #e6ebf1;margin:0 0 24px 0"/><p class="email-muted" style="font-size:12px;line-height:20px;color:#687385;font-family:Arial, Helvetica, sans-serif;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">This email relates to your account.<br/>Powered by <strong>Andurel</strong></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>