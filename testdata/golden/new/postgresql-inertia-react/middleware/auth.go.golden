package middleware

import (
	"context"
	"net/http"
	"strconv"
	"time"

	"app/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/cache"
	"github.com/mbvlabs/andurel/pkg/kiks"
)

func AuthOnly() anduin.Middleware {
	return func(next anduin.Handler) anduin.Handler {
		return func(ctx context.Context) error {
			app, err := kiks.Get[*App](ctx)
			if err != nil {
				return err
			}
			if app != nil && app.IsAuthenticated {
				return next(ctx)
			}

			return anduin.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
		}
	}
}

// RateLimit allows limit requests per client IP per route within window; every
// attempt counts, successful or not. Each route keeps its own bucket, so a
// burst on one endpoint never locks out another. The client IP comes from
// anduin.ClientIP, which only honours X-Forwarded-For from HTTP_TRUSTED_PROXIES.
// Over the limit, onLimited answers with Retry-After set; a nil onLimited
// returns a plain 429 error.
func RateLimit(
	store cache.Store,
	limit int,
	window time.Duration,
	onLimited anduin.Handler,
) anduin.Middleware {
	return func(next anduin.Handler) anduin.Handler {
		return func(ctx context.Context) error {
			key := "ratelimit:" + anduin.RoutePattern(ctx) + ":" + anduin.ClientIP(ctx)
			hits, err := store.Increment(ctx, key, window)
			if err != nil {
				return err
			}

			if hits <= int64(limit) {
				return next(ctx)
			}

			anduin.SetHeader(ctx, "Retry-After", strconv.Itoa(int(window.Seconds())))
			if onLimited == nil {
				return anduin.Errorf(http.StatusTooManyRequests, "too many requests")
			}

			return onLimited(ctx)
		}
	}
}
