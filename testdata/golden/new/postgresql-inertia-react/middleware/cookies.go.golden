package middleware

import (
	"app/config"

	"github.com/mbvlabs/andurel/pkg/kiks"
)

// Session is the application session stored in an encrypted cookie.
type Session struct {
	UserID          string `json:"user_id,omitempty"`
	PendingUserID   string `json:"pending_user_id,omitempty"`
	SessionVersion  int32  `json:"session_version,omitempty"`
	IsAuthenticated bool   `json:"is_authenticated,omitempty"`
}

// NewSessionCookie defines the session cookie. An empty cfg.CookieDomain leaves
// the cookie host-only.
func NewSessionCookie(cfg config.Session, secure bool) kiks.Definition {
	return kiks.NewSession[*Session](
		cfg.Name,
		kiks.HTTPOnly(),
		kiks.Secure(secure),
		kiks.MaxAge(cfg.MaxAge),
		kiks.Domain(cfg.CookieDomain),
	)
}

// CookieDefinitions lists every cookie the app registers on its jar. The app
// (application.newJar) and the test helpers build their jars from this one
// list, so a cookie added here is visible to handler tests too. Add new cookie
// definitions here, not at the jar call sites.
func CookieDefinitions(cfg config.Session, secure bool) []kiks.Definition {
	return []kiks.Definition{
		NewSessionCookie(cfg, secure),
	}
}
