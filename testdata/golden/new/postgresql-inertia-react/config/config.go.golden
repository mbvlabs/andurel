package config

import "github.com/mbvlabs/andurel/pkg/storage"

type Config struct {
	Version string

	App         App
	HTTP        HTTP
	Auth        Auth
	Session     Session
	Cache       Cache
	Database    storage.Config
	QueueInsert QueueInsert
	QueueWorker QueueWorker
	Telemetry   Telemetry
	Mail        Mail
	Inertia     Inertia
}

func New() (Config, error) {
	app, err := NewApp()
	if err != nil {
		return Config{}, err
	}

	httpCfg, err := NewHTTP()
	if err != nil {
		return Config{}, err
	}

	auth, err := NewAuth()
	if err != nil {
		return Config{}, err
	}

	session, err := NewSession(app)
	if err != nil {
		return Config{}, err
	}

	cacheCfg, err := NewCache()
	if err != nil {
		return Config{}, err
	}

	database, err := NewDatabase()
	if err != nil {
		return Config{}, err
	}

	queueInsert, err := NewQueueInsert()
	if err != nil {
		return Config{}, err
	}

	queueWorker, err := NewQueueWorker(queueInsert)
	if err != nil {
		return Config{}, err
	}

	tel, err := NewTelemetry(app)
	if err != nil {
		return Config{}, err
	}

	mail, err := NewMail(app)
	if err != nil {
		return Config{}, err
	}

	inertiaCfg, err := NewInertia()
	if err != nil {
		return Config{}, err
	}

	return Config{
		Version:     "dev",
		App:         app,
		HTTP:        httpCfg,
		Auth:        auth,
		Session:     session,
		Cache:       cacheCfg,
		Database:    database,
		QueueInsert: queueInsert,
		QueueWorker: queueWorker,
		Telemetry:   tel,
		Mail:        mail,
		Inertia:     inertiaCfg,
	}, nil
}
