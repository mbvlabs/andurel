// Email theme tokens. Hex values only: email clients do not render oklch() or
// var(), and some strip the whole style attribute when they see modern color
// syntax. This file is hand-edited; it is not generated from css/theme.css.
//
// The light palette is always inlined. The dark palette is a progressive
// enhancement applied by layout.tsx with @media (prefers-color-scheme: dark)
// and the [data-ogsc]/[data-ogsb] Outlook.com hooks.
export const theme = {
  background: "#f6f9fc",
  foreground: "#172033",
  card: "#ffffff",
  muted: "#f6f9fc",
  mutedForeground: "#687385",
  border: "#e6ebf1",
  primary: "#ff6b1a",
  primaryForeground: "#130f0b",
  fontSans: "Arial, Helvetica, sans-serif",
  fontMono: "'Courier New', Courier, monospace",
  radius: "8px",
} as const

export const darkTheme = {
  background: "#0b0f14",
  card: "#151a21",
  foreground: "#e6e8eb",
  mutedForeground: "#9aa4b2",
  border: "#2a313b",
  primary: "#ff8a4c",
} as const
