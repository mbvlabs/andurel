import { Button, Heading, Section, Text } from "react-email"
import { Layout } from "./_components/layout"
import type { ResetPasswordProps } from "./_generated/props"
import { theme } from "./theme"

const eyebrowStyle = {
  color: theme.primary,
  fontFamily: theme.fontSans,
  fontSize: 12,
  fontWeight: 700,
  letterSpacing: "0.12em",
  lineHeight: "16px",
  margin: "0 0 12px 0",
  textTransform: "uppercase",
} as const

const headingStyle = {
  color: theme.foreground,
  fontFamily: theme.fontSans,
  fontSize: 30,
  fontWeight: 700,
  lineHeight: "38px",
  margin: 0,
} as const

const paragraphStyle = {
  color: theme.foreground,
  fontFamily: theme.fontSans,
  fontSize: 16,
  lineHeight: "24px",
  margin: 0,
} as const

const noteStyle = {
  color: theme.mutedForeground,
  fontFamily: theme.fontSans,
  fontSize: 14,
  lineHeight: "24px",
  margin: 0,
} as const

export default function ResetPassword({ ResetURL }: ResetPasswordProps) {
  return (
    <Layout
      title="Reset Your Password"
      preview="Reset your password using the secure link in this email."
    >
      <Section
        className="email-px"
        style={{ padding: "48px 48px 20px 48px" }}
      >
        <Text className="email-primary" style={eyebrowStyle}>
          Password assistance
        </Text>
        <Heading as="h1" className="email-fg" style={headingStyle}>
          Reset your password
        </Heading>
      </Section>
      <Section
        className="email-px"
        style={{ padding: "0 48px 24px 48px" }}
      >
        <Text className="email-fg" style={paragraphStyle}>
          Hi,
        </Text>
        <Text
          className="email-fg"
          style={{ ...paragraphStyle, margin: "16px 0 0 0" }}
        >
          We received a request to reset your password. Use the button below to
          choose a new one.
        </Text>
      </Section>
      <Section
        className="email-px"
        style={{ padding: "0 48px 24px 48px" }}
      >
        <Button
          href={ResetURL}
          style={{
            backgroundColor: theme.primary,
            borderRadius: 6,
            color: theme.primaryForeground,
            display: "inline-block",
            fontFamily: theme.fontSans,
            fontSize: 16,
            fontWeight: 700,
            lineHeight: "24px",
            padding: "12px 24px",
            textAlign: "center",
            textDecoration: "none",
          }}
        >
          Reset my password
        </Button>
      </Section>
      <Section
        className="email-px"
        style={{ padding: "0 48px 24px 48px" }}
      >
        <Text className="email-muted" style={noteStyle}>
          If the button does not work, copy this URL into your browser:
        </Text>
        <Text
          className="email-primary"
          style={{
            ...noteStyle,
            color: theme.primary,
            margin: "8px 0 0 0",
            wordBreak: "break-all",
          }}
        >
          {ResetURL}
        </Text>
      </Section>
      <Section
        className="email-px"
        style={{ padding: "0 48px 16px 48px" }}
      >
        <Text className="email-muted" style={noteStyle}>
          This link expires in one hour.
        </Text>
        <Text
          className="email-muted"
          style={{ ...noteStyle, margin: "16px 0 0 0" }}
        >
          If you did not request a password reset, you can safely ignore this
          email.
        </Text>
      </Section>
    </Layout>
  )
}
