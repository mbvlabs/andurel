package main

import (
	"context"
	"fmt"
	"os"

	"app/config"
	"app/internal/runtime"

	"github.com/mbvlabs/andurel/pkg/env"
	"github.com/mbvlabs/andurel/pkg/lifecycle"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	if err := env.Load(); err != nil {
		return err
	}

	cfg, err := config.New()
	if err != nil {
		return err
	}

	ctx, cancel := lifecycle.NotifyContext(context.Background())
	defer cancel()

	worker, err := runtime.NewQueue(ctx, cfg)
	if err != nil {
		return err
	}

	return lifecycle.Run(ctx, worker.Start, worker.Shutdown)
}
