<script setup lang="ts">
import { useForm } from '@inertiajs/vue3'
import Layout from '@/Layouts/Layout.vue'
import { routes } from '@/routes'

defineProps<{ errors?: Record<string, string> }>()

const form = useForm({
  code: '',
})
</script>

<template>
  <Layout>
    <section class="w-full max-w-md border border-border bg-card/90 shadow-sm shadow-black/40">
      <div class="p-6 pb-0">
        <h1 class="text-xl font-semibold text-card-foreground">Verify Your Email</h1>
        <p class="mt-1 text-sm text-muted-foreground">Please enter the 6-digit verification code sent to your email.</p>
      </div>
      <div class="p-6">
        <form class="space-y-5" @submit.prevent="form.post(routes.confirmationCreate())">
          <div class="space-y-1">
            <label class="text-sm font-medium text-muted-foreground" for="code">Verification Code</label>
            <input id="code" v-model="form.code" type="text" maxlength="6" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-center text-sm tracking-[0.3em] text-foreground shadow-inner shadow-black/35 focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20" required>
            <p v-if="errors?.code" class="text-sm font-medium text-destructive">{{ errors.code }}</p>
          </div>
          <button type="submit" :disabled="form.processing" class="inline-flex w-full items-center justify-center bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm shadow-black/40 hover:bg-primary/90 disabled:opacity-60">{{ form.processing ? 'Loading' : 'Verify Email' }}</button>
        </form>
      </div>
    </section>
  </Layout>
</template>
