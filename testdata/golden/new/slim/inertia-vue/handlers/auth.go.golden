package handlers

import (
	"context"
	"errors"
	"net/http"
	"strings"
	"time"
	"uuid"

	"app/domains"
	"app/middleware"
	"app/payloads"
	"app/routes"
	"app/services"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/cache"
	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/kiks"
	"github.com/mbvlabs/andurel/pkg/routing"
	"github.com/mbvlabs/andurel/pkg/telemetry"
)

type AuthHandler struct {
	identity services.Identity
	renderer *inertia.Renderer
	cache    cache.Store
	hosts    *routing.Hosts
}

// NewAuthHandler takes the host registry so a sign-in can send the visitor back
// to a page on another host (see middleware.ConsumeReturnTo).
func NewAuthHandler(
	identity services.Identity,
	renderer *inertia.Renderer,
	store cache.Store,
	hosts *routing.Hosts,
) AuthHandler {
	return AuthHandler{identity: identity, renderer: renderer, cache: store, hosts: hosts}
}

const (
	authAttemptLimit  = 5
	authAttemptWindow = 10 * time.Minute
)

// Register binds each route on the host it declares with rt.Route, so the
// route value, not a copied path, decides the domain it is served on.
func (h AuthHandler) Register(rt *anduin.Router) {
	rt.Route(routes.SessionNew).Get(h.SessionNew)
	rt.Route(routes.SessionCreate).Post(
		h.SessionCreate,
		h.throttle(h.tooManyAttempts("Auth/Login", "email")),
	)
	rt.Route(routes.SessionDestroy).Delete(h.SessionDestroy)
	// The POST route lets a plain HTML form sign out without JavaScript; the
	// DELETE route stays for the Inertia link.
	rt.Route(routes.SessionDestroy).Post(h.SessionDestroy)

	rt.Route(routes.RegistrationNew).Get(h.RegistrationNew)
	rt.Route(routes.RegistrationCreate).Post(
		h.RegistrationCreate,
		h.throttle(h.tooManyAttempts("Auth/Registration", "email")),
	)

	rt.Route(routes.ConfirmationNew).Get(h.ConfirmationNew)
	rt.Route(routes.ConfirmationCreate).Post(
		h.ConfirmationCreate,
		h.throttle(h.tooManyAttempts("Auth/ConfirmEmail", "code")),
	)

	rt.Route(routes.PasswordNew).Get(h.PasswordNew)
	rt.Route(routes.PasswordCreate).Post(
		h.PasswordCreate,
		h.throttle(h.tooManyAttempts("Auth/ResetPasswordRequest", "email")),
	)
	rt.Route(routes.PasswordEdit).Get(h.PasswordEdit)
	rt.Route(routes.PasswordUpdate).Put(
		h.PasswordUpdate,
		h.throttle(h.tooManyPasswordResets),
	)
}

// throttle rate-limits an auth endpoint per client IP; onLimited re-renders the
// submitting form so Inertia shows the error inline.
func (h AuthHandler) throttle(onLimited anduin.Handler) anduin.Middleware {
	return anduin.RateLimit(h.cache, authAttemptLimit, authAttemptWindow, onLimited)
}

func (h AuthHandler) tooManyAttempts(component, field string) anduin.Handler {
	return func(ctx context.Context) error {
		return h.renderTooManyAttempts(ctx, component, field, inertia.Props{})
	}
}

func (h AuthHandler) tooManyPasswordResets(ctx context.Context) error {
	var payload payloads.PasswordResetPayload
	_ = anduin.DecodeJSON(ctx, &payload)

	return h.renderTooManyAttempts(
		ctx,
		"Auth/ResetPassword",
		"resetPasswordToken",
		inertia.FromStruct(payloads.PasswordResetPageProps{Token: payload.Token}),
	)
}

func (h AuthHandler) renderTooManyAttempts(
	ctx context.Context,
	component string,
	field string,
	props inertia.Props,
) error {
	return h.renderer.Page(ctx, component, props).
		ValidationErrors(map[string]string{
			field: "Too many attempts, try again later.",
		}).
		Status(http.StatusTooManyRequests).
		Render()
}

func (h AuthHandler) SessionNew(ctx context.Context) error {
	return h.renderer.Page(ctx, "Auth/Login", inertia.Props{}).Render()
}

func (h AuthHandler) SessionCreate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "sessions.create")
	defer span.End()

	var payload payloads.LoginPayload
	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		return anduin.BadRequest(err)
	}

	entity, err := h.identity.AuthenticateUser(
		ctx,
		services.LoginData{
			Email:    payload.Email,
			Password: payload.Password,
		},
	)
	if err != nil {
		if page, ok := h.renderer.Page(
			ctx,
			"Auth/Login",
			inertia.Props{},
		).Errors(err); ok {
			return page.Render()
		}

		if errors.Is(err, services.ErrEmailNotVerified) {
			if resumeErr := h.resumeEmailVerification(ctx, entity); resumeErr != nil {
				return resumeErr
			}

			return h.renderer.Redirect(
				ctx,
				routes.ConfirmationNew.URL(),
				http.StatusSeeOther,
			)
		}

		if errors.Is(err, services.ErrInvalidCredentials) {
			return h.renderer.Page(
				ctx,
				"Auth/Login",
				inertia.Props{},
			).ValidationErrors(map[string]string{
				"email": "Invalid email or password",
			}).Render()
		}

		return err
	}

	if err := kiks.Set(ctx, &middleware.Session{
		UserID:          entity.ID.String(),
		SessionVersion:  entity.SessionVersion,
		IsAuthenticated: true,
	}); err != nil {
		return err
	}

	return h.signedInRedirect(ctx)
}

// signedInRedirect sends a freshly signed-in visitor to the page they asked for
// before sign-in, or to the home page. The return-target cookie is cleared
// either way. It uses Location rather than a plain redirect because sign-in is
// an Inertia request: Location makes the client visit the target itself, on
// this host or another one.
func (h AuthHandler) signedInRedirect(ctx context.Context) error {
	location, err := middleware.ConsumeReturnTo(ctx, h.hosts, routes.HomePage.URL())
	if err != nil {
		return err
	}

	return h.renderer.Location(ctx, location)
}

func (h AuthHandler) resumeEmailVerification(ctx context.Context, entity domains.User) error {
	if err := h.identity.ResendEmailVerification(ctx, entity); err != nil {
		return err
	}

	return setPendingUser(ctx, entity.ID.String())
}

func (h AuthHandler) SessionDestroy(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "sessions.destroy")
	defer span.End()

	if err := kiks.Destroy[*middleware.Session](ctx); err != nil {
		return err
	}
	if err := kiks.Destroy[middleware.ReturnTo](ctx); err != nil {
		return err
	}
	if err := kiks.AddFlash(ctx, kiks.FlashSuccess, "Signed out."); err != nil {
		return err
	}

	return h.renderer.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
}

func (h AuthHandler) RegistrationNew(ctx context.Context) error {
	return h.renderer.Page(ctx, "Auth/Registration", inertia.Props{}).Render()
}

func (h AuthHandler) RegistrationCreate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "user.registration")
	defer span.End()

	outcome := "success"
	var (
		email  string
		userID any
		cause  error
	)
	defer func() {
		// Only the email domain is recorded: the address itself is personal
		// data and does not belong in logs or traces.
		args := []any{"registration.outcome", outcome}
		if _, domain, found := strings.Cut(email, "@"); found && domain != "" {
			args = append(args, "user.email_domain", domain)
		}
		if userID != nil {
			args = append(args, "user.id", userID)
		}
		if cause != nil {
			args = append(args, "error", cause)
			if outcome == "error" {
				_ = telemetry.Fail(ctx, cause)
			}
		}
		telemetry.Set(ctx, args...)
		telemetry.Info(ctx, "user.registration", args...)
	}()

	var payload payloads.RegistrationPayload
	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		outcome = "bind_error"
		cause = err
		return anduin.BadRequest(err)
	}

	email = payload.Email

	entity, err := h.identity.RegisterUser(
		ctx,
		services.RegisterUserData{
			Email:           payload.Email,
			Password:        payload.Password,
			ConfirmPassword: payload.ConfirmPassword,
		},
	)
	if err != nil {
		if page, ok := h.renderer.Page(
			ctx,
			"Auth/Registration",
			inertia.Props{},
		).Errors(err); ok {
			outcome = "validation_error"
			cause = err
			return page.Render()
		}

		if errors.Is(err, domains.ErrConflict) {
			// Do not confirm that the address is already registered: answer
			// like a successful sign-up and send nothing.
			outcome = "conflict"
			cause = err

			return h.renderer.Redirect(
				ctx,
				routes.ConfirmationNew.URL(),
				http.StatusSeeOther,
			)
		}

		outcome = "error"
		cause = err

		return h.renderer.Redirect(
			ctx,
			routes.RegistrationNew.URL(),
			http.StatusSeeOther,
		)
	}

	userID = entity.ID

	if err := setPendingUser(ctx, entity.ID.String()); err != nil {
		outcome = "error"
		cause = err
		return err
	}

	return h.renderer.Redirect(ctx, routes.ConfirmationNew.URL(), http.StatusSeeOther)
}

func setPendingUser(ctx context.Context, userID string) error {
	session, err := kiks.Get[*middleware.Session](ctx)
	if err != nil {
		return err
	}
	if session == nil {
		session = &middleware.Session{}
	}
	session.PendingUserID = userID

	return kiks.Set(ctx, session)
}

func (h AuthHandler) ConfirmationNew(ctx context.Context) error {
	return h.renderer.Page(ctx, "Auth/ConfirmEmail", inertia.Props{}).Render()
}

func (h AuthHandler) ConfirmationCreate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "confirmations.create")
	defer span.End()

	var payload payloads.ConfirmationPayload
	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		return anduin.BadRequest(err)
	}

	entity, err := h.identity.VerifyEmail(
		ctx,
		services.VerifyEmailData{
			UserID: pendingUserID(ctx),
			Code:   payload.Code,
		},
	)
	if err != nil {
		if page, ok := h.renderer.Page(
			ctx,
			"Auth/ConfirmEmail",
			inertia.Props{},
		).Errors(err); ok {
			return page.Render()
		}

		telemetry.Error(
			ctx,
			"failed to verify email",
			"error",
			err,
		)

		return h.renderer.Redirect(
			ctx,
			routes.ConfirmationNew.URL(),
			http.StatusSeeOther,
		)
	}

	if err := kiks.Set(ctx, &middleware.Session{
		UserID:          entity.ID.String(),
		SessionVersion:  entity.SessionVersion,
		IsAuthenticated: true,
	}); err != nil {
		return err
	}

	return h.signedInRedirect(ctx)
}

func pendingUserID(ctx context.Context) uuid.UUID {
	session, err := kiks.Get[*middleware.Session](ctx)
	if err != nil || session == nil || session.PendingUserID == "" {
		return uuid.Nil()
	}

	userID, err := uuid.Parse(session.PendingUserID)
	if err != nil {
		return uuid.Nil()
	}

	return userID
}

func (h AuthHandler) PasswordNew(ctx context.Context) error {
	return h.renderer.Page(ctx, "Auth/ResetPasswordRequest", inertia.Props{}).Render()
}

func (h AuthHandler) PasswordCreate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "reset_passwords.create")
	defer span.End()

	var payload payloads.PasswordResetRequestPayload
	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		return anduin.BadRequest(err)
	}

	if err := h.identity.RequestResetPassword(
		ctx,
		services.RequestResetPasswordData{
			Email: payload.Email,
		},
	); err != nil {
		if page, ok := h.renderer.Page(
			ctx,
			"Auth/ResetPasswordRequest",
			inertia.Props{},
		).Errors(err); ok {
			return page.Render()
		}

		telemetry.Error(
			ctx,
			"failed to request password reset",
			"error",
			err,
		)

		return h.renderer.Redirect(ctx, routes.PasswordNew.URL(), http.StatusSeeOther)
	}

	return h.renderer.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
}

func (h AuthHandler) PasswordEdit(ctx context.Context) error {
	anduin.SetHeader(ctx, "Referrer-Policy", "strict-origin")

	token := anduin.PathValue(ctx, "token")
	if token == "" {
		return h.renderer.Redirect(ctx, routes.PasswordNew.URL(), http.StatusSeeOther)
	}

	return h.renderer.Page(
		ctx,
		"Auth/ResetPassword",
		inertia.FromStruct(payloads.PasswordResetPageProps{Token: token}),
	).Render()
}

func (h AuthHandler) PasswordUpdate(ctx context.Context) error {
	ctx, span := telemetry.From(anduin.Request(ctx), "reset_passwords.update")
	defer span.End()

	var payload payloads.PasswordResetPayload
	if err := anduin.DecodeJSON(ctx, &payload); err != nil {
		return anduin.BadRequest(err)
	}

	if err := h.identity.ResetPassword(
		ctx,
		services.ResetPasswordData{
			Token:           payload.Token,
			Password:        payload.Password,
			ConfirmPassword: payload.ConfirmPassword,
		},
	); err != nil {
		if page, ok := h.renderer.Page(
			ctx,
			"Auth/ResetPassword",
			inertia.FromStruct(payloads.PasswordResetPageProps{Token: payload.Token}),
		).Errors(err); ok {
			return page.Render()
		}

		if errors.Is(err, services.ErrInvalidResetCode) ||
			errors.Is(err, services.ErrExpiredResetCode) {
			return h.renderer.Page(
				ctx,
				"Auth/ResetPassword",
				inertia.FromStruct(payloads.PasswordResetPageProps{Token: payload.Token}),
			).ValidationErrors(map[string]string{
				"resetPasswordToken": "Invalid or expired reset code",
			}).Render()
		}

		telemetry.Error(
			ctx,
			"failed to reset password",
			"error",
			err,
		)

		return h.renderer.Redirect(
			ctx,
			routes.PasswordEdit.URL(payload.Token),
			http.StatusSeeOther,
		)
	}

	return h.renderer.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
}
