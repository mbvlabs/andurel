package handlers_test

import (
	"testing"

	"app/config"
	"app/resources"
	"app/routes"

	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/storage/storagetest"
)

// testCluster is one Postgres container for the whole test package.
var testCluster *storagetest.Cluster

func TestMain(m *testing.M) {
	storagetest.Main(m, &testCluster)
}

// testRenderer builds the Inertia renderer handlers expect, the way
// runtime.newRenderer does, from the config package's Inertia defaults. It
// reads no environment variables. The root component is the application's own.
// SSR fail-fast stays off so a page render does not need the SSR server.
func testRenderer(t *testing.T) *inertia.Renderer {
	t.Helper()

	renderer, err := inertia.NewRenderer(
		inertia.RendererConfig{
			ContainerID:         config.DefaultInertiaContainerID,
			BuildPathURL:        routes.ViteBuild.FullURL(),
			EntryPoint:          config.DefaultInertiaEntryPoint,
			ViteDevURL:          config.DefaultInertiaViteDevURL,
			SSRURL:              config.DefaultInertiaSSRURL,
			SSRTimeout:          config.DefaultInertiaSSRRequestTimeout,
			SSRMaxResponseBytes: config.DefaultInertiaSSRMaxResponseBytes,
		},
		inertia.WithRoot(resources.Root),
		inertia.WithEnvironment("test"),
		inertia.WithProtocolDebug(config.DefaultInertiaProtocolDebug),
	)
	if err != nil {
		t.Fatalf("create renderer: %v", err)
	}

	return renderer
}
