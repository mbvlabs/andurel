package handlers

import (
	"context"

	"app/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/inertia"
)

type PagesHandler struct {
	renderer *inertia.Renderer
}

func NewPagesHandler(renderer *inertia.Renderer) PagesHandler {
	return PagesHandler{renderer: renderer}
}

// Register mounts the home page with the middleware supplied by the runtime
// (for example middleware.AuthOnly) so the page is public only when none is
// passed.
func (p PagesHandler) Register(rt *anduin.Router, middleware ...anduin.Middleware) {
	rt.Get(routes.HomePage.Path(), p.Home, middleware...)
}

func (p PagesHandler) Home(ctx context.Context) error {
	return p.renderer.Page(ctx, "Welcome", inertia.Props{
		"appName": "app",
		"docsURL": "https://andurel.com",
	}).Render()
}
