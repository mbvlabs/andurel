package services

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"time"
	"uuid"

	"app/domains"
	appemail "app/email"
	"app/queue/jobs"
	"app/routes"

	"github.com/mbvlabs/andurel/pkg/email"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/validation"
)

var (
	ErrInvalidResetCode = errors.New("invalid reset code")
	ErrExpiredResetCode = errors.New("reset code has expired")
)

type RequestResetPasswordData struct {
	Email string
}

// RequestResetPassword queues the reset email by user id; the worker mints the
// token. Unknown email addresses succeed silently to avoid disclosing
// registered accounts.
func (i Identity) RequestResetPassword(
	ctx context.Context,
	data RequestResetPasswordData,
) error {
	b := validation.NewBuilder()
	b.Required("email", data.Email)
	if err := b.Err(); err != nil {
		return err
	}

	user, err := i.users.FindByEmail(ctx, data.Email)
	if err != nil {
		if errors.Is(err, domains.ErrNotFound) {
			return nil
		}

		return fmt.Errorf("find password reset user: %w", err)
	}

	if _, err := i.queue.Insert(ctx, jobs.SendPasswordResetEmailArgs{UserID: user.ID}, nil); err != nil {
		return fmt.Errorf("queue password reset email: %w", err)
	}

	return nil
}

// PasswordResetEmail mints a fresh reset token and renders the email that
// carries it. It runs in the queue worker, not at enqueue time, so the
// plaintext token is never persisted in river_job.args. Every call replaces
// outstanding reset tokens, so a retried job invalidates earlier emails.
func (i Identity) PasswordResetEmail(
	ctx context.Context,
	userID uuid.UUID,
) (email.TransactionalData, error) {
	user, err := i.users.Find(ctx, userID)
	if err != nil {
		if errors.Is(err, domains.ErrNotFound) {
			return email.TransactionalData{}, ErrNoEmailToSend
		}

		return email.TransactionalData{}, fmt.Errorf("find password reset user: %w", err)
	}

	meta, err := json.Marshal(map[string]string{
		"email": user.Email,
	})
	if err != nil {
		return email.TransactionalData{}, fmt.Errorf("marshal password reset token metadata: %w", err)
	}

	var token string
	err = storage.AtomicOps(ctx, i.transactor, func(ctx context.Context, tx storage.Tx) error {
		tokens := i.tokens.InTx(tx)

		if err := tokens.DestroyByUserAndScope(ctx, user.ID, domains.UserResetPassword); err != nil {
			return fmt.Errorf("destroy password reset tokens: %w", err)
		}

		created, err := tokens.Create(
			ctx,
			i.tokenSigningKey,
			domains.UserResetPassword,
			time.Now().Add(1*time.Hour),
			meta,
			user.ID,
		)
		if err != nil {
			return fmt.Errorf("create password reset token: %w", err)
		}

		token = created

		return nil
	})
	if err != nil {
		return email.TransactionalData{}, err
	}

	rpEmail := appemail.ResetPassword{ResetURL: routes.PasswordEdit.FullURL(token)}

	html, err := rpEmail.ToHTML()
	if err != nil {
		return email.TransactionalData{}, fmt.Errorf("render password reset email html: %w", err)
	}

	text, err := rpEmail.ToText()
	if err != nil {
		return email.TransactionalData{}, fmt.Errorf("render password reset email text: %w", err)
	}

	return email.TransactionalData{
		To:       user.Email,
		From:     i.defaultSenderSignature,
		Subject:  "Reset Your Password",
		HTMLBody: html,
		TextBody: text,
	}, nil
}

type ResetPasswordData struct {
	Token           string
	Password        string
	ConfirmPassword string
}

// ResetPassword consumes the token and changes the password atomically. A
// validation or write error rolls back token consumption, leaving it usable.
func (i Identity) ResetPassword(
	ctx context.Context,
	data ResetPasswordData,
) error {
	return storage.AtomicOps(ctx, i.transactor, func(ctx context.Context, tx storage.Tx) error {
		users, tokens := i.users.InTx(tx), i.tokens.InTx(tx)

		token, err := tokens.FindByScopeAndHash(
			ctx,
			i.tokenSigningKey,
			domains.UserResetPassword,
			data.Token,
		)
		if err != nil {
			if errors.Is(err, domains.ErrNotFound) {
				return ErrInvalidResetCode
			}

			return fmt.Errorf("find password reset token: %w", err)
		}

		if !token.IsValid(data.Token, i.tokenSigningKey) {
			return ErrExpiredResetCode
		}

		var meta map[string]string
		if err := json.Unmarshal(token.MetaData, &meta); err != nil {
			return fmt.Errorf("unmarshal password reset token metadata: %v", err)
		}

		emailAddr, ok := meta["email"]
		if !ok {
			return errors.New("password reset token metadata missing email")
		}

		user, err := users.FindByEmail(ctx, emailAddr)
		if err != nil {
			if errors.Is(err, domains.ErrNotFound) {
				return ErrInvalidResetCode
			}

			return fmt.Errorf("find password reset user: %w", err)
		}

		_, err = users.ChangePassword(ctx, i.pepper, user.ID, domains.PasswordPair{
			Password:        data.Password,
			ConfirmPassword: data.ConfirmPassword,
		})
		if err != nil {
			if errors.Is(err, domains.ErrNotFound) {
				return ErrInvalidResetCode
			}

			return fmt.Errorf("update password reset user: %w", err)
		}

		if err := tokens.Destroy(ctx, token.ID); err != nil {
			return fmt.Errorf("destroy password reset token: %w", err)
		}

		return nil
	})
}
