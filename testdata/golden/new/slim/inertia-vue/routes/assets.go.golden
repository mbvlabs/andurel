package routes

import (
	"github.com/mbvlabs/andurel/pkg/routing"
)

const AssetsPrefix = "/assets"

var Robots = routing.NewSimpleRoute(
	"/robots.txt",
	"assets.robots",
	"",
)

var Sitemap = routing.NewSimpleRoute(
	"/sitemap.xml",
	"assets.sitemap",
	"",
)

// ViteBuild owns /assets/dist/* exclusively for Vite build output.
// Declare separate named routes for other Go-served assets. Vite fingerprints
// file names, so this route needs no timestamp or cache-busting segment.
var ViteBuild = routing.NewSimpleRoute(
	"/dist/*",
	"vite.build",
	AssetsPrefix,
)
