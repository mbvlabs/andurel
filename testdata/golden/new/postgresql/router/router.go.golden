// Package router provides the application routes and middleware setup.
package router

import (
	"errors"
	"fmt"
	"net/http"
	"sort"
	"strings"

	"app/config"
	"app/router/middleware"
	"app/router/routes"

	"github.com/labstack/echo/v5"
	echomw "github.com/labstack/echo/v5/middleware"
	"github.com/mbvlabs/andurel/pkg/kiks"
	"github.com/mbvlabs/andurel/pkg/routing"
	"github.com/mbvlabs/andurel/pkg/telemetry"
	"go.uber.org/fx"
)

// Router is the process-wide HTTP entrypoint. Named hosts each get a child
// Echo; unknown Request.Host values are served by the primary Echo.
type Router struct {
	hosts   map[routing.HostName]*echo.Echo
	primary *echo.Echo
	Handler http.Handler
}

// HostRouter registers routes and extra middleware on one named host.
type HostRouter struct {
	name routing.HostName
	e    *echo.Echo
	err  error
}

func New(
	appCfg config.App,
	httpCfg config.HTTP,
	sessionCfg config.Session,
	jar *kiks.Jar,
	tel *telemetry.Telemetry,
) (*Router, error) {
	if err := routing.ConfigureHosts(appCfg.Hosts); err != nil {
		return nil, err
	}

	globalMiddleware, err := SetupGlobalMiddleware(
		appCfg,
		httpCfg,
		sessionCfg,
		jar,
		tel,
		"_csrf",
	)
	if err != nil {
		return nil, err
	}

	httpErrorHandler := newHTTPErrorHandler()
	children := make(map[routing.HostName]*echo.Echo)
	vhosts := make(map[string]*echo.Echo)

	for name, spec := range appCfg.Hosts {
		if name == routing.HostPrimary {
			continue
		}
		child := echo.New()
		child.HTTPErrorHandler = httpErrorHandler
		child.Use(globalMiddleware...)
		children[name] = child
		registerHostnames(vhosts, spec, child)
	}

	primary := echo.NewVirtualHostHandler(vhosts)
	primary.HTTPErrorHandler = httpErrorHandler
	primary.Use(globalMiddleware...)
	children[routing.HostPrimary] = primary

	return &Router{
		hosts:   children,
		primary: primary,
		Handler: telemetry.WrapHandler("http", primary, tel),
	}, nil
}

func newHTTPErrorHandler() echo.HTTPErrorHandler {
	defaultHTTPErrorHandler := echo.DefaultHTTPErrorHandler(false)
	return func(c *echo.Context, err error) {
		if panicErr, ok := errors.AsType[*echomw.PanicStackError](err); ok {
			telemetry.Error(
				c.Request().Context(),
				"http panic recovered",
				"method", c.Request().Method,
				"path", c.Request().URL.Path,
				"error", panicErr.Unwrap(),
				"stack", string(panicErr.Stack),
			)
		} else {
			telemetry.Error(
				c.Request().Context(),
				"http handler error",
				"method", c.Request().Method,
				"path", c.Request().URL.Path,
				"error", err,
			)
		}

		defaultHTTPErrorHandler(c, err)
	}
}

func registerHostnames(
	vhosts map[string]*echo.Echo,
	spec routing.HostSpec,
	child *echo.Echo,
) {
	bindHostname(vhosts, spec.Hostname, child)
	for _, alias := range spec.Aliases {
		bindHostname(vhosts, alias, child)
	}
}

func bindHostname(vhosts map[string]*echo.Echo, hostname string, child *echo.Echo) {
	hostname = strings.TrimSpace(hostname)
	if hostname == "" {
		return
	}
	vhosts[hostname] = child
	if _, _, ok := strings.Cut(hostname, ":"); !ok {
		vhosts[hostname+":80"] = child
		vhosts[hostname+":443"] = child
	}
}

func SetupGlobalMiddleware(
	appCfg config.App,
	httpCfg config.HTTP,
	sessionCfg config.Session,
	jar *kiks.Jar,
	tel *telemetry.Telemetry,
	csrfName string,
) ([]echo.MiddlewareFunc, error) {
	trustedOrigins, err := mergeCredentialedOrigins(
		appCfg.Origins(),
		httpCfg.CSRFTrustedOrigins,
	)
	if err != nil {
		return nil, err
	}
	csrfMiddleware, err := middleware.CSRFMiddleware(
		httpCfg.CSRFStrategy,
		trustedOrigins,
		csrfName,
		appCfg.Environment,
		sessionCfg.Name,
	)
	if err != nil {
		return nil, err
	}
	corsConfig, err := newCORSConfig(appCfg.Origins(), httpCfg.CORSAllowedOrigins)
	if err != nil {
		return nil, err
	}

	// Order matters: middlewares execute in the order listed, with Recover last
	// to catch panics from all preceding middlewares.
	middlewares := []echo.MiddlewareFunc{
		middleware.Telemetry(tel),
		middleware.TraceRouteAttributes(),
		middleware.Logger(),
		jar.EchoMiddleware(kiks.SkipPrefixes(routes.AssetsPrefix, routes.APIPrefix)),
		echomw.CORSWithConfig(corsConfig),
		csrfMiddleware,
		echomw.Recover(),
	}

	return middlewares, nil
}

func newCORSConfig(
	applicationOrigins []string,
	additionalOrigins []string,
) (echomw.CORSConfig, error) {
	origins, err := mergeCredentialedOrigins(applicationOrigins, additionalOrigins)
	if err != nil {
		return echomw.CORSConfig{}, err
	}

	return echomw.CORSConfig{
		AllowOrigins:     origins,
		AllowMethods:     []string{"GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"},
		AllowHeaders:     []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
		AllowCredentials: true,
		MaxAge:           300,
	}, nil
}

func mergeCredentialedOrigins(base []string, extra []string) ([]string, error) {
	origins := make([]string, 0, len(base)+len(extra))
	seen := make(map[string]struct{}, len(base)+len(extra))
	add := func(origin string) error {
		origin = strings.TrimSpace(origin)
		if origin == "" {
			return nil
		}
		if strings.Contains(origin, "*") {
			return fmt.Errorf(
				"credentialed CORS origin %q must not contain a wildcard",
				origin,
			)
		}
		if _, ok := seen[origin]; ok {
			return nil
		}
		seen[origin] = struct{}{}
		origins = append(origins, origin)
		return nil
	}
	if len(base) == 0 {
		return nil, errors.New("application origin must not be empty")
	}
	for _, origin := range base {
		if err := add(origin); err != nil {
			return nil, err
		}
	}
	if len(origins) == 0 {
		return nil, errors.New("application origin must not be empty")
	}
	for _, origin := range extra {
		if err := add(origin); err != nil {
			return nil, err
		}
	}
	return origins, nil
}

// Host returns a registrar for the named Echo. Unknown names fail when
// AddRoute is called so missing HOST_* values surface at boot.
func (r *Router) Host(name routing.HostName) *HostRouter {
	if name == "" {
		name = routing.HostPrimary
	}
	e, ok := r.hosts[name]
	if !ok {
		return &HostRouter{
			name: name,
			err: fmt.Errorf(
				"router: host %q is not configured (set a hostname for this HostName at boot)",
				name,
			),
		}
	}
	return &HostRouter{name: name, e: e}
}

// EachHost calls fn for every configured host, primary first.
func (r *Router) EachHost(fn func(*HostRouter) error) error {
	if fn == nil {
		return nil
	}
	names := make([]routing.HostName, 0, len(r.hosts))
	for name := range r.hosts {
		if name == routing.HostPrimary {
			continue
		}
		names = append(names, name)
	}
	sort.Slice(names, func(i, j int) bool {
		return names[i] < names[j]
	})
	ordered := append([]routing.HostName{routing.HostPrimary}, names...)
	var errs []error
	for _, name := range ordered {
		if err := fn(r.Host(name)); err != nil {
			errs = append(errs, err)
		}
	}
	return errors.Join(errs...)
}

// AddRoute mounts a route on every host Echo (assets, /api).
func (r *Router) AddRoute(route echo.Route) (echo.RouteInfo, error) {
	var info echo.RouteInfo
	var errs []error
	err := r.EachHost(func(h *HostRouter) error {
		ri, addErr := h.AddRoute(route)
		if addErr != nil {
			return addErr
		}
		info = ri
		return nil
	})
	if err != nil {
		errs = append(errs, err)
	}
	return info, errors.Join(errs...)
}

func (r *Router) AddRouteNotFound(
	notFoundHandler echo.HandlerFunc,
) echo.RouteInfo {
	var info echo.RouteInfo
	_ = r.EachHost(func(h *HostRouter) error {
		info = h.AddRouteNotFound(notFoundHandler)
		return nil
	})
	return info
}

// Use adds middleware to this host Echo in addition to the shared global stack.
func (h *HostRouter) Use(mw ...echo.MiddlewareFunc) {
	if h == nil || h.e == nil {
		return
	}
	h.e.Use(mw...)
}

func (h *HostRouter) AddRoute(route echo.Route) (echo.RouteInfo, error) {
	if h == nil {
		return echo.RouteInfo{}, errors.New("router: host registrar is nil")
	}
	if h.err != nil {
		return echo.RouteInfo{}, h.err
	}
	return h.e.AddRoute(route)
}

func (h *HostRouter) AddRouteNotFound(
	notFoundHandler echo.HandlerFunc,
) echo.RouteInfo {
	if h == nil || h.e == nil {
		return echo.RouteInfo{}
	}
	return h.e.RouteNotFound("/*", notFoundHandler)
}

func (h *HostRouter) Name() routing.HostName {
	if h == nil {
		return routing.HostPrimary
	}
	return h.name
}

var Module = fx.Module(
	"router",
	fx.Provide(New),
)
