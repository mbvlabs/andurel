package runtime

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"slices"
	"strings"
	"time"

	"app/assets"
	"app/config"
	"app/domains"
	"app/handlers"
	"app/middleware"
	"app/resources"
	"app/routes"
	"app/services"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/email"
	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/kiks"
	"github.com/mbvlabs/andurel/pkg/routing"
	"github.com/mbvlabs/andurel/pkg/storage"
	"github.com/mbvlabs/andurel/pkg/telemetry"
)

type App struct {
	Config  config.Config
	DB      storage.Connection
	Handler http.Handler
	Server  anduin.Server

	closers []func(context.Context) error
}

// New builds the web process. Each dependency registers its cleanup as soon as
// it exists, so a failure part way through releases everything built so far.
func New(ctx context.Context, cfg config.Config) (_ *App, err error) {
	if err := routing.ConfigureHosts(cfg.App.Hosts); err != nil {
		return nil, fmt.Errorf("runtime: configure hosts: %w", err)
	}

	app := &App{Config: cfg}
	defer func() {
		if err != nil {
			err = errors.Join(err, app.Close(context.WithoutCancel(ctx)))
		}
	}()

	tel, err := newTelemetry(ctx, cfg.App, cfg.Telemetry)
	if err != nil {
		return nil, err
	}
	app.closers = append(app.closers, tel.Shutdown)

	db, err := newDatabase(ctx, cfg.Database, tel)
	if err != nil {
		return nil, err
	}
	app.DB = db
	app.closers = append(app.closers, func(context.Context) error { return db.Close() })

	cacheStore, err := cfg.Cache.Store()
	if err != nil {
		return nil, err
	}
	app.closers = append(app.closers, func(context.Context) error { return cacheStore.Close() })

	queueInsert, err := storage.NewQueueInsert(db, cfg.QueueInsert.Config)
	if err != nil {
		return nil, err
	}

	transactor := storage.NewTransactor(db)
	users := domains.NewUsers(db)
	tokens := domains.NewTokens(db)

	identity := services.NewIdentity(transactor, users, tokens, queueInsert, cfg.Auth, cfg.Mail)

	renderer, err := newRenderer(cfg)
	if err != nil {
		return nil, err
	}

	jar, err := newJar(cfg.App, cfg.Session)
	if err != nil {
		return nil, err
	}

	assetsHandler, err := handlers.NewAssetsHandler(cfg.App)
	if err != nil {
		return nil, err
	}

	router := anduin.NewRouter(
		anduin.WithErrorHandler(handlers.MapError(renderer)),
		anduin.WithTelemetry(tel),
	)
	router.Use(
		anduin.Recover(),
		anduin.RealIP(cfg.HTTP.TrustedProxies...),
		anduin.Telemetry(tel),
		jar.Middleware(),
		renderer.Middleware(),
		anduin.CORS(corsConfig(cfg)),
		anduin.CSRF(csrfConfig(cfg)),
	)

	handlers.NewPagesHandler(renderer).Register(router)
	assetsHandler.Register(router)
	handlers.NewAuthHandler(identity, renderer, cacheStore).Register(router)
	handlers.NewAPIHandler(db).Register(router)

	app.Handler = router.Handler()
	app.Server = anduin.NewServer(
		ctx,
		cfg.HTTP.Host,
		cfg.HTTP.Port,
		app.Handler,
		anduin.WithTimeouts(
			cfg.HTTP.IdleTimeout,
			cfg.HTTP.ReadTimeout,
			cfg.HTTP.WriteTimeout,
		),
	)

	return app, nil
}

func (a *App) Start() error {
	return a.Server.Start()
}

// Shutdown stops accepting requests and waits for in-flight ones. Close
// releases the dependencies afterwards.
func (a *App) Shutdown(ctx context.Context) error {
	return a.Server.Shutdown(ctx)
}

// Close releases dependencies in reverse construction order.
func (a *App) Close(ctx context.Context) error {
	var closeErr error
	for _, closeFn := range slices.Backward(a.closers) {
		closeErr = errors.Join(closeErr, closeFn(ctx))
	}

	return closeErr
}

func newJar(
	appCfg config.App,
	sessionCfg config.Session,
) (*kiks.Jar, error) {
	keys := kiks.Keys{
		Authentication: sessionCfg.AuthenticationKey,
		Encryption:     sessionCfg.EncryptionKey,
	}
	store, err := kiks.NewCookieStore(keys)
	if err != nil {
		return nil, err
	}

	return kiks.NewJar(keys, store,
		middleware.NewSessionCookie(sessionCfg, appCfg.IsProduction()),
	)
}

func newTelemetry(
	ctx context.Context,
	appCfg config.App,
	cfg config.Telemetry,
) (*telemetry.Telemetry, error) {
	opts := []telemetry.Option{
		telemetry.WithTraceSampleRate(cfg.TraceSampleRate),
		telemetry.WithBatchConfig(
			cfg.BatchSize,
			time.Duration(cfg.BatchTimeoutMs)*time.Millisecond,
			2048,
		),
		telemetry.WithLogLevel(cfg.LogLevel),
	}
	if !appCfg.IsProduction() {
		opts = append(opts, telemetry.WithConsole())
	}
	headers := telemetry.ParseHeaders(cfg.OtlpHeaders)
	if cfg.OtlpLogsEndpoint != "" {
		opts = append(opts, telemetry.WithOTLPLogs(cfg.OtlpLogsEndpoint, headers))
	}
	if cfg.OtlpTracesEndpoint != "" {
		opts = append(opts, telemetry.WithOTLPTraces(cfg.OtlpTracesEndpoint, headers))
	}
	if cfg.OtlpMetricsEndpoint != "" {
		opts = append(opts, telemetry.WithOTLPMetrics(cfg.OtlpMetricsEndpoint, headers))
	}

	return telemetry.New(ctx, cfg.ServiceName, cfg.ServiceVersion, opts...)
}

func newDatabase(
	ctx context.Context,
	cfg storage.Config,
	tel *telemetry.Telemetry,
) (*storage.Postgres, error) {
	opts := []storage.Option{}
	if tel != nil {
		opts = append(opts, storage.WithOpenTelemetry(storage.TelemetryConfig{
			TracerProvider: tel.TracerProvider(),
			MeterProvider:  tel.MeterProvider(),
		}))
	}

	return storage.NewPostgres(ctx, cfg, opts...)
}

func newEmailSenders(
	cfg config.Mail,
) (email.TransactionalSender, email.MarketingSender, error) {
	switch cfg.Driver {
	case config.MailpitDriver:
		client, err := email.NewMailpit(email.MailpitConfig{
			Host: cfg.Host,
			Port: cfg.Port,
		})
		if err != nil {
			return nil, nil, fmt.Errorf("create Mailpit client: %w", err)
		}

		return client, client, nil
	default:
		return nil, nil, fmt.Errorf("unsupported email provider %q", cfg.Driver)
	}
}

func newRenderer(cfg config.Config) (*inertia.Renderer, error) {
	return inertia.NewRenderer(
		inertia.RendererConfig{
			ContainerID:         cfg.Inertia.ContainerID,
			BuildPathURL:        routes.ViteBuild.FullURL(),
			EntryPoint:          cfg.Inertia.EntryPoint,
			ViteDevURL:          cfg.Inertia.ViteDevURL,
			SSRURL:              cfg.Inertia.SSRURL,
			SSRTimeout:          cfg.Inertia.SSRRequestTimeout,
			SSRMaxResponseBytes: cfg.Inertia.SSRMaxResponseBytes,
		},
		inertia.WithRoot(resources.Root),
		inertia.WithAssetFS(assets.Files),
		inertia.WithProjectName(cfg.App.ProjectName),
		inertia.WithEnvironment(cfg.App.Environment),
		inertia.WithProtocolDebug(cfg.Inertia.ProtocolDebug),
		inertia.WithShared(inertia.Props{
			"appVersion": cfg.Version,
			"hosts":      cfg.App.HostOrigins(),
		}),
		inertia.WithSharedProvider(sharedAuth),
		inertia.WithSSRFailFast(cfg.Inertia.SSRFailFast),
	)
}

// sharedAuth gives every page the visitor's sign-in state, so layouts can
// switch between "Log in" and "Sign out" without each handler passing it.
func sharedAuth(ctx context.Context) (inertia.Props, error) {
	session, err := kiks.Get[*middleware.Session](ctx)
	if err != nil {
		return nil, err
	}

	return inertia.Props{
		"auth": inertia.Props{
			"isAuthenticated": session != nil && session.IsAuthenticated,
		},
	}, nil
}

func corsConfig(cfg config.Config) anduin.CORSConfig {
	return anduin.CORSConfig{
		AllowOrigins: mergedOrigins(
			cfg.App.Origins(),
			cfg.HTTP.CORSAllowedOrigins,
		),
		AllowMethods: []string{
			http.MethodGet,
			http.MethodHead,
			http.MethodPost,
			http.MethodPut,
			http.MethodPatch,
			http.MethodDelete,
			http.MethodOptions,
		},
		AllowHeaders:     []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
		AllowCredentials: true,
		MaxAge:           300,
	}
}

func csrfConfig(cfg config.Config) anduin.CSRFConfig {
	tokenLookup := "header:X-CSRF-Token"
	if cfg.HTTP.CSRFStrategy == "header_or_legacy_token" {
		tokenLookup = "header:X-CSRF-Token,form:_csrf"
	}

	return anduin.CSRFConfig{
		TokenLookup:  tokenLookup,
		CookieName:   "_csrf",
		CookiePath:   "/",
		CookieSecure: cfg.App.IsProduction(),
		//nolint:gosec // HttpOnly is safe: the token is only read server-side.
		CookieHTTPOnly: true,
		CookieSameSite: http.SameSiteStrictMode,
		TrustedOrigins: mergedOrigins(
			cfg.App.Origins(),
			cfg.HTTP.CSRFTrustedOrigins,
		),
		Skipper: middleware.CSRFSkipper(cfg.Session.Name),
	}
}

func mergedOrigins(groups ...[]string) []string {
	seen := make(map[string]struct{})
	origins := make([]string, 0)
	for _, group := range groups {
		for _, origin := range group {
			origin = strings.TrimSpace(origin)
			if origin == "" {
				continue
			}
			if _, ok := seen[origin]; ok {
				continue
			}
			seen[origin] = struct{}{}
			origins = append(origins, origin)
		}
	}

	return origins
}
