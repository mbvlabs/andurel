package emails

import (
	pkgemail "github.com/mbvlabs/andurel/pkg/email"
)

type VerifyEmail struct {
	VerificationCode string
}

var _ pkgemail.Transformer = (*VerifyEmail)(nil)

func (v VerifyEmail) ToHTML() (string, error) {
	return renderHTML("verify_email", v)
}

func (v VerifyEmail) ToText() (string, error) {
	return renderText("verify_email", v)
}
