<script lang="ts">
  import type { Snippet } from 'svelte'
  import { Link, page } from '@inertiajs/svelte'

  import { routes } from '@/routes'

  type FlashType = 'success' | 'error' | 'warning' | 'info'

  type FlashMessage = {
    id: string
    type: FlashType
    message: string
  }

  const flashClass: Record<FlashType, string> = {
    success: 'border-accent text-accent',
    error: 'border-destructive text-destructive',
    warning: 'border-primary text-primary',
    info: 'border-border text-foreground',
  }

  let { children }: { children: Snippet } = $props()

  let dismissed = $state<string[]>([])
  const isAuthenticated = $derived(Boolean(page.props.auth?.isAuthenticated))
  const flashMessages = $derived(
    Array.isArray(page.flash) ? (page.flash as FlashMessage[]) : [],
  )
  const visibleFlashes = $derived(
    flashMessages.filter((flash) => !dismissed.includes(flash.id)),
  )
</script>

<div class="relative flex min-h-screen flex-col overflow-hidden bg-background text-foreground">
  <div
    class="pointer-events-none absolute inset-0 opacity-60"
    style="background-image: radial-gradient(circle at 12% 18%, #f2ead8 0 1px, transparent 1.5px), radial-gradient(circle at 82% 22%, #aaa393 0 1px, transparent 1.5px), radial-gradient(circle at 67% 72%, #f2ead8 0 1px, transparent 1.5px), radial-gradient(circle at 24% 83%, #8f8a7d 0 1px, transparent 1.5px);"
  ></div>
  <header class="relative">
    <div class="mx-auto flex w-full max-w-[960px] items-center justify-between px-4 py-3">
      <Link class="inline-flex items-center gap-3 text-sm font-semibold text-card-foreground" href={routes.homePage()}>
        <span class="grid size-8 grid-cols-2 gap-1 border border-border bg-card p-1 shadow-sm shadow-black/40">
          <span class="border border-accent"></span>
          <span class="border border-border"></span>
          <span class="border border-border"></span>
          <span class="bg-accent"></span>
        </span>
        <span>Andurel.</span>
      </Link>
      <nav class="flex flex-wrap items-center justify-end gap-3 text-sm">
        <a class="px-2 py-1 text-muted-foreground transition hover:text-card-foreground" href="https://andurel.com">Documentation</a>
        {#if isAuthenticated}
          <Link
            class="px-2 py-1 text-muted-foreground transition hover:text-card-foreground"
            href={routes.sessionDestroy()}
            method="delete"
            as="button"
          >
            Sign out
          </Link>
        {:else}
          <Link class="px-2 py-1 text-muted-foreground transition hover:text-card-foreground" href={routes.sessionNew()}>Log in</Link>
          <Link class="px-2 py-1 text-muted-foreground transition hover:text-card-foreground" href={routes.registrationNew()}>Register</Link>
        {/if}
      </nav>
    </div>
  </header>
  <main class="relative flex flex-1 items-center justify-center px-6 py-6">
    {@render children()}
  </main>
  <footer class="relative py-3 text-center text-sm text-muted-foreground">
    &copy; {new Date().getFullYear()} andurel.
  </footer>
  {#if visibleFlashes.length > 0}
    <div class="fixed bottom-4 right-4 z-50 w-full max-w-sm space-y-2" role="status" aria-live="polite">
      {#each visibleFlashes as flash (flash.id)}
        <div class="flex items-start justify-between gap-3 border bg-card px-4 py-3 text-sm shadow-lg shadow-black/40 {flashClass[flash.type]}">
          <span>{flash.message}</span>
          <button
            type="button"
            class="text-muted-foreground transition hover:text-card-foreground"
            onclick={() => (dismissed = [...dismissed, flash.id])}
            aria-label="Dismiss"
          >
            &times;
          </button>
        </div>
      {/each}
    </div>
  {/if}
</div>
