<script lang="ts">
  import { Link, useForm } from '@inertiajs/svelte'

  import Layout from '@/Layouts/Layout.svelte'
  import { routes } from '@/routes'

  let { errors = {} }: { errors?: Record<string, string> } = $props()
  const form = useForm({ email: '', password: '' })

  function submit(event: SubmitEvent) {
    event.preventDefault()
    $form.post(routes.sessionCreate())
  }
</script>

<Layout>
  <section class="w-full max-w-md border border-border bg-card/90 shadow-sm shadow-black/40">
    <div class="p-6 pb-0">
      <h1 class="text-xl font-semibold text-card-foreground">Login to your account</h1>
      <p class="mt-1 text-sm text-muted-foreground">Enter your details below to login to your account</p>
    </div>
    <div class="p-6">
      <form class="space-y-5" onsubmit={submit}>
        <div class="space-y-1">
          <label class="text-sm font-medium text-muted-foreground" for="email">Email</label>
          <input id="email" bind:value={$form.email} type="email" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-sm text-foreground shadow-inner shadow-black/35 focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20" required />
          {#if errors.email}<p class="text-sm font-medium text-destructive">{errors.email}</p>{/if}
        </div>
        <div class="space-y-1">
          <label class="text-sm font-medium text-muted-foreground" for="password">Password</label>
          <input id="password" bind:value={$form.password} type="password" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-sm text-foreground shadow-inner shadow-black/35 focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20" required />
          {#if errors.password}<p class="text-sm font-medium text-destructive">{errors.password}</p>{/if}
        </div>
        <p class="text-right text-sm"><Link class="text-foreground hover:text-card-foreground hover:underline" href={routes.passwordNew()}>Forgot your password?</Link></p>
        <button type="submit" disabled={$form.processing} class="inline-flex w-full items-center justify-center bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm shadow-black/40 hover:bg-primary/90 disabled:opacity-60">{$form.processing ? 'Loading' : 'Login'}</button>
      </form>
      <p class="mt-6 text-center text-sm text-muted-foreground">Don't have an account? <Link class="text-foreground hover:text-card-foreground hover:underline" href={routes.registrationNew()}>Sign up</Link></p>
    </div>
  </section>
</Layout>
