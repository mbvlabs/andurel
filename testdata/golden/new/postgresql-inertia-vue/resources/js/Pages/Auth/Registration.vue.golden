<script setup lang="ts">
import { Link, useForm } from '@inertiajs/vue3'
import Layout from '@/Layouts/Layout.vue'
import { routes } from '@/routes'

defineProps<{ errors?: Record<string, string> }>()

const form = useForm({
  email: '',
  password: '',
  confirmPassword: '',
})
</script>

<template>
  <Layout>
    <section class="w-full max-w-md border border-border bg-card/90 shadow-sm shadow-black/40">
      <div class="p-6 pb-0">
        <h1 class="text-xl font-semibold text-card-foreground">Create an account</h1>
        <p class="mt-1 text-sm text-muted-foreground">Enter your details below to create your account</p>
      </div>
      <div class="p-6">
        <form class="space-y-5" @submit.prevent="form.post(routes.registrationCreate())">
          <div class="space-y-1">
            <label class="text-sm font-medium text-muted-foreground" for="email">Email</label>
            <input id="email" v-model="form.email" type="email" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-sm text-foreground shadow-inner shadow-black/35 focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20" required>
            <p v-if="errors?.email" class="text-sm font-medium text-destructive">{{ errors.email }}</p>
          </div>
          <div class="space-y-1">
            <label class="text-sm font-medium text-muted-foreground" for="password">Password</label>
            <input id="password" v-model="form.password" type="password" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-sm text-foreground shadow-inner shadow-black/35 focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20" required>
            <p v-if="errors?.password" class="text-sm font-medium text-destructive">{{ errors.password }}</p>
          </div>
          <div class="space-y-1">
            <label class="text-sm font-medium text-muted-foreground" for="confirmPassword">Confirm Password</label>
            <input id="confirmPassword" v-model="form.confirmPassword" type="password" class="flex h-9 w-full border border-border bg-background px-3 py-1 text-sm text-foreground shadow-inner shadow-black/35 focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20" required>
            <p v-if="errors?.confirmPassword" class="text-sm font-medium text-destructive">{{ errors.confirmPassword }}</p>
          </div>
          <button type="submit" :disabled="form.processing" class="inline-flex w-full items-center justify-center bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm shadow-black/40 hover:bg-primary/90 disabled:opacity-60">{{ form.processing ? 'Loading' : 'Sign Up' }}</button>
        </form>
        <p class="mt-6 text-center text-sm text-muted-foreground">Already have an account? <Link class="text-foreground hover:text-card-foreground hover:underline" :href="routes.sessionNew()">Login</Link></p>
      </div>
    </section>
  </Layout>
</template>
