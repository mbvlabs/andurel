import { fileURLToPath, URL } from 'node:url'
import { defineConfig, loadEnv, normalizePath } from 'vite'
import inertia from '@inertiajs/vite'
import vue from '@vitejs/plugin-vue'
import tailwindcss from '@tailwindcss/vite'

// The runner updates this private file only after Go is listening.
function andurelReload() {
  return {
    name: 'andurel-reload',
    apply: 'serve' as const,
    configureServer(server: import('vite').ViteDevServer) {
      const file = process.env.ANDUREL_VITE_RELOAD_FILE
      if (!file) return
      server.watcher.add(file)
      server.watcher.on('change', (path) => {
        if (normalizePath(path) === normalizePath(file)) server.ws.send({ type: 'full-reload' })
      })
    },
  }
}

export default defineConfig(({ command, mode }) => {
  const env = { ...loadEnv(mode, process.cwd(), ''), ...process.env }
  const primaryHost = env.HOST_PRIMARY || 'localhost:8080'
  const protocol = env.PROTOCOL || 'http'
  const origins = Object.entries(env)
    .filter(([key, value]) => key.startsWith('HOST_') && value)
    .map(([, value]) => `${protocol}://${value}`)
  origins.push(`${protocol}://${primaryHost}`)
  const escapedPrimary = primaryHost.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
  const subdomainOrigin = new RegExp(`^${protocol}://[a-zA-Z0-9-]+\\.${escapedPrimary}$`)

  return {
  plugins: [vue(), inertia({ ssr: { entry: 'resources/js/ssr.ts' } }), tailwindcss(), andurelReload()],
  resolve: {
    alias: {
      '@': fileURLToPath(new URL('./resources/js', import.meta.url)),
    },
  },
  base: command === 'build' ? './' : '/assets/dist/',
  // Bundle dependencies into the production SSR build so the embedded
  // assets/dist/ssr/ssr.js runs without node_modules. The dev server keeps them
  // external so Vite can serve SSR under `andurel run`.
  ssr: command === 'build' ? { noExternal: true } : undefined,
  build: {
    manifest: "vite/manifest.json",
    assetsDir: "",
    outDir: 'assets/dist',
    rollupOptions: {
      input: 'resources/js/app.ts',
    },
  },
  server: {
    port: 5173,
    strictPort: true,
    origin: command === 'serve' ? new URL(env.INERTIA_VITE_DEV_URL || 'http://localhost:5173/assets/dist').origin : undefined,
    cors: { origin: [...origins, subdomainOrigin] },
    // Embedded HTML is reloaded by the runner after the Go rebuild, not by Vite.
    watch: { ignored: ['**/resources/*.html'] },
  },
  }
})
