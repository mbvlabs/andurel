:root {
	color-scheme: dark;

	--background: oklch(0.1482 0.0055 247.80);
	--foreground: oklch(0.9040 0.0183 89.37);
	--card: oklch(0.1869 0.0062 196.63);
	--card-foreground: oklch(0.9385 0.0254 86.87);
	--popover: oklch(0.1869 0.0062 196.63);
	--popover-foreground: oklch(0.9385 0.0254 86.87);
	--primary: oklch(0.7029 0.1979 43.36);
	--primary-foreground: oklch(0.1719 0.0105 67.03);
	--secondary: oklch(0.1869 0.0062 196.63);
	--secondary-foreground: oklch(0.8586 0.0243 88.25);
	--muted: oklch(0.1869 0.0062 196.63);
	--muted-foreground: oklch(0.6340 0.0199 89.42);
	--accent: oklch(0.8913 0.1513 149.50);
	--accent-foreground: oklch(0.1482 0.0055 247.80);
	--destructive: oklch(0.704 0.191 22.216);
	--destructive-foreground: oklch(0.1719 0.0105 67.03);
	--border: oklch(0.3373 0.0156 176.99);
	--input: oklch(0.3373 0.0156 176.99);
	--ring: oklch(0.4758 0.0184 176.39);
	--chart-1: oklch(0.87 0 0);
	--chart-2: oklch(0.556 0 0);
	--chart-3: oklch(0.439 0 0);
	--chart-4: oklch(0.371 0 0);
	--chart-5: oklch(0.269 0 0);
	--radius: 0.625rem;
	--sidebar: oklch(0.1869 0.0062 196.63);
	--sidebar-foreground: oklch(0.9040 0.0183 89.37);
	--sidebar-primary: oklch(0.8913 0.1513 149.50);
	--sidebar-primary-foreground: oklch(0.1482 0.0055 247.80);
	--sidebar-accent: oklch(0.2342 0.0074 196.66);
	--sidebar-accent-foreground: oklch(0.9040 0.0183 89.37);
	--sidebar-border: oklch(0.3373 0.0156 176.99);
	--sidebar-ring: oklch(0.4758 0.0184 176.39);
	--surface: oklch(0.1869 0.0062 196.63);
	--text-muted: oklch(0.6340 0.0199 89.42);
}

.dark {
	--background: oklch(0.1482 0.0055 247.80);
	--foreground: oklch(0.9040 0.0183 89.37);
	--card: oklch(0.1869 0.0062 196.63);
	--card-foreground: oklch(0.9385 0.0254 86.87);
	--popover: oklch(0.1869 0.0062 196.63);
	--popover-foreground: oklch(0.9385 0.0254 86.87);
	--primary: oklch(0.7029 0.1979 43.36);
	--primary-foreground: oklch(0.1719 0.0105 67.03);
	--secondary: oklch(0.1869 0.0062 196.63);
	--secondary-foreground: oklch(0.8586 0.0243 88.25);
	--muted: oklch(0.1869 0.0062 196.63);
	--muted-foreground: oklch(0.6340 0.0199 89.42);
	--accent: oklch(0.8913 0.1513 149.50);
	--accent-foreground: oklch(0.1482 0.0055 247.80);
	--destructive: oklch(0.704 0.191 22.216);
	--border: oklch(0.3373 0.0156 176.99);
	--input: oklch(0.3373 0.0156 176.99);
	--ring: oklch(0.4758 0.0184 176.39);
	--chart-1: oklch(0.87 0 0);
	--chart-2: oklch(0.556 0 0);
	--chart-3: oklch(0.439 0 0);
	--chart-4: oklch(0.371 0 0);
	--chart-5: oklch(0.269 0 0);
	--sidebar: oklch(0.1869 0.0062 196.63);
	--sidebar-foreground: oklch(0.9040 0.0183 89.37);
	--sidebar-primary: oklch(0.8913 0.1513 149.50);
	--sidebar-primary-foreground: oklch(0.1482 0.0055 247.80);
	--sidebar-accent: oklch(0.2342 0.0074 196.66);
	--sidebar-accent-foreground: oklch(0.9040 0.0183 89.37);
	--sidebar-border: oklch(0.3373 0.0156 176.99);
	--sidebar-ring: oklch(0.4758 0.0184 176.39);
	--surface: oklch(0.1869 0.0062 196.63);
	--text-muted: oklch(0.6340 0.0199 89.42);
}

@theme inline {
	--color-background: var(--background);
	--color-foreground: var(--foreground);
	--color-card: var(--card);
	--color-card-foreground: var(--card-foreground);
	--color-popover: var(--popover);
	--color-popover-foreground: var(--popover-foreground);
	--color-primary: var(--primary);
	--color-primary-foreground: var(--primary-foreground);
	--color-secondary: var(--secondary);
	--color-secondary-foreground: var(--secondary-foreground);
	--color-muted: var(--muted);
	--color-muted-foreground: var(--muted-foreground);
	--color-accent: var(--accent);
	--color-accent-foreground: var(--accent-foreground);
	--color-destructive: var(--destructive);
	--color-destructive-foreground: var(--destructive-foreground);
	--color-border: var(--border);
	--color-input: var(--input);
	--color-ring: var(--ring);
	--color-surface: var(--surface);
	--color-text-muted: var(--text-muted);
	--radius-sm: calc(var(--radius) * 0.6);
	--radius-md: calc(var(--radius) * 0.8);
	--radius-lg: var(--radius);
}
