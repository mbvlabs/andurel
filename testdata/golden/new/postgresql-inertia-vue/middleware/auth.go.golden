package middleware

import (
	"context"
	"net/http"

	"app/routes"

	"github.com/mbvlabs/andurel/pkg/anduin"
	"github.com/mbvlabs/andurel/pkg/kiks"
)

func AuthOnly() anduin.Middleware {
	return func(next anduin.Handler) anduin.Handler {
		return func(ctx context.Context) error {
			session, err := kiks.Get[*Session](ctx)
			if err != nil {
				return err
			}
			if session != nil && session.IsAuthenticated {
				return next(ctx)
			}

			return anduin.Redirect(ctx, routes.SessionNew.URL(), http.StatusSeeOther)
		}
	}
}
