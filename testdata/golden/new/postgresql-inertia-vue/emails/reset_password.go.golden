package emails

import (
	pkgemail "github.com/mbvlabs/andurel/pkg/email"
)

type ResetPassword struct {
	ResetURL string
}

var _ pkgemail.Transformer = (*ResetPassword)(nil)

func (r ResetPassword) ToHTML() (string, error) {
	return renderHTML("reset_password", r)
}

func (r ResetPassword) ToText() (string, error) {
	return renderText("reset_password", r)
}
