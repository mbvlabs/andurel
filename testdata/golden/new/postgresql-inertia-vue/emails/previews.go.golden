package emails

import pkgemail "github.com/mbvlabs/andurel/pkg/email"

// Preview is one fixture-backed email rendered by cmd/emails.
type Preview struct {
	Name    string
	Subject string
	Email   pkgemail.Transformer
}

// Previews returns the fixture emails used by andurel email render.
// Add one entry per email: Name is the output file name, Subject is the
// gallery header, and Email carries typed sample data.
func Previews() []Preview {
	return []Preview{
		{
			Name:    "verify_email",
			Subject: "Verify your email",
			Email:   VerifyEmail{VerificationCode: "482917"},
		},
		{
			Name:    "reset_password",
			Subject: "Reset your password",
			Email:   ResetPassword{ResetURL: "https://example.test/reset?token=abc123"},
		},
	}
}
