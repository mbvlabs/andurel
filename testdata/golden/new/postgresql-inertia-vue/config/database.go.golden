package config

import (
	"errors"
	"fmt"

	"github.com/mbvlabs/andurel/pkg/env"
	"github.com/mbvlabs/andurel/pkg/storage"
)

const (
	DefaultDatabaseKind            = "postgres"
	DefaultDatabaseHost            = "127.0.0.1"
	DefaultDatabasePort            = "5432"
	DefaultDatabaseName            = "app"
	DefaultDatabaseUser            = "postgres"
	DefaultDatabasePassword        = "postgres"
	DefaultDatabaseSSLMode         = "disable"
	DefaultDatabaseApplicationName = "app"
)

func NewDatabase() (storage.Config, error) {
	e := env.New()
	cfg := storage.DefaultConfig()
	cfg.DatabaseKind = e.String("DB_KIND", DefaultDatabaseKind)
	cfg.Host = e.String("DB_HOST", DefaultDatabaseHost)
	cfg.Port = e.String("DB_PORT", DefaultDatabasePort)
	cfg.Name = e.String("DB_NAME", DefaultDatabaseName)
	cfg.User = e.String("DB_USER", DefaultDatabaseUser)
	cfg.Password = e.String("DB_PASSWORD", DefaultDatabasePassword)
	cfg.SSLMode = e.String("DB_SSL_MODE", DefaultDatabaseSSLMode)
	cfg.ApplicationName = e.String("DB_APPLICATION_NAME", DefaultDatabaseApplicationName)
	cfg.ConnectTimeout = e.Duration("DB_CONNECT_TIMEOUT", cfg.ConnectTimeout)
	cfg.StatementCacheCapacity = e.Int(
		"DB_STATEMENT_CACHE_CAPACITY",
		cfg.StatementCacheCapacity,
	)
	cfg.DescriptionCacheCapacity = e.Int(
		"DB_DESCRIPTION_CACHE_CAPACITY",
		cfg.DescriptionCacheCapacity,
	)
	cfg.MaxOpenConnections = e.Int("DB_MAX_OPEN_CONNECTIONS", cfg.MaxOpenConnections)
	cfg.MaxIdleConnections = e.Int("DB_MAX_IDLE_CONNECTIONS", cfg.MaxIdleConnections)
	cfg.ConnectionMaxLifetime = e.Duration(
		"DB_CONNECTION_MAX_LIFETIME",
		cfg.ConnectionMaxLifetime,
	)
	cfg.ConnectionMaxIdleTime = e.Duration(
		"DB_CONNECTION_MAX_IDLE_TIME",
		cfg.ConnectionMaxIdleTime,
	)
	cfg.OpenTelemetry = e.Bool("DB_OPEN_TELEMETRY", true)

	if err := errors.Join(e.Err(), cfg.Validate()); err != nil {
		return storage.Config{}, fmt.Errorf("config: database: %w", err)
	}

	return cfg, nil
}
