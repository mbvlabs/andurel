{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr resources/js/ssr.ts --outDir assets/dist/ssr",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr resources/js/ssr.ts --outDir assets/dist/ssr",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@inertiajs/vue3": "^3.6.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@inertiajs/vite": "^3.6.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.0"
  }
}
