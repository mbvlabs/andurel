-- name: GetWidget :one
SELECT *
FROM widgets
WHERE id = $1
LIMIT 1;

-- name: ListWidgets :many
-- @order id
SELECT *
FROM widgets;

-- name: CountWidgets :one
SELECT count(*)
FROM widgets;

-- name: CreateWidget :one
INSERT INTO widgets (
	id,
	name,
	created_at,
	updated_at
) VALUES (
	$1, $2, $3, $4
)
RETURNING *;

-- name: UpdateWidget :one
UPDATE widgets
SET
	name = $2,
	updated_at = $3
WHERE id = $1
RETURNING *;

-- name: DeleteWidget :exec
DELETE FROM widgets
WHERE id = $1;
