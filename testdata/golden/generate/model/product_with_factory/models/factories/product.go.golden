package factories

import (
	"context"
	"fmt"

	"example.com/app/models"
	"github.com/go-faker/faker/v4"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/mbvlabs/andurel/pkg/storage"
)

type ProductFactory struct {
	models.Product
}

type ProductOption func(*ProductFactory)

func BuildProduct(opts ...ProductOption) models.Product {
	f := &ProductFactory{
		Product: models.Product{
			Sku:         faker.Word(),
			Name:        faker.Name(),
			Description: pgtype.Text{},
			PriceCents:  randomInt(1, 1000, 100),
			StockCount:  randomInt(1, 1000, 100),
			Active:      randomBool(),
			Tags:        *new([]string),
			Scores:      *new([]int32),
			Metadata:    []byte{},
			Attributes:  []byte{},
			LaunchedAt:  pgtype.Timestamptz{},
		},
	}

	for _, opt := range opts {
		opt(f)
	}

	return f.Product
}

func CreateProduct(ctx context.Context, db storage.Connection, opts ...ProductOption) (models.Product, error) {
	built := BuildProduct(opts...)

	return models.NewProducts(db).Create(ctx, models.CreateProductData{
		Sku:         built.Sku,
		Name:        built.Name,
		Description: built.Description,
		PriceCents:  built.PriceCents,
		StockCount:  built.StockCount,
		Active:      built.Active,
		Tags:        built.Tags,
		Scores:      built.Scores,
		Metadata:    built.Metadata,
		Attributes:  built.Attributes,
		LaunchedAt:  built.LaunchedAt,
	})
}

func CreateProducts(ctx context.Context, db storage.Connection, count int, opts ...ProductOption) ([]models.Product, error) {
	products := make([]models.Product, 0, count)

	for i := range count {
		entity, err := CreateProduct(ctx, db, opts...)
		if err != nil {
			return nil, fmt.Errorf("failed to create product %d: %w", i+1, err)
		}
		products = append(products, entity)
	}

	return products, nil
}

func WithProductSku(value string) ProductOption {
	return func(f *ProductFactory) {
		f.Product.Sku = value
	}
}

func WithProductName(value string) ProductOption {
	return func(f *ProductFactory) {
		f.Product.Name = value
	}
}

func WithProductDescription(value pgtype.Text) ProductOption {
	return func(f *ProductFactory) {
		f.Product.Description = value
	}
}

func WithProductPriceCents(value int32) ProductOption {
	return func(f *ProductFactory) {
		f.Product.PriceCents = value
	}
}

func WithProductStockCount(value int32) ProductOption {
	return func(f *ProductFactory) {
		f.Product.StockCount = value
	}
}

func WithProductActive(value bool) ProductOption {
	return func(f *ProductFactory) {
		f.Product.Active = value
	}
}

func WithProductTags(value []string) ProductOption {
	return func(f *ProductFactory) {
		f.Product.Tags = value
	}
}

func WithProductScores(value []int32) ProductOption {
	return func(f *ProductFactory) {
		f.Product.Scores = value
	}
}

func WithProductMetadata(value []byte) ProductOption {
	return func(f *ProductFactory) {
		f.Product.Metadata = value
	}
}

func WithProductAttributes(value []byte) ProductOption {
	return func(f *ProductFactory) {
		f.Product.Attributes = value
	}
}

func WithProductLaunchedAt(value pgtype.Timestamptz) ProductOption {
	return func(f *ProductFactory) {
		f.Product.LaunchedAt = value
	}
}
