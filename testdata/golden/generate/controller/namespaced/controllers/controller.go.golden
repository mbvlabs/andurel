package controllers

import (
	"example.com/app/controllers/admin"
	"example.com/app/router"

	"go.uber.org/fx"
)

var constructors = fx.Provide(admin.NewWidgets)

var Module = fx.Module(
	"controllers",
	constructors,
	fx.Invoke(func(r *router.Router, c admin.Widgets) error {
		return c.RegisterRoutes(r)
	}),
)
