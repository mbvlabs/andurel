package controllers

import (
	"example.com/app/router"
	"github.com/mbvlabs/andurel/pkg/routing"

	"go.uber.org/fx"
)

var constructors = fx.Provide(NewDashboards)

var Module = fx.Module(
	"controllers",
	constructors,
	fx.Invoke(func(r *router.Router, c Dashboards) error {
		return c.RegisterRoutes(r.Host(routing.HostPrimary))
	}),
)
