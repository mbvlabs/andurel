<script setup lang="ts">
import { Link, useForm } from '@inertiajs/vue3'
import type { WidgetData, WidgetItemProps, UpdateWidgetFormPayload } from '@/types/payloads'
import { routes } from '@/routes'
type RouteID = string

function routeID(item: WidgetData): RouteID {
  return item.id as RouteID
}

const props = defineProps<WidgetItemProps>()

const form = useForm<UpdateWidgetFormPayload>({
  name: String(props.item.name ?? '') as string,
  quantity: Number(props.item.quantity ?? 0) as number,
  active: Boolean(props.item.active) as boolean,
})

function submit() {
  form.put(routes.widgetUpdate(routeID(props.item)))
}
</script>

<template>
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-foreground">Edit Widget</h1>
      <Link :href="routes.widgetShow(routeID(item))" class="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Cancel</Link>
    </div>

    <form @submit.prevent="submit" class="mt-8 space-y-6 overflow-hidden border border-border bg-card p-6 shadow-sm">
      <div>
        <label for="name" class="block text-sm font-medium text-card-foreground">Name</label>
        <input id="name" type="text" v-model="form.name" class="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
      </div>
      <div>
        <label for="quantity" class="block text-sm font-medium text-card-foreground">Quantity</label>
        <input id="quantity" type="number" v-model="form.quantity" class="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
      </div>
      <div>
        <label for="active" class="block text-sm font-medium text-card-foreground">Active</label>
        <input id="active" type="checkbox" v-model="form.active" class="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
      </div>
      <div class="flex justify-end gap-3">
        <Link :href="routes.widgetShow(routeID(item))" class="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Cancel</Link>
        <button type="submit" :disabled="form.processing" class="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50">{{ form.processing ? 'Updating...' : 'Update Widget' }}</button>
      </div>
    </form>
  </div>
</template>
