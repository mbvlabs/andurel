<script setup lang="ts">
import { Link, useForm } from '@inertiajs/vue3'
import type { WidgetData, WidgetItemProps, UpdateWidgetFormPayload } from '@/types/payloads'
import { routes } from '@/routes'
type RouteID = string

function routeID(item: WidgetData): RouteID {
  return item.id as RouteID
}

const props = defineProps<WidgetItemProps>()

const form = useForm<UpdateWidgetFormPayload>({
  name: String(props.item.name ?? '') as string,
  quantity: Number(props.item.quantity ?? 0) as number,
  active: Boolean(props.item.active) as boolean,
})

function submit() {
  form.put(routes.widgetUpdate(routeID(props.item)))
}
</script>

<template>
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-slate-100">Edit Widget</h1>
      <Link :href="routes.widgetShow(routeID(item))" class="rounded-md border border-cyan-400/25 bg-slate-900 px-4 py-2 text-sm font-medium text-slate-200 hover:bg-slate-950">Cancel</Link>
    </div>

    <form @submit.prevent="submit" class="mt-8 space-y-6 overflow-hidden rounded-lg border border-cyan-400/25 bg-slate-900 p-6 shadow-sm">
      <div>
        <label for="name" class="block text-sm font-medium text-slate-200">Name</label>
        <input id="name" type="text" v-model="form.name" class="mt-1 block w-full rounded-md border border-cyan-400/25 bg-slate-950 px-3 py-2 text-sm text-slate-100 shadow-sm focus:border-cyan-400 focus:ring-cyan-400/40" />
      </div>
      <div>
        <label for="quantity" class="block text-sm font-medium text-slate-200">Quantity</label>
        <input id="quantity" type="number" v-model="form.quantity" class="mt-1 block w-full rounded-md border border-cyan-400/25 bg-slate-950 px-3 py-2 text-sm text-slate-100 shadow-sm focus:border-cyan-400 focus:ring-cyan-400/40" />
      </div>
      <div>
        <label for="active" class="block text-sm font-medium text-slate-200">Active</label>
        <input id="active" type="checkbox" v-model="form.active" class="mt-1 block w-full rounded-md border border-cyan-400/25 bg-slate-950 px-3 py-2 text-sm text-slate-100 shadow-sm focus:border-cyan-400 focus:ring-cyan-400/40" />
      </div>
      <div class="flex justify-end gap-3">
        <Link :href="routes.widgetShow(routeID(item))" class="rounded-md border border-cyan-400/25 bg-slate-900 px-4 py-2 text-sm font-medium text-slate-200 hover:bg-slate-950">Cancel</Link>
        <button type="submit" :disabled="form.processing" class="rounded-md bg-cyan-400 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-cyan-300 disabled:opacity-50">{{ form.processing ? 'Updating...' : 'Update Widget' }}</button>
      </div>
    </form>
  </div>
</template>
