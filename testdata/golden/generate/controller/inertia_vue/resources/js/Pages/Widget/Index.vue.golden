              <Link :href="routes.widgetEdit(routeID(item))" class="mr-3 text-cyan-300 hover:text-white">Edit</Link>
              <Link :href="routes.widgetDestroy(routeID(item))" method="delete" as="button" class="text-red-400 hover:text-red-300">Delete</Link>
