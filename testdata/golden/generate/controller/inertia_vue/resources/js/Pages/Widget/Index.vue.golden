<script setup lang="ts">
import { Link } from '@inertiajs/vue3'
import type { WidgetData, WidgetIndexProps } from '@/types/payloads'
import { routes } from '@/routes'
type RouteID = string

function routeID(item: WidgetData): RouteID {
  return item.id as RouteID
}

defineProps<WidgetIndexProps>()
</script>

<template>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-slate-100">Widgets</h1>
      <Link :href="routes.widgetNew()" class="rounded-md bg-cyan-400 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-cyan-300">New Widget</Link>
    </div>

    <div class="mt-8 overflow-hidden rounded-lg border border-cyan-400/25 bg-slate-900 shadow-sm">
      <table class="min-w-full divide-y divide-cyan-400/20">
        <thead class="bg-slate-950">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase text-slate-400">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase text-slate-400">Quantity</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase text-slate-400">Active</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase text-slate-400">Created At</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase text-slate-400">Updated At</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase text-slate-400">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-cyan-400/20 bg-slate-900">
          <tr v-for="item in items" :key="item.id" class="hover:bg-slate-950">
            <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-100">{{ item.name }}</td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-100">{{ item.quantity }}</td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-100">{{ item.active }}</td>
