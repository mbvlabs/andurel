



package views

import (
	"fmt"
	"net/http"
	"strings"
	"time"

	"example.com/app/models"
	"github.com/mbvlabs/andurel/pkg/hypermedia"

	"example.com/app/router/routes"
)

type DocumentData struct {
	Title       string
	Tags        []string
	PageNumbers []int32
	ViewCount   int32
	IsPublished bool
	CreatedAt   time.Time
	UpdatedAt   time.Time
}

func newDocumentData(entity models.Document) DocumentData {
	return DocumentData{
		Title:       entity.Title,
		Tags:        entity.Tags,
		PageNumbers: entity.PageNumbers,
		ViewCount:   entity.ViewCount,
		IsPublished: entity.IsPublished,
		CreatedAt: func() time.Time {
			if !entity.CreatedAt.Valid {
				return time.Time{}
			}
			return entity.CreatedAt.Time
		}(),
		UpdatedAt: func() time.Time {
			if !entity.UpdatedAt.Valid {
				return time.Time{}
			}
			return entity.UpdatedAt.Time
		}(),
	}
}

type DocumentIndex struct {
	Items []models.Document
}

func (di DocumentIndex) PageFragment() string {
	return "document-index-page-fragment"
}

templ (di DocumentIndex) Page() {
	@base() {
		@templ.Fragment(di.PageFragment()) {
			<main id="document-index-container" class="flex-1 px-6 py-10">
				<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<h1 class="text-2xl font-semibold text-foreground">Documents</h1>
						<a href={ routes.DocumentNew.URL() } class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm">New Document</a>
					</div>
					if len(di.Items) == 0 {
						<p class="text-sm text-muted-foreground">No documents found.</p>
					} else {
						<div class="relative w-full overflow-auto">
							<table class="w-full caption-bottom text-sm">
								<thead class="[&_tr]:border-b [&_tr]:border-border">
									<tr class="border-b border-border transition-colors hover:bg-card">
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Title</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Tags</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Page Numbers</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">View Count</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Is Published</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Created At</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Updated At</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Actions</th>
									</tr>
								</thead>
								<tbody class="[&_tr:last-child]:border-0">
									for _, document := range di.Items {
										{{ documentData := newDocumentData(document) }}
										<tr class="border-b border-border transition-colors hover:bg-card">
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ documentData.Title }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ strings.Join(documentData.Tags, ", ") }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ fmt.Sprintf("%v", documentData.PageNumbers) }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ fmt.Sprintf("%d", documentData.ViewCount) }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ fmt.Sprintf("%t", documentData.IsPublished) }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ documentData.CreatedAt.String() }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ documentData.UpdatedAt.String() }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">
												<div class="flex flex-wrap gap-3 text-sm">
													<a class="text-ring hover:text-card-foreground" href={ routes.DocumentShow.URL(document.ID) }>View</a>
													<a class="text-ring hover:text-card-foreground" href={ routes.DocumentEdit.URL(document.ID) }>Edit</a>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</main>
		}
	}
}

type DocumentShow struct {
	Item models.Document
}

func (ds DocumentShow) PageFragment() string {
	return "document-show-page-fragment"
}

templ (ds DocumentShow) Page() {
	@base() {
		@templ.Fragment(ds.PageFragment()) {
			<main id="document-show-container" class="flex-1 px-6 py-10">
				<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<h1 class="text-2xl font-semibold text-foreground">Document Details</h1>
						<div class="flex flex-wrap items-center gap-3">
							<a href={ routes.DocumentEdit.URL(ds.Item.ID) } class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm">Edit</a>
							<a class="text-sm text-ring hover:text-card-foreground" href={ routes.DocumentIndex.URL() }>Back to List</a>
						</div>
					</div>
					<div class="border border-border bg-card shadow-sm">
						<div class="p-6 pt-0">
							<div class="grid gap-5 sm:grid-cols-2">
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Title</label>
									<p class="text-sm text-foreground">{ newDocumentData(ds.Item).Title }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Tags</label>
									<p class="text-sm text-foreground">{ strings.Join(newDocumentData(ds.Item).Tags, ", ") }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Page Numbers</label>
									<p class="text-sm text-foreground">{ fmt.Sprintf("%v", newDocumentData(ds.Item).PageNumbers) }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">View Count</label>
									<p class="text-sm text-foreground">{ fmt.Sprintf("%d", newDocumentData(ds.Item).ViewCount) }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Is Published</label>
									<p class="text-sm text-foreground">{ fmt.Sprintf("%t", newDocumentData(ds.Item).IsPublished) }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Created At</label>
									<p class="text-sm text-foreground">{ newDocumentData(ds.Item).CreatedAt.String() }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Updated At</label>
									<p class="text-sm text-foreground">{ newDocumentData(ds.Item).UpdatedAt.String() }</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</main>
		}
	}
}

type DocumentNew struct{}

func (dn DocumentNew) PageFragment() string {
	return "document-new-page-fragment"
}

templ (dn DocumentNew) Page() {
	@base() {
		@templ.Fragment(dn.PageFragment()) {
			<main id="document-new-container" class="flex-1 flex items-center justify-center px-6 py-10">
				<div class="mx-auto flex w-full max-w-md flex-col gap-6">
					<div class="border border-border bg-card shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="text-lg font-semibold leading-none text-foreground">New Document</h3>
							<p class="text-sm text-muted-foreground">Enter the details for the new document.</p>
						</div>
						<div class="p-6 pt-0">
							<form class="space-y-5" data-indicator:_submitting data-on:submit={ hypermedia.DataAction(http.MethodPost, routes.DocumentCreate.URL()) }>
								<fieldset data-attr:disabled="$_submitting">
									<div class="space-y-4">
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="title">Title</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="title"/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="tags">Tags</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="tags"/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="pageNumbers">Page Numbers</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="pageNumbers"/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="viewCount">View Count</label>
											<input type="number" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="viewCount"/>
										</div>
										<div class="flex items-center gap-2">
											<input type="checkbox" class="h-4 w-4 shrink-0 border border-border bg-background accent-primary transition focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60" data-bind="isPublished"/>
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="isPublished">Is Published</label>
										</div>
									</div>
									<div class="mt-6 space-y-3">
										<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm w-full">Create Document</button>
										<a class="inline-flex h-9 w-full items-center justify-center border border-border px-4 py-2 text-sm font-medium text-ring transition hover:bg-card hover:text-card-foreground" href={ routes.DocumentIndex.URL() }>Back to List</a>
									</div>
								</fieldset>
							</form>
						</div>
					</div>
				</div>
			</main>
		}
	}
}

type DocumentEdit struct {
	Item models.Document
}

func (de DocumentEdit) PageFragment() string {
	return "document-edit-page-fragment"
}

templ (de DocumentEdit) Page() {
	@base() {
		@templ.Fragment(de.PageFragment()) {
			<main id="document-edit-container" class="flex-1 flex items-center justify-center px-6 py-10">
				<div class="mx-auto flex w-full max-w-md flex-col gap-6">
					<div class="border border-border bg-card shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="text-lg font-semibold leading-none text-foreground">Edit Document</h3>
							<p class="text-sm text-muted-foreground">Update the details for this document.</p>
						</div>
						<div class="p-6 pt-0">
							<form class="space-y-5" data-indicator:_submitting data-on:submit={ hypermedia.DataAction(http.MethodPut, routes.DocumentUpdate.URL(de.Item.ID)) }>
								<fieldset data-attr:disabled="$_submitting">
									<div class="space-y-4">
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="title">Title</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="title" value={ newDocumentData(de.Item).Title }/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="tags">Tags</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="tags" value={ strings.Join(newDocumentData(de.Item).Tags, ", ") }/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="pageNumbers">Page Numbers</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="pageNumbers" value={ fmt.Sprintf("%v", newDocumentData(de.Item).PageNumbers) }/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="viewCount">View Count</label>
											<input type="number" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="viewCount" value={ fmt.Sprintf("%d", newDocumentData(de.Item).ViewCount) }/>
										</div>
										<div class="flex items-center gap-2">
											<input
												type="checkbox"
												class="h-4 w-4 shrink-0 border border-border bg-background accent-primary transition focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60"
												data-bind="isPublished"
												if newDocumentData(de.Item).IsPublished {
													checked
												}
											/>
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="isPublished">Is Published</label>
										</div>
									</div>
									<div class="mt-6 space-y-3">
										<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm w-full">Update Document</button>
										<a class="inline-flex h-9 w-full items-center justify-center border border-border px-4 py-2 text-sm font-medium text-ring transition hover:bg-card hover:text-card-foreground" href={ routes.DocumentIndex.URL() }>Back to List</a>
									</div>
								</fieldset>
							</form>
							<div role="separator" class="my-6 shrink-0 bg-border h-px w-full"></div>
							<button type="button" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive/40 disabled:opacity-60 disabled:cursor-not-allowed bg-destructive text-destructive-foreground shadow-sm hover:bg-destructive/90 h-9 px-4 py-2 text-sm w-full" data-on:click={ hypermedia.DataAction(http.MethodDelete, routes.DocumentDestroy.URL(de.Item.ID)) }>Destroy Document</button>
						</div>
					</div>
				</div>
			</main>
		}
	}
}
