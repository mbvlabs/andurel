<script setup lang="ts">
import { Link, useForm } from '@inertiajs/vue3'
import type { CreateProjectFormPayload } from '@/types/payloads'
import { routes } from '@/routes'

const form = useForm<CreateProjectFormPayload>({
  title: '' as string,
  status: '' as string,
})

function submit() {
  form.post(routes.projectCreate())
}
</script>

<template>
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-foreground">New Project</h1>
      <Link :href="routes.projectIndex()" class="border border-border bg-card px-4 py-2 text-sm font-medium text-card-foreground hover:bg-background">Back</Link>
    </div>

    <form @submit.prevent="submit" class="mt-8 space-y-6 overflow-hidden border border-border bg-card p-6 shadow-sm">
      <div>
        <label for="title" class="block text-sm font-medium text-card-foreground">Title</label>
        <input id="title" type="text" v-model="form.title" class="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
      </div>
      <div>
        <label for="status" class="block text-sm font-medium text-card-foreground">Status</label>
        <input id="status" type="text" v-model="form.status" class="mt-1 block w-full border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:ring-ring/40" />
      </div>
      <div class="flex justify-end">
        <button type="submit" :disabled="form.processing" class="bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50">{{ form.processing ? 'Creating...' : 'Create Project' }}</button>
      </div>
    </form>
  </div>
</template>
