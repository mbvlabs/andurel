



package views

import (
	"fmt"
	"net/http"
	"time"

	"example.com/app/models"
	"github.com/mbvlabs/andurel/pkg/hypermedia"

	"example.com/app/router/routes"
)

type WidgetData struct {
	Name      string
	Quantity  int32
	Active    bool
	CreatedAt time.Time
	UpdatedAt time.Time
}

func newWidgetData(entity models.Widget) WidgetData {
	return WidgetData{
		Name:     entity.Name,
		Quantity: entity.Quantity,
		Active:   entity.Active,
		CreatedAt: func() time.Time {
			if !entity.CreatedAt.Valid {
				return time.Time{}
			}
			return entity.CreatedAt.Time
		}(),
		UpdatedAt: func() time.Time {
			if !entity.UpdatedAt.Valid {
				return time.Time{}
			}
			return entity.UpdatedAt.Time
		}(),
	}
}

type WidgetIndex struct {
	Items []models.Widget
}

func (wi WidgetIndex) PageFragment() string {
	return "widget-index-page-fragment"
}

templ (wi WidgetIndex) Page() {
	@base() {
		@templ.Fragment(wi.PageFragment()) {
			<main id="widget-index-container" class="flex-1 px-6 py-10">
				<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<h1 class="text-2xl font-semibold text-foreground">Widgets</h1>
						<a href={ routes.WidgetNew.URL() } class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm">New Widget</a>
					</div>
					if len(wi.Items) == 0 {
						<p class="text-sm text-muted-foreground">No widgets found.</p>
					} else {
						<div class="relative w-full overflow-auto">
							<table class="w-full caption-bottom text-sm">
								<thead class="[&_tr]:border-b [&_tr]:border-border">
									<tr class="border-b border-border transition-colors hover:bg-card">
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Name</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Quantity</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Active</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Created At</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Updated At</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Actions</th>
									</tr>
								</thead>
								<tbody class="[&_tr:last-child]:border-0">
									for _, widget := range wi.Items {
										{{ widgetData := newWidgetData(widget) }}
										<tr class="border-b border-border transition-colors hover:bg-card">
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ widgetData.Name }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ fmt.Sprintf("%d", widgetData.Quantity) }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ fmt.Sprintf("%t", widgetData.Active) }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ widgetData.CreatedAt.String() }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ widgetData.UpdatedAt.String() }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">
												<div class="flex flex-wrap gap-3 text-sm">
													<a class="text-ring hover:text-card-foreground" href={ routes.WidgetShow.URL(widget.ID) }>View</a>
													<a class="text-ring hover:text-card-foreground" href={ routes.WidgetEdit.URL(widget.ID) }>Edit</a>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</main>
		}
	}
}

type WidgetShow struct {
	Item models.Widget
}

func (ws WidgetShow) PageFragment() string {
	return "widget-show-page-fragment"
}

templ (ws WidgetShow) Page() {
	@base() {
		@templ.Fragment(ws.PageFragment()) {
			<main id="widget-show-container" class="flex-1 px-6 py-10">
				<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<h1 class="text-2xl font-semibold text-foreground">Widget Details</h1>
						<div class="flex flex-wrap items-center gap-3">
							<a href={ routes.WidgetEdit.URL(ws.Item.ID) } class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm">Edit</a>
							<a class="text-sm text-ring hover:text-card-foreground" href={ routes.WidgetIndex.URL() }>Back to List</a>
						</div>
					</div>
					<div class="border border-border bg-card shadow-sm">
						<div class="p-6 pt-0">
							<div class="grid gap-5 sm:grid-cols-2">
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Name</label>
									<p class="text-sm text-foreground">{ newWidgetData(ws.Item).Name }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Quantity</label>
									<p class="text-sm text-foreground">{ fmt.Sprintf("%d", newWidgetData(ws.Item).Quantity) }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Active</label>
									<p class="text-sm text-foreground">{ fmt.Sprintf("%t", newWidgetData(ws.Item).Active) }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Created At</label>
									<p class="text-sm text-foreground">{ newWidgetData(ws.Item).CreatedAt.String() }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Updated At</label>
									<p class="text-sm text-foreground">{ newWidgetData(ws.Item).UpdatedAt.String() }</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</main>
		}
	}
}

type WidgetNew struct{}

func (wn WidgetNew) PageFragment() string {
	return "widget-new-page-fragment"
}

templ (wn WidgetNew) Page() {
	@base() {
		@templ.Fragment(wn.PageFragment()) {
			<main id="widget-new-container" class="flex-1 flex items-center justify-center px-6 py-10">
				<div class="mx-auto flex w-full max-w-md flex-col gap-6">
					<div class="border border-border bg-card shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="text-lg font-semibold leading-none text-foreground">New Widget</h3>
							<p class="text-sm text-muted-foreground">Enter the details for the new widget.</p>
						</div>
						<div class="p-6 pt-0">
							<form class="space-y-5" data-indicator:_submitting data-on:submit={ hypermedia.DataAction(http.MethodPost, routes.WidgetCreate.URL()) }>
								<fieldset data-attr:disabled="$_submitting">
									<div class="space-y-4">
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="name">Name</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="name"/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="quantity">Quantity</label>
											<input type="number" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="quantity"/>
										</div>
										<div class="flex items-center gap-2">
											<input type="checkbox" class="h-4 w-4 shrink-0 border border-border bg-background accent-primary transition focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60" data-bind="active"/>
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="active">Active</label>
										</div>
									</div>
									<div class="mt-6 space-y-3">
										<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm w-full">Create Widget</button>
										<a class="inline-flex h-9 w-full items-center justify-center border border-border px-4 py-2 text-sm font-medium text-ring transition hover:bg-card hover:text-card-foreground" href={ routes.WidgetIndex.URL() }>Back to List</a>
									</div>
								</fieldset>
							</form>
						</div>
					</div>
				</div>
			</main>
		}
	}
}

type WidgetEdit struct {
	Item models.Widget
}

func (we WidgetEdit) PageFragment() string {
	return "widget-edit-page-fragment"
}

templ (we WidgetEdit) Page() {
	@base() {
		@templ.Fragment(we.PageFragment()) {
			<main id="widget-edit-container" class="flex-1 flex items-center justify-center px-6 py-10">
				<div class="mx-auto flex w-full max-w-md flex-col gap-6">
					<div class="border border-border bg-card shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="text-lg font-semibold leading-none text-foreground">Edit Widget</h3>
							<p class="text-sm text-muted-foreground">Update the details for this widget.</p>
						</div>
						<div class="p-6 pt-0">
							<form class="space-y-5" data-indicator:_submitting data-on:submit={ hypermedia.DataAction(http.MethodPut, routes.WidgetUpdate.URL(we.Item.ID)) }>
								<fieldset data-attr:disabled="$_submitting">
									<div class="space-y-4">
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="name">Name</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="name" value={ newWidgetData(we.Item).Name }/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="quantity">Quantity</label>
											<input type="number" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="quantity" value={ fmt.Sprintf("%d", newWidgetData(we.Item).Quantity) }/>
										</div>
										<div class="flex items-center gap-2">
											<input
												type="checkbox"
												class="h-4 w-4 shrink-0 border border-border bg-background accent-primary transition focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60"
												data-bind="active"
												if newWidgetData(we.Item).Active {
													checked
												}
											/>
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="active">Active</label>
										</div>
									</div>
									<div class="mt-6 space-y-3">
										<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm w-full">Update Widget</button>
										<a class="inline-flex h-9 w-full items-center justify-center border border-border px-4 py-2 text-sm font-medium text-ring transition hover:bg-card hover:text-card-foreground" href={ routes.WidgetIndex.URL() }>Back to List</a>
									</div>
								</fieldset>
							</form>
							<div role="separator" class="my-6 shrink-0 bg-border h-px w-full"></div>
							<button type="button" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive/40 disabled:opacity-60 disabled:cursor-not-allowed bg-destructive text-destructive-foreground shadow-sm hover:bg-destructive/90 h-9 px-4 py-2 text-sm w-full" data-on:click={ hypermedia.DataAction(http.MethodDelete, routes.WidgetDestroy.URL(we.Item.ID)) }>Destroy Widget</button>
						</div>
					</div>
				</div>
			</main>
		}
	}
}
