



package views

import (
	"net/http"
	"time"

	"example.com/app/models"
	"github.com/mbvlabs/andurel/pkg/hypermedia"

	"example.com/app/router/routes"
)

type CompanyData struct {
	Name      string
	Industry  string
	CreatedAt time.Time
	UpdatedAt time.Time
}

func newCompanyData(entity models.Company) CompanyData {
	return CompanyData{
		Name: entity.Name,
		Industry: func() string {
			if !entity.Industry.Valid {
				return ""
			}
			return entity.Industry.String
		}(),
		CreatedAt: func() time.Time {
			if !entity.CreatedAt.Valid {
				return time.Time{}
			}
			return entity.CreatedAt.Time
		}(),
		UpdatedAt: func() time.Time {
			if !entity.UpdatedAt.Valid {
				return time.Time{}
			}
			return entity.UpdatedAt.Time
		}(),
	}
}

type CompanyIndex struct {
	Items []models.Company
}

func (ci CompanyIndex) PageFragment() string {
	return "company-index-page-fragment"
}

templ (ci CompanyIndex) Page() {
	@base() {
		@templ.Fragment(ci.PageFragment()) {
			<main id="company-index-container" class="flex-1 px-6 py-10">
				<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<h1 class="text-2xl font-semibold text-foreground">Companies</h1>
						<a href={ routes.CompanyNew.URL() } class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm">New Company</a>
					</div>
					if len(ci.Items) == 0 {
						<p class="text-sm text-muted-foreground">No companies found.</p>
					} else {
						<div class="relative w-full overflow-auto">
							<table class="w-full caption-bottom text-sm">
								<thead class="[&_tr]:border-b [&_tr]:border-border">
									<tr class="border-b border-border transition-colors hover:bg-card">
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Name</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Industry</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Created At</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Updated At</th>
										<th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0">Actions</th>
									</tr>
								</thead>
								<tbody class="[&_tr:last-child]:border-0">
									for _, company := range ci.Items {
										{{ companyData := newCompanyData(company) }}
										<tr class="border-b border-border transition-colors hover:bg-card">
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ companyData.Name }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ companyData.Industry }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ companyData.CreatedAt.String() }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">{ companyData.UpdatedAt.String() }</td>
											<td class="p-4 align-middle [&:has([role=checkbox])]:pr-0">
												<div class="flex flex-wrap gap-3 text-sm">
													<a class="text-ring hover:text-card-foreground" href={ routes.CompanyShow.URL(company.ID) }>View</a>
													<a class="text-ring hover:text-card-foreground" href={ routes.CompanyEdit.URL(company.ID) }>Edit</a>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</main>
		}
	}
}

type CompanyShow struct {
	Item models.Company
}

func (cs CompanyShow) PageFragment() string {
	return "company-show-page-fragment"
}

templ (cs CompanyShow) Page() {
	@base() {
		@templ.Fragment(cs.PageFragment()) {
			<main id="company-show-container" class="flex-1 px-6 py-10">
				<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<h1 class="text-2xl font-semibold text-foreground">Company Details</h1>
						<div class="flex flex-wrap items-center gap-3">
							<a href={ routes.CompanyEdit.URL(cs.Item.ID) } class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm">Edit</a>
							<a class="text-sm text-ring hover:text-card-foreground" href={ routes.CompanyIndex.URL() }>Back to List</a>
						</div>
					</div>
					<div class="border border-border bg-card shadow-sm">
						<div class="p-6 pt-0">
							<div class="grid gap-5 sm:grid-cols-2">
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Name</label>
									<p class="text-sm text-foreground">{ newCompanyData(cs.Item).Name }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Industry</label>
									<p class="text-sm text-foreground">{ newCompanyData(cs.Item).Industry }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Created At</label>
									<p class="text-sm text-foreground">{ newCompanyData(cs.Item).CreatedAt.String() }</p>
								</div>
								<div class="space-y-1">
									<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60">Updated At</label>
									<p class="text-sm text-foreground">{ newCompanyData(cs.Item).UpdatedAt.String() }</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</main>
		}
	}
}

type CompanyNew struct{}

func (cn CompanyNew) PageFragment() string {
	return "company-new-page-fragment"
}

templ (cn CompanyNew) Page() {
	@base() {
		@templ.Fragment(cn.PageFragment()) {
			<main id="company-new-container" class="flex-1 flex items-center justify-center px-6 py-10">
				<div class="mx-auto flex w-full max-w-md flex-col gap-6">
					<div class="border border-border bg-card shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="text-lg font-semibold leading-none text-foreground">New Company</h3>
							<p class="text-sm text-muted-foreground">Enter the details for the new company.</p>
						</div>
						<div class="p-6 pt-0">
							<form class="space-y-5" data-indicator:_submitting data-on:submit={ hypermedia.DataAction(http.MethodPost, routes.CompanyCreate.URL()) }>
								<fieldset data-attr:disabled="$_submitting">
									<div class="space-y-4">
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="name">Name</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="name"/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="industry">Industry</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="industry"/>
										</div>
									</div>
									<div class="mt-6 space-y-3">
										<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm w-full">Create Company</button>
										<a class="inline-flex h-9 w-full items-center justify-center border border-border px-4 py-2 text-sm font-medium text-ring transition hover:bg-card hover:text-card-foreground" href={ routes.CompanyIndex.URL() }>Back to List</a>
									</div>
								</fieldset>
							</form>
						</div>
					</div>
				</div>
			</main>
		}
	}
}

type CompanyEdit struct {
	Item models.Company
}

func (ce CompanyEdit) PageFragment() string {
	return "company-edit-page-fragment"
}

templ (ce CompanyEdit) Page() {
	@base() {
		@templ.Fragment(ce.PageFragment()) {
			<main id="company-edit-container" class="flex-1 flex items-center justify-center px-6 py-10">
				<div class="mx-auto flex w-full max-w-md flex-col gap-6">
					<div class="border border-border bg-card shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="text-lg font-semibold leading-none text-foreground">Edit Company</h3>
							<p class="text-sm text-muted-foreground">Update the details for this company.</p>
						</div>
						<div class="p-6 pt-0">
							<form class="space-y-5" data-indicator:_submitting data-on:submit={ hypermedia.DataAction(http.MethodPut, routes.CompanyUpdate.URL(ce.Item.ID)) }>
								<fieldset data-attr:disabled="$_submitting">
									<div class="space-y-4">
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="name">Name</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="name" value={ newCompanyData(ce.Item).Name }/>
										</div>
										<div class="space-y-1">
											<label class="text-sm font-medium leading-none text-card-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-60" for="industry">Industry</label>
											<input type="text" class="flex h-9 w-full border bg-background px-3 py-1 text-sm text-foreground shadow-inner transition placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-60 border-border" data-bind="industry" value={ newCompanyData(ce.Item).Industry }/>
										</div>
									</div>
									<div class="mt-6 space-y-3">
										<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 disabled:opacity-60 disabled:cursor-not-allowed bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4 py-2 text-sm w-full">Update Company</button>
										<a class="inline-flex h-9 w-full items-center justify-center border border-border px-4 py-2 text-sm font-medium text-ring transition hover:bg-card hover:text-card-foreground" href={ routes.CompanyIndex.URL() }>Back to List</a>
									</div>
								</fieldset>
							</form>
							<div role="separator" class="my-6 shrink-0 bg-border h-px w-full"></div>
							<button type="button" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive/40 disabled:opacity-60 disabled:cursor-not-allowed bg-destructive text-destructive-foreground shadow-sm hover:bg-destructive/90 h-9 px-4 py-2 text-sm w-full" data-on:click={ hypermedia.DataAction(http.MethodDelete, routes.CompanyDestroy.URL(ce.Item.ID)) }>Destroy Company</button>
						</div>
					</div>
				</div>
			</main>
		}
	}
}
